                print("[AmbushHub] > Anti-surge não disponível (problema do executor)")
                AntiSurgeToggle:SetValue(false)
                return 
            end
            
            local old
            old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                if getgenv().msdoors.antisurge and getnamecallmethod() == "FireServer"
                and self.Name == "SurgeRemote" then
                    return
                end
                return old(self, ...)
            end))
            hookConnection = old
        end
        
    elseif method == "RemoteSwap" then
        local rs = game:GetService("ReplicatedStorage")
        local remotesFolder = rs.RemotesFolder
        
        if enabled then
            originalRemote = remotesFolder:FindFirstChild("SurgeRemote")
            if originalRemote then
                originalRemote.Parent = rs
                
                fakeRemote = Instance.new("RemoteEvent")
                fakeRemote.Name = "SurgeRemote"
                fakeRemote.Parent = remotesFolder
            end
        end
    end
end

function cleanupAntiSurge()
    if fakeRemote and originalRemote then
        fakeRemote:Destroy()
        fakeRemote = nil
        originalRemote.Parent = game:GetService("ReplicatedStorage").RemotesFolder
        originalRemote = nil
    end
end
		
