local lockpickParents = { ChestBoxLocked = true, Locker_Small_Locked = true, Toolbox_Locked = true, StairwellLockpickDoor = true }
local skeletonParents = { SkullLock = true }
local lockpickNames   = { UnlockPrompt = true, ThingToEnable = true, LockPrompt = true, FusesPrompt = true }
local shearsParents   = { Chest_Vine = true, CuttableVines = true, Cellar = true }
local shearsNames     = { CutVinesPrompt = true }

local validTools = { Lockpick = true, SkeletonKey = true, Shears = true, Multitool = true }
local chestNames  = { "ChestBox", "ChestBoxLocked", "Toolbox", "Toolbox_Locked", "DrawerContainer", "Locker_Small_Locked", "Chest_Vine" }

if not shared.globals.INFINITEITEMS then
    shared.globals.INFINITEITEMS = { fakePrompts = {}, interacting = {} }
end
if not shared.connections.InfiniteItemsFakes then
    shared.connections.InfiniteItemsFakes = {}
end

local genOf = setmetatable({}, {__mode = "k"})
local doneGen = setmetatable({}, {__mode = "k"})

local function genDone(inst)
    local gen = genOf[inst]
    if gen == nil then
        gen = inst:FindFirstAncestor("MinesGenerator") or false
        genOf[inst] = gen
    end
    if not gen then return false end
    if doneGen[gen] then return true end

    local lever, goal = gen:FindFirstChild("Lever"), gen:FindFirstChild("LeverGoal")
    if lever and goal then
        local d = lever.Position - goal.Position
        if d:Dot(d) <= 0.5625 then
            doneGen[gen] = true
            return true
        end
    end
    return false
end

if not shared.__genClean then
    shared.__genClean = true
    task.spawn(function()
        while true do
            task.wait(0.5)
            local fakes = shared.globals.INFINITEITEMS.fakePrompts
            if next(fakes) then
                for fake, orig in next, fakes do
                    if genDone(orig) then
                        fake:Destroy()
                        pcall(function() orig.Enabled = true end)
                    end
                end
            end
        end
    end)
end

local function isInteractableValid(obj)
    if not obj or not obj.Parent then return false end
    
    if genDone(obj) then
        return false
    end
    
    local doorModel = obj:FindFirstAncestor("Door")
    if doorModel and doorModel:GetAttribute("Opened") then
        return false
    end

    local chestObj = table.find(chestNames, obj.Name) and obj or obj:FindFirstAncestorWhichIsA("Model")
    if chestObj and table.find(chestNames, chestObj.Name) then
        if chestObj:FindFirstChild("LootHolder") then
            return false
        end
        if chestObj:GetAttribute("Opened") or chestObj:GetAttribute("Unlocked") then
            return false
        end
    end

    if obj.Name == "SkullLock" and obj:IsA("BasePart") and obj.Transparency >= 1 then
        return false
    end

    if (obj.Name == "Lock1" or obj.Name == "Lock2") and obj:IsA("BasePart") and not obj.Anchored then
        return false
    end

    if obj.Name == "Lock" and obj:IsA("BasePart") then
        local doorPart = obj.Parent
        if doorPart and doorPart.Name == "Door" and doorPart:IsA("BasePart") and doorPart.Parent and doorPart.Parent.Name == "ElectricalDoor" then
            if not doorPart.Anchored then
                return false
            end
        end
    end

    local cuttableVines = obj.Name == "CuttableVines" and obj or obj:FindFirstAncestor("CuttableVines")
    if cuttableVines then
        local collisionVines = cuttableVines:FindFirstChild("CollisionVines")
        if collisionVines and collisionVines:IsA("BasePart") then
            if collisionVines.CollisionGroupId ~= 0 then
                return false
            end
        end
    end

    local stairwell = obj.Name == "StairwellLockpickDoor" and obj or obj:FindFirstAncestor("StairwellLockpickDoor")
    if stairwell then
        local garageDoor = stairwell:FindFirstChild("GarageDoor", true)
        if garageDoor then
            local attr = garageDoor:GetAttribute("CanCollide")
            if attr == false then
                return false
            end
            if attr == nil and garageDoor:IsA("BasePart") and not garageDoor.CanCollide then
                return false
            end
        end
    end

    return true
end

local function getMode(v)
    if not v:IsA("ProximityPrompt") or v.Name == "FakePrompt" or v:GetAttribute("HasFake") then return nil end
    if not isInteractableValid(v.Parent) then return nil end
    
    local p = v.Parent and v.Parent.Name
    local gp = v.Parent and v.Parent.Parent and v.Parent.Parent.Name
    
    if shearsParents[p] then return "Shears" end
    if skeletonParents[p] then return "SkeletonKey" end
    if lockpickParents[p] then return "Lockpick" end  
    
    if v.Parent and v.Parent:FindFirstAncestor("StairwellLockpickDoor") then return "Lockpick" end
    
    local isParentPart = v.Parent:IsA("BasePart")
    
    if shearsNames[v.Name] and (shearsParents[gp] or isParentPart) then return "Shears" end
    
    if lockpickNames[v.Name] and (lockpickParents[gp] or isParentPart or p == "Lock" or gp == "Fuses" or p == "Fuses") then return "Lockpick" end
    
    local lockerAncestor = v.Parent:FindFirstAncestor("Locker_Small_Locked")
    if lockerAncestor then return "Lockpick" end
    
    return nil
end

local function hasItem(mode, plr)
    local char = plr.Character
    local backpack = plr:FindFirstChild("Backpack")
    local checkIn = function(container)
        if not container then return false end
        if mode == "Lockpick" then 
            return container:FindFirstChild("Lockpick") or container:FindFirstChild("SkeletonKey") or container:FindFirstChild("Multitool") 
        end
        if mode == "SkeletonKey" then 
            return container:FindFirstChild("SkeletonKey") 
        end
        if mode == "Shears" then 
            return container:FindFirstChild("Shears") or container:FindFirstChild("Multitool") 
        end
        return false
    end
    return checkIn(char) or checkIn(backpack)
end

local function fireInteract(p)
    if not p or not p.Parent then return end
    pcall(function() fireproximityprompt(p) end)
end

local function isStairwellPrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    if prompt.Parent.Name == "StairwellLockpickDoor" then return true end
    return prompt.Parent:FindFirstAncestor("StairwellLockpickDoor") ~= nil
end

local function syncVisibility(fake, original, mode, plr)
    fake.Enabled, fake.ClickablePrompt = true, true
    original.Enabled, original.ClickablePrompt = false, false
end

local function dropAndPickup(tool, plr, maxWait) -- Kaio son, o que tu fez com esse Infinite itens 😭💔
    maxWait = maxWait or 4
    if not tool or not tool.Parent then return false end
    local char = plr.Character
    if not char then return false end
    local name = tool.Name
    local remotes = ReplicatedStorage:FindFirstChild("RemotesFolder")
    if not remotes then return false end
    local dropEvent = remotes:FindFirstChild("DropItem")
    if not dropEvent then return false end
    local drops = Workspace:FindFirstChild("Drops")
    if not drops then return false end
    pcall(function() dropEvent:FireServer(tool) end)
    local toPickup
    local t = tick()
    while not toPickup and tick() - t < maxWait do
        toPickup = drops:FindFirstChild(name)
        if not toPickup then task.wait(0.05) end
    end
    if not toPickup then return false end
    local prompt
    t = tick()
    while not prompt and tick() - t < maxWait do
        prompt = toPickup:FindFirstChild("ModulePrompt", true) or toPickup:FindFirstChildOfClass("ProximityPrompt")
        if not prompt then task.wait(0.05) end
    end
    if not prompt then return false end
    pcall(function()
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 999
        prompt.Enabled = true
        prompt.RequiresLineOfSight = false
    end)
    t = tick()
    while tick() - t < maxWait do
        if not char or not char.Parent then return false end
        if char:FindFirstChild(name) then return true end
        if not prompt.Parent or not toPickup.Parent then return false end
        pcall(function() fireproximityprompt(prompt) end)
        task.wait()
    end
    return char:FindFirstChild(name) ~= nil
end

local function updateAll(plr)
    for fake, original in pairs(shared.globals.INFINITEITEMS.fakePrompts) do
        if fake and fake.Parent and original and original.Parent then
            if isInteractableValid(original.Parent) then
                syncVisibility(fake, original, fake:GetAttribute("Mode"), plr)
            else
                local conns = shared.connections.InfiniteItemsFakes[fake]
                if conns then
                    for _, c in pairs(conns) do if c then c:Disconnect() end end
                    shared.connections.InfiniteItemsFakes[fake] = nil
                end
                shared.globals.INFINITEITEMS.fakePrompts[fake] = nil
                if fake then fake:Destroy() end
            end
        else 
            local conns = shared.connections.InfiniteItemsFakes[fake]
            if conns then
                for _, c in pairs(conns) do if c then c:Disconnect() end end
                shared.connections.InfiniteItemsFakes[fake] = nil
            end
            shared.globals.INFINITEITEMS.fakePrompts[fake] = nil 
        end
    end
end

shared.globals.AddInfiniteItemFake = function(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") or prompt.Name == "FakePrompt" or prompt:GetAttribute("HasFake") then return end
    if not isInteractableValid(prompt.Parent) then return end
    local mode = getMode(prompt)
    if not mode then return end
    prompt:SetAttribute("HasFake", true)
    local fake = prompt:Clone()
    fake.Name, fake.Parent = "FakePrompt", prompt.Parent
    fake:SetAttribute("FakePrompt", true)
    fake:SetAttribute("Mode", mode)
    shared.globals.INFINITEITEMS.fakePrompts[fake] = prompt
    local plr = shared.player
    if plr then syncVisibility(fake, prompt, mode, plr) end

    local conns = {}

    if isStairwellPrompt(prompt) then
        conns.originalTriggered = prompt.Triggered:Connect(function()
            if not shared.globals.INFINITEITEMS.interacting[fake] then return end
            local char = plr.Character
            if not char then return end
            local key = char:FindFirstChild("KeyGarage")
            if not key then return end
            dropAndPickup(key, plr, 4)
        end)
    end

    conns.triggered = fake.Triggered:Connect(function()
        if shared.globals.INFINITEITEMS.interacting[fake] then return end
        if not isInteractableValid(prompt.Parent) then return end
        
        local char = plr.Character
        
        if not char or not hasItem(mode, plr) then
            shared.globals.INFINITEITEMS.interacting[fake] = true
            fireInteract(prompt)
            task.wait(0.1)
            syncVisibility(fake, prompt, mode, plr)
            shared.globals.INFINITEITEMS.interacting[fake] = nil
            return
        end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool or not validTools[tool.Name] then
            if getgenv().msdoors.autoequipinifiniteitems then
                local backpack = plr:FindFirstChild("Backpack")
                if backpack then
                    for _, t in ipairs(backpack:GetChildren()) do
                        if t:IsA("Tool") and validTools[t.Name] then
                            if mode == "SkeletonKey" and t.Name ~= "SkeletonKey" then continue end
                            char.Humanoid:EquipTool(t)
                            tool = t
                            task.wait(0.1)
                            break
                        end
                    end
                end
            end
        end
        
        if not tool or not validTools[tool.Name] then
            shared.globals.INFINITEITEMS.interacting[fake] = true
            fireInteract(prompt)
            task.wait(0.1)
            syncVisibility(fake, prompt, mode, plr)
            shared.globals.INFINITEITEMS.interacting[fake] = nil
            return
        end
        if mode == "SkeletonKey" and tool.Name ~= "SkeletonKey" then
            shared.globals.INFINITEITEMS.interacting[fake] = true
            fireInteract(prompt)
            task.wait(0.1)
            syncVisibility(fake, prompt, mode, plr)
            shared.globals.INFINITEITEMS.interacting[fake] = nil
            return
        end
        
        local drop = ReplicatedStorage.RemotesFolder:FindFirstChild("DropItem")
        if not drop then
            shared.globals.INFINITEITEMS.interacting[fake] = true
            fireInteract(prompt)
            task.wait(0.1)
            syncVisibility(fake, prompt, mode, plr)
            shared.globals.INFINITEITEMS.interacting[fake] = nil
            return
        end

        shared.globals.INFINITEITEMS.interacting[fake] = true
        drop:FireServer(tool)

        local dropCon
        dropCon = Workspace.Drops.ChildAdded:Connect(function(v)
            if dropCon then dropCon:Disconnect() dropCon = nil end
            
            task.spawn(function()
                local p = nil
                local t = tick()
                
                while not p and tick() - t < 2 do
                    p = v:FindFirstChildOfClass("ProximityPrompt") or v:FindFirstChild("ModulePrompt", true)
                    if not p then task.wait(0.1) end
                end
                
                if not p then 
                    shared.globals.INFINITEITEMS.interacting[fake] = nil
                    return 
                end
                
                pcall(function()
                    p.HoldDuration = 0
                    p.MaxActivationDistance = 999
                    p.Enabled = true
                end)
                
                task.wait(0.1)
                if mode == "Lockpick" or mode == "SkeletonKey" then 
                    fireInteract(p) 
                    fireInteract(prompt)
                else 
                    fireInteract(prompt) 
                    fireInteract(p) 
                end
                
                task.wait(0.3)
                if not hasItem(mode, plr) then
                    fireInteract(p)
                end
                
                shared.globals.INFINITEITEMS.interacting[fake] = nil
            end)
        end)

        task.delay(3, function()
            if dropCon then dropCon:Disconnect() dropCon = nil end
            shared.globals.INFINITEITEMS.interacting[fake] = nil
        end)
    end)

    conns.ancestry = fake.AncestryChanged:Connect(function()
        if not fake.Parent then
            local c = shared.connections.InfiniteItemsFakes[fake]
            if c then
                for _, conn in pairs(c) do if conn then conn:Disconnect() end end
                shared.connections.InfiniteItemsFakes[fake] = nil
            end
            shared.globals.INFINITEITEMS.fakePrompts[fake] = nil
            shared.globals.INFINITEITEMS.interacting[fake] = nil
        end
    end)
    
    shared.connections.InfiniteItemsFakes[fake] = conns
end

InfiniteItemsToggle:OnChanged(function(value)
    getgenv().msdoors.newinfiniteitems.enabled = value

    if shared.connections.infiniteitemscharadded then shared.connections.infiniteitemscharadded:Disconnect() shared.connections.infiniteitemscharadded = nil end
    if shared.connections.infiniteitemscharremoved then shared.connections.infiniteitemscharremoved:Disconnect() shared.connections.infiniteitemscharremoved = nil end
    if shared.connections.infiniteitemsbackpackadded then shared.connections.infiniteitemsbackpackadded:Disconnect() shared.connections.infiniteitemsbackpackadded = nil end
    if shared.connections.infiniteitemsbackpackremoved then shared.connections.infiniteitemsbackpackremoved:Disconnect() shared.connections.infiniteitemsbackpackremoved = nil end
    if shared.connections.infiniteitemsplayerchar then shared.connections.infiniteitemsplayerchar:Disconnect() shared.connections.infiniteitemsplayerchar = nil end

    for fake in pairs(shared.globals.INFINITEITEMS.fakePrompts) do
        if fake and fake.Parent then fake:Destroy() end
        local conns = shared.connections.InfiniteItemsFakes[fake]
        if conns then
            for _, c in pairs(conns) do if c then c:Disconnect() end end
            shared.connections.InfiniteItemsFakes[fake] = nil
        end
    end
    for _, v in ipairs(Workspace.CurrentRooms:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Name ~= "FakePrompt" then
            pcall(function() v.Enabled = true v.ClickablePrompt = true v:SetAttribute("HasFake", nil) end)
        end
    end
    shared.globals.INFINITEITEMS.fakePrompts = {}

    if not value or not shared.loaded or not ReplicatedStorage:FindFirstChild("RemotesFolder") then return end

    for _, v in ipairs(Workspace.CurrentRooms:GetDescendants()) do
        shared.globals.AddInfiniteItemFake(v)
    end

    local function bindChar(char)
        shared.connections.infiniteitemscharadded = char.ChildAdded:Connect(function(c) if c:IsA("Tool") then updateAll(shared.player) end end)
        shared.connections.infiniteitemscharremoved = char.ChildRemoved:Connect(function(c) if c:IsA("Tool") then updateAll(shared.player) end end)
        updateAll(shared.player)
    end

    local backpack = shared.player:FindFirstChild("Backpack")
    if backpack then
        shared.connections.infiniteitemsbackpackadded = backpack.ChildAdded:Connect(function(c) if c:IsA("Tool") then updateAll(shared.player) end end)
        shared.connections.infiniteitemsbackpackremoved = backpack.ChildRemoved:Connect(function(c) if c:IsA("Tool") then updateAll(shared.player) end end)
    end

    if shared.player.Character then bindChar(shared.player.Character) end
    shared.connections.infiniteitemsplayerchar = shared.player.CharacterAdded:Connect(function(c) task.wait(0.2) bindChar(c) end)
end)
end

