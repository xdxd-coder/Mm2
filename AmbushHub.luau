            end
        end

        local function findVault()
            local currentRoom = shared.player:GetAttribute("CurrentRoom")
            if not currentRoom then return nil end
            local room = workspace.CurrentRooms:FindFirstChild(tostring(currentRoom))
            if not room then return nil end
            local assets = room:FindFirstChild("Assets")
            if not assets then return nil end
            return assets:FindFirstChild("CandyVault")
        end

        local function completeVaultUI(vault)
            if shared.globals.AutoVaultBusy then return false end
            shared.globals.AutoVaultBusy = true

            local playerGui = shared.player:FindFirstChild("PlayerGui")
            local mainUI = playerGui and playerGui:FindFirstChild("MainUI")

            local frameWait = tick()
            local frame = nil
            while shared.globals.AutoVaultRunning and tick() - frameWait < 5 do
                frame = findVaultFrame(mainUI)
                if frame then break end
                task.wait(0.1)
            end
            if not frame then
                shared.globals.AutoVaultBusy = false
                return false
            end

            local pressed = 0
            local filledPrev = 0
            local holdoff = tick() + 0.5
            local started = tick()
            local lastRePress = 0
            local attempts = 0

            while shared.globals.AutoVaultRunning and frame and tick() - started < 180 do
                local dt = RunService.RenderStepped:Wait()

                if vault and vault.Parent and vault:GetAttribute("Activated") then break end

                frame = findVaultFrame(mainUI)
                if not frame then break end

                local guide = frame:FindFirstChild("Guide")
                local progress = frame:FindFirstChild("Progress")
                local guideProgress = guide and guide:FindFirstChild("Progress")
                local correct = guide and guide:FindFirstChild("Correct")
                if not (guideProgress and correct and progress) then continue end

                local filled, total = 0, 0
                for _, c in ipairs(progress:GetChildren()) do
                    if c:IsA("GuiObject") and c:FindFirstChildOfClass("UIScale") then
                        total += 1
                        if c.BackgroundColor3 == FILLED_COLOR then filled += 1 end
                    end
                end

                if filled >= total and total > 0 then
                    if pressed ~= 0 then
                        fireGuiSignal(frame.Next, false)
                        fireGuiSignal(frame.Previous, false)
                        pressed = 0
                    end
                    break
                end

                if filled < filledPrev then
                    holdoff = tick() + 0.6
                    if pressed ~= 0 then
                        fireGuiSignal(frame.Next, false)
                        fireGuiSignal(frame.Previous, false)
                        pressed = 0
                    end
                    filledPrev = 0
                    attempts += 1
                    if attempts > 30 then break end
                    continue
                elseif filled ~= filledPrev then
                    holdoff = tick() + 0.5
                    if pressed ~= 0 then
                        fireGuiSignal(frame.Next, false)
                        fireGuiSignal(frame.Previous, false)
                        pressed = 0
                    end
                    filledPrev = filled
                end

                if tick() < holdoff then
                    if pressed ~= 0 then
                        fireGuiSignal(frame.Next, false)
                        fireGuiSignal(frame.Previous, false)
                        pressed = 0
                    end
                else
                    local corrScale = correct.Size.X.Scale
                    if corrScale > 0 then
                        local v21 = 2 / corrScale
                        local remaining = v21 * (1 - guideProgress.Size.X.Scale) - 14
                        local dir = (filled % 2 == 0) and 1 or -1
                        local stopAt = math.clamp(25.6 * dt, 0.15, 0.9)
                        if remaining > stopAt then
                            if pressed ~= dir then
                                if pressed ~= 0 then
                                    fireGuiSignal(frame.Next, false)
                                    fireGuiSignal(frame.Previous, false)
                                end
                                local btn = dir == 1 and frame.Next or frame.Previous
                                fireGuiSignal(btn, true)
                                pressed = dir
                                lastRePress = tick()
                            elseif tick() - lastRePress > 0.15 then
                                local btn = dir == 1 and frame.Next or frame.Previous
                                fireGuiSignal(btn, true)
                                lastRePress = tick()
                            end
                        elseif pressed ~= 0 then
                            fireGuiSignal(frame.Next, false)
                            fireGuiSignal(frame.Previous, false)
                            pressed = 0
                        end
                    end
                end
            end

            if frame and frame.Parent then
                fireGuiSignal(frame.Next, false)
                fireGuiSignal(frame.Previous, false)
            end

            if vault and vault.Parent and vault:GetAttribute("Activated") then
                shared.globals.AutoVaultBusy = false
                return true
            end
            local waitStart = tick()
            while shared.globals.AutoVaultRunning and tick() - waitStart < 3 do
                if vault and vault.Parent and vault:GetAttribute("Activated") then
                    shared.globals.AutoVaultBusy = false
                    return true
                end
                task.wait(0.1)
            end
            shared.globals.AutoVaultBusy = false
            return false
        end

        shared.connections.AutoVaultEngage = EngageMinigame.OnClientEvent:Connect(function(minigameName, vaultArg, tokenData)
            if not shared.globals.AutoVaultRunning then return end
            if minigameName ~= "CrackableVault" then return end

            local vault = nil
            if typeof(vaultArg) == "Instance" and vaultArg.Name == "CandyVault" then
                vault = vaultArg
            else
                vault = findVault()
            end

            task.wait(0.6)
            task.spawn(function()
                completeVaultUI(vault)
            end)
        end)

        shared.connections.AutoVaultLoop = task.spawn(function()
            while shared.globals.AutoVaultRunning do
                if not shared.globals.AutoVaultBusy then
                    local playerGui = shared.player:FindFirstChild("PlayerGui")
                    local mainUI = playerGui and playerGui:FindFirstChild("MainUI")
                    if findVaultFrame(mainUI) then
                        local vault = findVault()
                        if not vault or not vault:GetAttribute("Activated") then
                            completeVaultUI(vault)
                        end
                    end
                end
                task.wait(0.3)
            end
        end)
    end
})
		
local AutoAlma = GroupAuto:AddToggle('AutoAlma', {
    Text = api:getTranslate("Auto Alma", "Auto Alma"),
    Default = getgenv().msdoors.autoalma,
    Callback = function(Value)
        getgenv().msdoors.autoalma = Value

        if shared.connections.AUTOALMAISFORDUMBPERSONS then
            for _, conn in pairs(shared.connections.AUTOALMAISFORDUMBPERSONS) do
                if typeof(conn) == "RBXScriptConnection" then
                    pcall(function() conn:Disconnect() end)
                end
            end
        end
        shared.connections.AUTOALMAISFORDUMBPERSONS = {}

        if not Value then return end

        local function processAlmaModel(almaModel)
            if not almaModel or not almaModel.Parent then return end
            
            local function replaceFailRemote()
                local oldFail = almaModel:FindFirstChild("AlmaMinigameFail")
                if oldFail and oldFail:IsA("RemoteEvent") then
                    local fakeFail = Instance.new("RemoteEvent")
                    fakeFail.Name = "AlmaMinigameFail"
                    fakeFail.Parent = almaModel
                    oldFail:Destroy()
                    return true
                end
                return false
            end

            if not replaceFailRemote() then
                local conn
                conn = almaModel.ChildAdded:Connect(function(child)
                    if getgenv().msdoors.autoalma and child.Name == "AlmaMinigameFail" then
                        replaceFailRemote()
                        if conn then 
                            conn:Disconnect() 
                            shared.connections.AUTOALMAISFORDUMBPERSONS[conn] = nil
                        end
                    end
                end)
                table.insert(shared.connections.AUTOALMAISFORDUMBPERSONS, conn)
            end
        end

        local function monitorParent(parent)
            if not parent then return end
            
            for _, child in ipairs(parent:GetChildren()) do
                if child.Name == "Alma" then
                    processAlmaModel(child)
                end
            end
            
            local conn = parent.ChildAdded:Connect(function(child)
                if getgenv().msdoors.autoalma and child.Name == "Alma" then
                    processAlmaModel(child)
                end
            end)
            table.insert(shared.connections.AUTOALMAISFORDUMBPERSONS, conn)
        end

        local liveEntities = workspace:FindFirstChild("LiveEntities")
        if liveEntities then
            monitorParent(liveEntities)
        end
        
        monitorParent(workspace)
    end
})

GroupMosca:AddToggle("DeleteCreak", {
    Text = api:getTranslate("Delete Creak", "Deletar Creak"),
    Default = getgenv().msdoors.deletecreak,
    Callback = function(value)
        getgenv().msdoors.deletecreak = value

        if type(shared.globals.CreakCarts) ~= "table" then
            shared.globals.CreakCarts = {}
        end

        if shared.connections.DeleteCreakConn then
            shared.connections.DeleteCreakConn:Disconnect()
            shared.connections.DeleteCreakConn = nil
        end

        if not value then
            for _, obj in ipairs(shared.globals.CreakCarts) do
                if obj and obj.Parent then
                    for _, part in ipairs(obj:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                            local bp = part:FindFirstChild("MsdoorsCreakBP")
                            if bp then bp:Destroy() end
                        end
                    end
                end
            end
            table.clear(shared.globals.CreakCarts)
            return
        end

        if gethiddenproperty and sethiddenproperty then
            pcall(function()
                settings().Physics.AllowSleep = false
                shared.player.ReplicationFocus = workspace
                sethiddenproperty(shared.player, "MaximumSimulationRadius", math.huge)
                sethiddenproperty(shared.player, "SimulationRadius", math.huge)
            end)
        end

        shared.connections.DeleteCreakConn = RunService.Heartbeat:Connect(function()
            local liveEntities = workspace:FindFirstChild("LiveEntities")
            local creak = liveEntities and liveEntities:FindFirstChild("Creak-HALLOWEEN26")
            if not creak then return end

            local creakHRP = creak:FindFirstChild("HumanoidRootPart")
            if not creakHRP then return end

            local targetPos = creakHRP.Position

            for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
                local assets = room:FindFirstChild("Assets")
                if assets then
                    for _, cart in ipairs(assets:GetChildren()) do
                        if cart.Name == "ShoppingCart" then
                            local lastPusher = cart:GetAttribute("LastPusherId")
                            if lastPusher == shared.player.UserId then
                                local base = cart:FindFirstChild("Base")
                                if base and base:IsA("BasePart") and base.CollisionGroup == "CartLoose" then
                                    local exists = false
                                    for _, d in ipairs(shared.globals.CreakCarts) do
                                        if d == cart then
                                            exists = true
                                            break
                                        end
                                    end
                                    if not exists then
                                        table.insert(shared.globals.CreakCarts, cart)
                                    end
                                end
                            end
                        end
                    end
                end
            end

            for i = #shared.globals.CreakCarts, 1, -1 do
                local cart = shared.globals.CreakCarts[i]

                if not cart or not cart.Parent then
                    table.remove(shared.globals.CreakCarts, i)
                else
                    local isValid = false
                    if cart.Name == "ShoppingCart" then
                        local lastPusher = cart:GetAttribute("LastPusherId")
                        if lastPusher == shared.player.UserId then
                            local base = cart:FindFirstChild("Base")
                            if base and base:IsA("BasePart") and base.CollisionGroup == "CartLoose" then
                                isValid = true
                            end
                        end
                    end

                    if not isValid then
                        for _, part in ipairs(cart:GetDescendants()) do
                            if part:IsA("BasePart") then
                                local bp = part:FindFirstChild("MsdoorsCreakBP")
                                if bp then bp:Destroy() end
                            end
                        end
                        table.remove(shared.globals.CreakCarts, i)
                    else
                        for _, part in ipairs(cart:GetDescendants()) do
                            if part:IsA("BasePart") and not part.Anchored then
                                local bp = part:FindFirstChild("MsdoorsCreakBP")
                                if not bp then
                                    for _, c in ipairs(part:GetChildren()) do
                                        if c:IsA("BodyPosition") or c:IsA("BodyGyro") or c:IsA("BodyAngularVelocity") then
                                            c:Destroy()
                                        end
                                    end
                                    bp = Instance.new("BodyPosition")
                                    bp.Name = "MsdoorsCreakBP"
                                    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                    bp.Position = part.Position
                                    bp.Parent = part
                                end
                                
                                pcall(function()
                                    part.CanCollide = false
                                    bp.Position = targetPos + Vector3.new(
                                        math.random(-2, 2),
                                        math.random(-2, 2),
                                        math.random(-2, 2)
                                    )
                                    part.AssemblyLinearVelocity = Vector3.new(
                                        math.random(-5000, 5000),
                                        math.random(-5000, 5000),
                                        math.random(-5000, 5000)
                                    )
                                    part.AssemblyAngularVelocity = Vector3.new(
                                        math.random(-90000, 90000),
                                        math.random(-90000, 90000),
                                        math.random(-90000, 90000)
                                    )
                                end)
                            end
                        end
                    end
                end
            end
        end)
    end
})

GroupMosca:AddToggle("DestroyNoiseTV", {
    Text = api:getTranslate("Destroy Noise(TV)", "Destroy Noise(TV)"),
    Default = getgenv().msdoors.bypassnoise,
    Callback = function(value)
        getgenv().msdoors.bypassnoise = value

        if shared.connections.BREAKNOISETV then
            for _, conn in pairs(shared.connections.BREAKNOISETV) do
                if typeof(conn) == "RBXScriptConnection" then
                    pcall(function() conn:Disconnect() end)
                end
            end
        end
        shared.connections.BREAKNOISETV = {}
        shared.globals.TOBREAKTVS = {}

        if not value then return end

        if gethiddenproperty and sethiddenproperty then
            pcall(function()
                settings().Physics.AllowSleep = false
                shared.player.ReplicationFocus = workspace
                sethiddenproperty(shared.player, "MaximumSimulationRadius", math.huge)
                sethiddenproperty(shared.player, "SimulationRadius", math.huge)
            end)
        end

        local function flingTV(tvStand)
            for _, part in ipairs(tvStand:GetDescendants()) do
                if part:IsA("BasePart") and not part.Anchored then
                    pcall(function()
                        part.CanCollide = false
                        part.AssemblyLinearVelocity = Vector3.new(
                            math.random(-5000, 5000),
                            -50000,
                            math.random(-5000, 5000)
                        )
                        part.AssemblyAngularVelocity = Vector3.new(
                            math.random(-90000, 90000),
                            math.random(-90000, 90000),
                            math.random(-90000, 90000)
                        )
                    end)
                end
            end
            tvStand:PivotTo(CFrame.new(tvStand:GetPivot().Position.X, -120, tvStand:GetPivot().Position.Z))
        end

        local function setupTV(tvStand)
            table.insert(shared.globals.TOBREAKTVS, tvStand)

            local attrConn
            attrConn = tvStand:GetAttributeChangedSignal("LastPusherId"):Connect(function()
                if not getgenv().msdoors.bypassnoise then return end

                if tvStand:GetAttribute("LastPusherId") == shared.player.UserId then
                    local currentCFrame = tvStand:GetPivot()
                    if currentCFrame.Position.Y > -119 then
                        flingTV(tvStand)

                        Notify({
                            Title = api:getTranslate("Destroy Noise", "Destroy Noise"),
                            Description = api:getTranslate("TV destroyed", "TV Destruída"),
                            Image = "rbxassetid://6023426923",
                            Color = Color3.fromRGB(255, 200, 0),
                            Style = "EVENT",
                            Duration = 4,
                            NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                        })
                    end

                    for i = #shared.globals.TOBREAKTVS, 1, -1 do
                        if shared.globals.TOBREAKTVS[i] == tvStand then
                            table.remove(shared.globals.TOBREAKTVS, i)
                            break
                        end
                    end
                    attrConn:Disconnect()
                end
            end)
            table.insert(shared.connections.BREAKNOISETV, attrConn)
        end

        for _, tvStand in ipairs(workspace.CurrentRooms:GetDescendants()) do
            if tvStand.Name == "TV_Stand" then
                setupTV(tvStand)
            end
        end

        local addedConn
        addedConn = workspace.CurrentRooms.DescendantAdded:Connect(function(descendant)
            if not getgenv().msdoors.bypassnoise then return end
            if descendant.Name == "TV_Stand" then
                task.wait(0.1)
                setupTV(descendant)
            end
        end)
        table.insert(shared.connections.BREAKNOISETV, addedConn)
    end
})

