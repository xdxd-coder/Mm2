GroupTroll:AddToggle("KillWithChair", {
    Text = api:getTranslate("Kill with Office Chair", "Matar com Cadeira de Escritório"),
    Visible = (shared.info.floor == "Archives" or shared.info.floor == "Stairwell"),
    Default = getgenv().msdoors.killwithchair,
    Callback = function(value)
        getgenv().msdoors.killwithchair = value
        
        if not shared.globals.ILOVEVYNICIUSCHAIRS then
            shared.globals.ILOVEVYNICIUSCHAIRS = {}
        end

        if not shared.connections["CHAIRSBTWBTW!!"] then
            shared.connections["CHAIRSBTWBTW!!"] = {}
        end
        
        if shared.connections["CHAIRSBTWBTW!!"] then
            for k, conn in pairs(shared.connections["CHAIRSBTWBTW!!"]) do
                if typeof(conn) == "RBXScriptConnection" then
                    pcall(function() conn:Disconnect() end)
                end
                shared.connections["CHAIRSBTWBTW!!"][k] = nil
            end
        end
        
        if shared.connections.KillWithChairConn then
            shared.connections.KillWithChairConn:Disconnect()
            shared.connections.KillWithChairConn = nil
        end
        
        if shared.connections.ChairDetectConn then
            shared.connections.ChairDetectConn:Disconnect()
            shared.connections.ChairDetectConn = nil
        end
        
        if not value then
            for i = #shared.globals.ILOVEVYNICIUSCHAIRS, 1, -1 do
                local chair = shared.globals.ILOVEVYNICIUSCHAIRS[i]
                if chair and chair.Parent then
                    for _, part in ipairs(chair:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                            local bp = part:FindFirstChild("MsdoorsChairForce")
                            if bp then bp:Destroy() end
                            pcall(function()
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                            end)
                        end
                    end
                end
            end
            table.clear(shared.globals.ILOVEVYNICIUSCHAIRS)
            return
        end
        
        local function isValidChair(obj)
            if not obj or not obj.Parent then return false end
            if obj.Name ~= "ArchivesOfficeChair" and obj.Name ~= "StairwellOfficeChair" then return false end
            if obj:GetAttribute("_GateDisabled") == true then return true end
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:GetAttribute("_GateDisabled") == true then
                    return true
                end
            end
            return false
        end
        
        local function setupChair(obj)
            if not obj or not obj.Parent then return end
            if obj.Name ~= "ArchivesOfficeChair" and obj.Name ~= "StairwellOfficeChair" then return end
            
            local function checkAndAdd()
                if isValidChair(obj) then
                    if getgenv().msdoors.killwithchair and not table.find(shared.globals.ILOVEVYNICIUSCHAIRS, obj) then
                        table.insert(shared.globals.ILOVEVYNICIUSCHAIRS, obj)
                    end
                    return true
                end
                return false
            end

            if checkAndAdd() then return end

            local attrConn
            attrConn = obj.AttributeChanged:Connect(function(attr)
                if attr == "_GateDisabled" and checkAndAdd() then
                    if attrConn then
                        attrConn:Disconnect()
                        shared.connections["CHAIRSBTWBTW!!"][obj] = nil
                    end
                end
            end)
            shared.connections["CHAIRSBTWBTW!!"][obj] = attrConn
            
            for _, child in ipairs(obj:GetChildren()) do
                local childConn
                childConn = child.AttributeChanged:Connect(function(attr)
                    if attr == "_GateDisabled" and checkAndAdd() then
                        if childConn then
                            childConn:Disconnect()
                            shared.connections["CHAIRSBTWBTW!!"][child] = nil
                        end
                    end
                end)
                shared.connections["CHAIRSBTWBTW!!"][child] = childConn
            end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            setupChair(obj)
        end
        
        shared.connections.ChairDetectConn = workspace.DescendantAdded:Connect(function(descendant)
            if descendant then
                setupChair(descendant)
            end
        end)
        
        shared.connections.KillWithChairConn = RunService.Heartbeat:Connect(function()
            if not getgenv().msdoors.killwithchair then return end
            
            local targetName = getgenv().msdoors.chairkilltarget
            if not targetName or targetName == "" then return end
            
            local targetHRP = nil
            local lowerName = string.lower(targetName)
            local length = #lowerName
            
            for _, p in ipairs(Players:GetPlayers()) do
                local pName = string.lower(p.Name)
                local pDisplay = string.lower(p.DisplayName)
                if string.sub(pName, 1, length) == lowerName or string.sub(pDisplay, 1, length) == lowerName then
                    if p.Character then
                        targetHRP = p.Character:FindFirstChild("HumanoidRootPart")
                    end
                    break
                end
            end
            
            if not targetHRP then return end
            local targetPos = targetHRP.Position
            local targetCF = targetHRP.CFrame
            
            local list = shared.globals.ILOVEVYNICIUSCHAIRS
            for i = #list, 1, -1 do
                local chair = list[i]
                
                if not chair or not chair.Parent or not isValidChair(chair) then
                    if chair and chair.Parent then
                        for _, part in ipairs(chair:GetDescendants()) do
                            if part:IsA("BasePart") then
                                local bp = part:FindFirstChild("MsdoorsChairForce")
                                if bp then bp:Destroy() end
                            end
                        end
                    end
                    table.remove(list, i)
                else
                    pcall(function()
                        chair:PivotTo(targetCF * CFrame.new(math.random(-1, 1), math.random(-1, 1), math.random(-1, 1)))
                    end)

                    for _, part in ipairs(chair:GetDescendants()) do
                        if part:IsA("BasePart") and not part.Anchored then
                            local bp = part:FindFirstChild("MsdoorsChairForce")
                            if not bp then
                                for _, c in ipairs(part:GetChildren()) do
                                    if c:IsA("BodyPosition") or c:IsA("BodyGyro") or c:IsA("BodyAngularVelocity") then
                                        c:Destroy()
                                    end
                                end
                                bp = Instance.new("BodyPosition")
                                bp.Name = "MsdoorsChairForce"
                                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bp.Position = part.Position
                                bp.Parent = part
                            end
                            
                            pcall(function()
                                part.CanCollide = false
                                bp.Position = targetPos + Vector3.new(
                                    math.random(-2, 2),
                                    math.random(-2, 2),
                                    math.random(-2, 2)
                                )
                                part.AssemblyLinearVelocity = Vector3.new(
                                    math.random(-5000, 5000),
                                    math.random(-5000, 5000),
                                    math.random(-5000, 5000)
                                )
                                part.AssemblyAngularVelocity = Vector3.new(
                                    math.random(-90000, 90000),
                                    math.random(-90000, 90000),
                                    math.random(-90000, 90000)
                                )
                            end)
                        end
                    end
                end
            end
        end)
    end
})

