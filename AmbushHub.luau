local AlwaysIgnore = {
    ["Hole"] = function(prompt)
        return prompt.Name == "ModulePrompt" and prompt.Parent and prompt.Parent.Name == "Hole"
    end,
    ["LockedLocker"] = function(prompt)
        return prompt.Parent and prompt.Parent.Parent and prompt.Parent.Parent.Name == "Locker_Small_Locked"
    end,
    ["FakeKey"] = function(prompt)
        return prompt.Parent and prompt.Parent.Name == "KeyObtainFake"
    end,
    ["PaintingSlot"] = function(prompt)
        if not (prompt.Parent and prompt.Parent.Name == "Slot" and prompt.Parent:GetAttribute("Hint")) then
            return false
        end
        local slotPainting = prompt.Parent:FindFirstChild("Prop")
        if not slotPainting then return false end
        local slotHint = slotPainting:GetAttribute("Hint")
        local promptHint = prompt.Parent:GetAttribute("Hint")
        return slotHint == promptHint
    end,
    ["CandyVault"] = function(prompt)
        local current = prompt.Parent
        while current and current ~= workspace do
            if current.Name == "CandyVault" then
                return true
            end
            current = current.Parent
        end
        return false
    end
}

local ProximityTrigger = (function()
    local methods = {}
    methods[1] = function(prompt)
        if not fireproximityprompt then return false end
        local success = pcall(fireproximityprompt, prompt)
        return success
    end
    methods[2] = function(prompt)
        local success = pcall(function()
            local originalDuration = prompt.HoldDuration
            prompt.HoldDuration = 0
            prompt:InputHoldBegin()
            task.wait(0.1)
            prompt:InputHoldEnd()
            prompt.HoldDuration = originalDuration
        end)
        return success
    end
    methods[3] = function(prompt)
        if not getconnections then return false end
        local success = pcall(function()
            local connections = getconnections(prompt.PromptButtonHoldBegan)
            for _, connection in pairs(connections) do
                if connection.Function then connection.Function() end
            end
            task.wait(prompt.HoldDuration)
            local triggerConnections = getconnections(prompt.Triggered)
            for _, connection in pairs(triggerConnections) do
                if connection.Function then connection.Function(LocalPlayer) end
            end
        end)
        return success
    end
    local workingMethod = nil
    return function(prompt)
        if workingMethod and methods[workingMethod] then
            if methods[workingMethod](prompt) then return true end
            workingMethod = nil
        end
        for i, method in ipairs(methods) do
            if method(prompt) then
                workingMethod = i
                return true
            end
        end
        return false
    end
end)()

local function getBasePart(prompt)
    if prompt.Parent:IsA("BasePart") then
        return prompt.Parent
    end
    if prompt.Parent.Parent then
        if prompt.Parent.Parent:IsA("BasePart") then
            return prompt.Parent.Parent
        end
        local basePart = prompt.Parent.Parent:FindFirstChildOfClass("BasePart")
        if basePart then return basePart end
    end
    return prompt.Parent:FindFirstChildWhichIsA("BasePart")
end

local function shouldIgnoreFromList(prompt)
    if not Options.IgnoreList then return false end
    for itemName, _ in pairs(Options.IgnoreList.Value) do
        local checkFunc = IgnoreListChecks[itemName]
        if checkFunc and checkFunc(prompt) then
            return true
        end
    end
    return false
end

local function shouldAlwaysIgnore(prompt)
    for _, handler in pairs(AlwaysIgnore) do
        if handler(prompt) then
            return true
        end
    end
    return false
end

local function canInteractWithPrompt(prompt, hrp)
    if not prompt or not prompt.Parent then return false end
    if not prompt.ClickablePrompt then return false end
    local interactions = prompt:GetAttribute("Interactions")
    if interactions and interactions >= 1 then return false end
    local base = getBasePart(prompt)
    if not base then return false end
    return (hrp.Position - base.Position).Magnitude < prompt.MaxActivationDistance
end

