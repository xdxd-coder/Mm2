local function ShouldNotifyEntity(entityName)
    local selectedEntities = getgenv().msdoors.entitySelectedEntities
    
    if not selectedEntities or #selectedEntities == 0 then
        return true
    end
    
    if selectedEntities[1] == "All" or table.find(selectedEntities, "All") then
        return true
    end
    
    if table.find(selectedEntities, entityName) then
        return true
    end
    
    for _, selected in ipairs(selectedEntities) do
        if EntityTable.NotifyReason[entityName] and EntityTable.NotifyReason[entityName].Title == selected then
            return true
        end
    end
    
    return false
end

