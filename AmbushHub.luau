GroupAmbient:AddToggle("RoundedGuis", {
    Text = api:getTranslate("Rounded Guis", "Guis Arredondadas"),
    Default = getgenv().msdoors.roundedguis.enabled,
    Callback = function(value)
        getgenv().msdoors.roundedguis.enabled = value
        getgenv().msdoors.roundedguis.spoofObjs = getgenv().msdoors.roundedguis.spoofObjs or {}
        getgenv().msdoors.roundedguis.cache = getgenv().msdoors.roundedguis.cache or {}
        shared.connections.roundedguis = shared.connections.roundedguis or {}

        local targetRadius = UDim.new(0, 90)

        local ignoredPaths = {
            "DoorsAdmin.Container",
            "MainUI.MainFrame.ButtonUnhide",
            "MainUI.MainFrame.Hotbar",
            "MainUI.TwitchDropsCodes.Unaffected.SectionBackground",
            "MainUI.Settings",
            "MainUI.DeathPanel.Leave",
            "MainUI.Statistics",
        }

        local function isIgnored(obj)
            local path = ""
            local current = obj.Parent
            local playerGui = shared.player.PlayerGui
            while current and current ~= playerGui do
                path = current.Name .. (path ~= "" and "." .. path or "")
                current = current.Parent
            end
            for _, ignored in pairs(ignoredPaths) do
                if path == ignored or path:sub(1, #ignored) == ignored then
                    return true
                end
            end
            return false
        end

        local function isTarget(obj)
            return obj:IsA("UICorner")
        end

        local function needsSpoof(obj)
            local r = obj.CornerRadius
            return not (r.Scale == targetRadius.Scale and r.Offset == targetRadius.Offset)
        end

        local function applySpoof(obj)
            if not (obj and obj.Parent) then return end
            if not isTarget(obj) then return end
            if isIgnored(obj) then return end
            if not needsSpoof(obj) then return end
            if not obj:GetAttribute("_origScale") then
                local r = obj.CornerRadius
                obj:SetAttribute("_origScale", r.Scale)
                obj:SetAttribute("_origOffset", r.Offset)
                table.insert(getgenv().msdoors.roundedguis.spoofObjs, obj)
            end
            obj.CornerRadius = targetRadius
        end

        local function restoreSpoof(obj)
            if not (obj and obj.Parent) then return end
            local scale = obj:GetAttribute("_origScale")
            local offset = obj:GetAttribute("_origOffset")
            if scale ~= nil and offset ~= nil then
                obj.CornerRadius = UDim.new(scale, offset)
                obj:SetAttribute("_origScale", nil)
                obj:SetAttribute("_origOffset", nil)
            end
        end

        local function hookObj(obj)
            if not isTarget(obj) then return end
            if isIgnored(obj) then return end
            applySpoof(obj)
            local conn = obj:GetPropertyChangedSignal("CornerRadius"):Connect(function()
                if getgenv().msdoors.roundedguis.enabled and needsSpoof(obj) then
                    applySpoof(obj)
                end
            end)
            table.insert(shared.connections.roundedguis, conn)
        end

        if value then
            local root = shared.player.PlayerGui

            pcall(function()
                for _, obj in pairs(root:GetDescendants()) do
                    if isTarget(obj) and not isIgnored(obj) then
                        pcall(hookObj, obj)
                        table.insert(getgenv().msdoors.roundedguis.cache, obj)
                    end
                end
            end)

            local connDesc = root.DescendantAdded:Connect(function(obj)
                if not getgenv().msdoors.roundedguis.enabled then return end
                task.defer(function()
                    if obj and obj.Parent and isTarget(obj) and not isIgnored(obj) then
                        pcall(hookObj, obj)
                        table.insert(getgenv().msdoors.roundedguis.cache, obj)
                    end
                end)
            end)
            table.insert(shared.connections.roundedguis, connDesc)

            local connChild = root.ChildAdded:Connect(function(child)
                if not getgenv().msdoors.roundedguis.enabled then return end
                task.defer(function()
                    if not (child and child.Parent) then return end
                    pcall(function()
                        for _, obj in pairs(child:GetDescendants()) do
                            if isTarget(obj) and not isIgnored(obj) then
                                pcall(hookObj, obj)
                                table.insert(getgenv().msdoors.roundedguis.cache, obj)
                            end
                        end
                    end)
                end)
            end)
            table.insert(shared.connections.roundedguis, connChild)

        else
            for _, conn in pairs(shared.connections.roundedguis) do
                if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
            end
            shared.connections.roundedguis = {}

            local root = game:GetService("Players").LocalPlayer.PlayerGui
            for _, obj in pairs(root:GetDescendants()) do
                if isTarget(obj) then
                    restoreSpoof(obj)
                end
            end

            getgenv().msdoors.roundedguis.spoofObjs = {}
            getgenv().msdoors.roundedguis.cache = {}
        end
    end
})

