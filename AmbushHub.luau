GroupAutomation:AddButton({
    Text = api:getTranslate("Beat Door 200", "Completar Porta 200"),
    Func = function()
        if getgenv().msdoors.beatingdoor200 then return end

        local currentRoom = shared.player:GetAttribute("CurrentRoom")
        if not currentRoom or tonumber(currentRoom) < 99 then
            Notify({
                Title = api:getTranslate("Beat Door 200", "Completar Porta 200"),
                Description = api:getTranslate("You haven't reached door 200.", "Você ainda não chegou na porta 200."),
                Image = "rbxassetid://6023426923",
                Color = Color3.fromRGB(255, 50, 50),
                Style = "EVENT",
                Duration = 5,
                NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
            })
            return
        end

        local character = shared.player.Character
        if not character then return end

        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local function firePrompt(prompt)
            if fireproximityprompt then
                local ok = pcall(fireproximityprompt, prompt)
                if ok then return end
            end

            local ok = pcall(function()
                local originalDuration = prompt.HoldDuration
                prompt.HoldDuration = 0
                prompt:InputHoldBegin()
                task.wait(0.1)
                prompt:InputHoldEnd()
                prompt.HoldDuration = originalDuration
            end)
            if ok then return end

            if getconnections then
                pcall(function()
                    for _, connection in pairs(getconnections(prompt.PromptButtonHoldBegan)) do
                        if connection.Function then connection.Function() end
                    end
                    task.wait(prompt.HoldDuration)
                    for _, connection in pairs(getconnections(prompt.Triggered)) do
                        if connection.Function then connection.Function(shared.player) end
                    end
                end)
            end
        end

        local function spamPrompt(prompt, times)
            for i = 1, times or 5 do
                firePrompt(prompt)
                task.wait(0.1)
            end
        end

        getgenv().msdoors.beatingdoor200 = true
        local startPos = hrp.CFrame
        local damHandler = workspace.CurrentRooms[tostring(currentRoom)]:FindFirstChild("_DamHandler")

        if damHandler then
            if damHandler:FindFirstChild("PlayerBarriers1") then
                for _, pump in pairs(damHandler.Flood1.Pumps:GetChildren()) do
                    character:PivotTo(pump.Wheel.CFrame)
                    task.wait(0.3)
                    spamPrompt(pump.Wheel.ValvePrompt)
                end
                task.wait(8)
            end

            if damHandler:FindFirstChild("PlayerBarriers2") then
                for _, pump in pairs(damHandler.Flood2.Pumps:GetChildren()) do
                    character:PivotTo(pump.Wheel.CFrame)
                    task.wait(0.3)
                    spamPrompt(pump.Wheel.ValvePrompt)
                end
                task.wait(8)
            end

            if damHandler:FindFirstChild("PlayerBarriers3") then
                for _, pump in pairs(damHandler.Flood3.Pumps:GetChildren()) do
                    character:PivotTo(pump.Wheel.CFrame)
                    task.wait(0.3)
                    spamPrompt(pump.Wheel.ValvePrompt)
                end
                task.wait(10)
            end
        end

        local generator = workspace.CurrentRooms[tostring(currentRoom)]:FindFirstChild("MinesGenerator", true)
        if generator then
            character:PivotTo(generator.PrimaryPart.CFrame)
            task.wait(0.3)
            spamPrompt(generator.Lever.LeverPrompt)
        end

        character:PivotTo(startPos)
        getgenv().msdoors.beatingdoor200 = false
    end
})
		
