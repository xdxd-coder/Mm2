                UDim2.new(0.5, -26, 0.5, -26),
                Color3.fromRGB(255, 255, 255), 0.55,
                joyOuter
            )

            local btnUp = makeFrame(
                "BtnUp",
                UDim2.new(0, 64, 0, 64),
                UDim2.new(1, -90, 1, -160),
                Color3.fromRGB(200, 230, 255), 0.50
            )
            btnUp.ZIndex = 4
            makeLabel("↑", UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), btnUp)

            local btnDown = makeFrame(
                "BtnDown",
                UDim2.new(0, 64, 0, 64),
                UDim2.new(1, -90, 1, -86),
                Color3.fromRGB(200, 230, 255), 0.50
            )
            btnDown.ZIndex = 4
            makeLabel("↓", UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), btnDown)

            local joystick = {
                active = false,
                touchId = nil,
                center = Vector2.new(),
                radius = 60,
                deadzone = 0.15,
                axis = Vector2.new(),
            }

            local camPan = {
                active = false,
                touchId = nil,
                lastPos = Vector2.new(),
            }

            local altButtons = {
                up = false,
                down = false,
            }

            local function updateKnobVisual()
                local ax = joystick.axis
                local px = 0.5 + ax.X * 0.35
                local py = 0.5 + ax.Y * 0.35
                joyKnob.Position = UDim2.new(px, -26, py, -26)
            end

            local function insideFrame(frame, pos)
                local absPos = frame.AbsolutePosition
                local absSize = frame.AbsoluteSize
                return pos.X >= absPos.X and pos.X <= absPos.X + absSize.X
                    and pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y
            end

            ContextActionService:BindActionAtPriority("FreecamTouch", function(_, state, input)
                if input.UserInputType ~= Enum.UserInputType.Touch then
                    return Enum.ContextActionResult.Pass
                end

                local touchPos = Vector2.new(input.Position.X, input.Position.Y)
                local began = state == Enum.UserInputState.Begin
                local changed = state == Enum.UserInputState.Change
                local ended = state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel
                local id = input

                if insideFrame(btnUp, touchPos) then
                    altButtons.up = not ended
                    keys.E = altButtons.up and 1 or 0
                    return Enum.ContextActionResult.Sink
                end

                if insideFrame(btnDown, touchPos) then
                    altButtons.down = not ended
                    keys.Q = altButtons.down and 1 or 0
                    return Enum.ContextActionResult.Sink
                end

                local touchIsInGestureArea = touchPos.X < shared.camera.ViewportSize.X / 2

                if began and not joystick.active and touchIsInGestureArea then
                    joystick.active = true
                    joystick.touchId = id
                    joystick.center = touchPos
                    joystick.axis = Vector2.new()
                    updateKnobVisual()
                    return Enum.ContextActionResult.Sink
                end

                if joystick.active and joystick.touchId == id then
                    if changed then
                        local delta = touchPos - joystick.center
                        local mag = delta.Magnitude
                        if mag > joystick.radius then
                            delta = delta / mag * joystick.radius
                        end
                        joystick.axis = Vector2.new(delta.X, delta.Y) / joystick.radius
                        gamepad.Thumbstick1 = Vector2.new(joystick.axis.X, -joystick.axis.Y)
                        updateKnobVisual()
                        return Enum.ContextActionResult.Sink
                    elseif ended then
                        joystick.active = false
                        joystick.touchId = nil
                        joystick.axis = Vector2.new()
                        gamepad.Thumbstick1 = Vector2.new()
                        updateKnobVisual()
                        return Enum.ContextActionResult.Sink
                    end
                end

                if began and not camPan.active and not touchIsInGestureArea then
                    camPan.active = true
                    camPan.touchId = id
                    camPan.lastPos = touchPos
                    return Enum.ContextActionResult.Sink
                end

                if camPan.active and camPan.touchId == id then
                    if changed then
                        local d = touchPos - camPan.lastPos
                        mouse.Delta = mouse.Delta + Vector2.new(-d.Y, -d.X)
                        camPan.lastPos = touchPos
                        return Enum.ContextActionResult.Sink
                    elseif ended then
                        camPan.active = false
                        camPan.touchId = nil
                        return Enum.ContextActionResult.Sink
                    end
                end

                return Enum.ContextActionResult.Pass
            end, false, High, Enum.UserInputType.Touch)
        end

