function applyAntiSurge(enabled)
    local method = getgenv().msdoors.antisurgemethod or (shared.testexecutor.hookmetamethod and "HookMethod" or "RemoteSwap")
    
    cleanupAntiSurge()
    
    if method == "HookMethod" then
        if enabled then
