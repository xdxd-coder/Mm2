    TimerLabel.Parent = MainFrame

    local ProgressBar = Instance.new("Frame")
    ProgressBar.BackgroundColor3 = Library.Scheme.MainColor
    ProgressBar.BorderSizePixel = 0
    ProgressBar.Size = UDim2.new(1, -12, 0, 4)
    ProgressBar.Position = UDim2.new(0, 6, 1, -8)
    ProgressBar.Parent = MainFrame

    local ProgressCorner = Instance.new("UICorner")
    ProgressCorner.CornerRadius = UDim.new(1, 0)
    ProgressCorner.Parent = ProgressBar

    local ProgressFill = Instance.new("Frame")
    ProgressFill.BackgroundColor3 = Library.Scheme.AccentColor
    ProgressFill.BorderSizePixel = 0
    ProgressFill.Size = UDim2.new(1, 0, 1, 0)
    ProgressFill.Parent = ProgressBar

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1, 0)
    FillCorner.Parent = ProgressFill

    getgenv().msdoors.hasteclockGui = ScreenGui
    getgenv().msdoors.hasteclockLabel = TimerLabel
    getgenv().msdoors.hasteclockStroke = UIStroke
    getgenv().msdoors.hasteclockBarFill = ProgressFill

    local FloorReplicated = game:GetService("ReplicatedStorage"):FindFirstChild("FloorReplicated")
    if not FloorReplicated then
        print("[ AmbushHub ] » FloorReplicated não encontrado")
        return
    end

    local digitalTimer = FloorReplicated:FindFirstChild("DigitalTimer")
    local scaryStartsNow = FloorReplicated:FindFirstChild("ScaryStartsNow")
    if not digitalTimer or not scaryStartsNow then
        print("[ AmbushHub ] » Elementos do jogo não encontrados")
        return
    end

    shared.globals.HasteClock = {
        lastSyncTick = tick(),
        lastSyncValue = digitalTimer.Value,
        maxTime = 300
    }

    shared.connections.HasteClockConns = {}

    shared.connections.HasteClockConns.DigitalTimerChanged = digitalTimer:GetPropertyChangedSignal("Value"):Connect(function()
        shared.globals.HasteClock.lastSyncTick = tick()
        shared.globals.HasteClock.lastSyncValue = digitalTimer.Value
    end)

    shared.connections.HasteClockConns.ScaryStartsNowChanged = scaryStartsNow:GetPropertyChangedSignal("Value"):Connect(function()
        getgenv().msdoors.hasteclockScary = scaryStartsNow.Value
        if not getgenv().msdoors.hasteclockScary and getgenv().msdoors.hasteclockGui then
            getgenv().msdoors.hasteclockGui.Enabled = false
        elseif getgenv().msdoors.hasteclockScary and getgenv().msdoors.hasteclockGui then
            getgenv().msdoors.hasteclockGui.Enabled = true
        end
    end)

    shared.connections.HasteClockConns.Render = RunService.RenderStepped:Connect(function()
        if not getgenv().msdoors.hasteclock or not getgenv().msdoors.hasteclockScary then
            return
        end

        local currentTime = math.max(0, (shared.globals.HasteClock.lastSyncTick + shared.globals.HasteClock.lastSyncValue) - tick())
        local ratio = math.clamp(currentTime / shared.globals.HasteClock.maxTime, 0, 1)

        local timerColor = Library.Scheme.AccentColor
        if ratio <= 0.2 then
            timerColor = Library.Scheme.DestructiveColor
        elseif ratio <= 0.5 then
            timerColor = Color3.fromRGB(255, 193, 7)
        end

        getgenv().msdoors.hasteclockLabel.Text = string.format("%02d:%02d", math.floor(currentTime / 60), math.floor(currentTime % 60))
        getgenv().msdoors.hasteclockLabel.TextColor3 = timerColor
        getgenv().msdoors.hasteclockStroke.Color = timerColor
        getgenv().msdoors.hasteclockBarFill.BackgroundColor3 = timerColor
        getgenv().msdoors.hasteclockBarFill.Size = UDim2.new(ratio, 0, 1, 0)
    end)

    local clientRemote = FloorReplicated:FindFirstChild("ClientRemote")
    if clientRemote then
        local tempMsdoors = clientRemote:FindFirstChild("_Msdoors")
        if tempMsdoors and #tempMsdoors:GetChildren() ~= 0 then
            local hasteFolder = clientRemote:FindFirstChild("Haste")
            if hasteFolder then
                for _, v in pairs(tempMsdoors:GetChildren()) do
                    v.Parent = hasteFolder
                end
            end
            tempMsdoors:Destroy()
        end
    end
end)
			
end
		
