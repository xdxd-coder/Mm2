local function findCollisionParts()
    local collisionParts = {}
    local collision = shared.Character:FindFirstChild("Collision")
    local collisionPart = shared.Character:FindFirstChild("CollisionPart")
    if collision then
        table.insert(collisionParts, collision)
    end
    if collisionPart then
        table.insert(collisionParts, collisionPart)
    end
    return collisionParts
end

local function setClonesMassless(massless)
    for i = 1, #getgenv().msdoors.collisionClones do
        local clone = getgenv().msdoors.collisionClones[i]
        if clone and clone.Parent then
            pcall(function() clone.Massless = massless end)
        end
    end
end

local function clearCollisionClones()
    if getgenv().msdoors.masslessLoopThread then
        task.cancel(getgenv().msdoors.masslessLoopThread)
        getgenv().msdoors.masslessLoopThread = nil
    end
    for i = 1, #getgenv().msdoors.collisionClones do
        local part = getgenv().msdoors.collisionClones[i]
        if part and part.Parent then
            pcall(function() 
                part.Massless = true
                part:Destroy()
            end)
        end
    end
    table.clear(getgenv().msdoors.collisionClones)
end

local function setupCollision()
    clearCollisionClones()
    local collisionParts = findCollisionParts()
    if #collisionParts == 0 then
        warn(" [AmbushHub] Where's the collision? '-' (sou magico nao bro) ")
        return false
    end
    for partIndex, originalPart in ipairs(collisionParts) do
        local partName = originalPart.Name
        for i = 1, 2 do
            local clone = originalPart:Clone()
            clone.Name = partName .. "Clone" .. i
            clone.CanCollide = false
            clone.Massless = true
            clone.Parent = shared.Character
            
            local collisionCrouch = clone:FindFirstChild("CollisionCrouch")
            if collisionCrouch then
                collisionCrouch:Destroy()
            end
            getgenv().msdoors.collisionClones[#getgenv().msdoors.collisionClones + 1] = clone
        end
    end
    return true
end

local function startWallBypass()
    if not setupCollision() then
        return
    end
	
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    getgenv().msdoors.masslessLoopThread = task.spawn(function()
        local toggling = false
        while getgenv().msdoors.bypassActive do
            if player:GetAttribute("Alive") == true then
                if player.Character.CollisionPart.Anchored then
                    toggling = false
                    setClonesMassless(true)
                    repeat task.wait() until not player.Character.CollisionPart.Anchored 
                    task.wait(getgenv().msdoors.returnDelay)
                end
                rayParams.FilterDescendantsInstances = {shared.Character}
                local hit = false
                local rpPos = shared.RootPart.Position
                for _, dir in ipairs(getgenv().msdoors.horizontalDirs) do
                    if workspace:Raycast(rpPos, dir.Unit * getgenv().msdoors.detectionDistance, rayParams) then
                        hit = true
                        break
                    end
                end
                if hit then
                    toggling = false
                    setClonesMassless(true)
                    task.wait(getgenv().msdoors.speedBypassDelay)
                else
                    if not toggling then
                        toggling = true
                        task.wait(getgenv().msdoors.returnDelay)
                    end
                    if not getgenv().msdoors.bypassActive then break end
                    
                    for _, state in ipairs({false, true}) do
                        if not getgenv().msdoors.bypassActive then break end
                        if shared.RootPart and shared.RootPart.Parent then
                            if shared.RootPart.Anchored then
                                toggling = false
                                break
                            end
                            rayParams.FilterDescendantsInstances = {shared.Character}
                            local hit2 = false
                            local pos2 = shared.RootPart.Position
                            for _, dir2 in ipairs(getgenv().msdoors.horizontalDirs) do
                                if workspace:Raycast(pos2, dir2.Unit * getgenv().msdoors.detectionDistance, rayParams) then
                                    hit2 = true
                                    break
                                end
                            end
                            if hit2 then
                                toggling = false
                                setClonesMassless(true)
                                break
                            end
                        end
                        setClonesMassless(state)
                        task.wait(getgenv().msdoors.speedBypassDelay)
                    end
                end
            else
                break
            end
            task.wait()
        end
        clearCollisionClones()
    end)
end

local function updateSpeeds()
    if getgenv().msdoors.speedBypassEnable then
        shared.Humanoid.WalkSpeed = getgenv().msdoors.walkspeed
    else
        local maxSpeed = getgenv().msdoors.Bypassed and 75 or (getgenv().msdoors.jumpboostEnable and 18 or 22)
        shared.Humanoid.WalkSpeed = math.min(getgenv().msdoors.walkspeed, maxSpeed)
    end
end

