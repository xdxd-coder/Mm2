local AutoAnchorasToggle = GroupAuto:AddToggle("AutoAnchoras", {
    Text = api:getTranslate("Auto solve anchors", "Resolver âncoras"),
    Default = getgenv().msdoors.autosolveanchors
})

AutoAnchorasToggle:OnChanged(function(Value)
    getgenv().msdoors.autosolveanchors = Value

    if shared.connections.AnchorSolveRoomWait then
        shared.connections.AnchorSolveRoomWait:Disconnect()
        shared.connections.AnchorSolveRoomWait = nil
    end
    if shared.connections.AnchorSolveRoom then
        shared.connections.AnchorSolveRoom:Disconnect()
        shared.connections.AnchorSolveRoom = nil
    end
    if shared.connections.AnchorSolveHint then
        shared.connections.AnchorSolveHint:Disconnect()
        shared.connections.AnchorSolveHint = nil
    end
    if shared.connections.AnchorSolveHintVisible then
        shared.connections.AnchorSolveHintVisible:Disconnect()
        shared.connections.AnchorSolveHintVisible = nil
    end
    if shared.connections.AnchorSolveCodeAdded then
        shared.connections.AnchorSolveCodeAdded:Disconnect()
        shared.connections.AnchorSolveCodeAdded = nil
    end
    if shared.connections.AnchorSolveProximity then
        shared.connections.AnchorSolveProximity:Disconnect()
        shared.connections.AnchorSolveProximity = nil
    end

    if not Value then return end

    local savedPosition = nil

    local function solveCode(codeText, noteValue)
        local newcode = ""
        for i = 1, #codeText do
            local num = tonumber(codeText:sub(i, i)) or 0
            num = (num + noteValue) % 10
            newcode = newcode .. num
        end
        return newcode
    end

    local function getCurrentAnchor()
        local room50 = workspace.CurrentRooms:FindFirstChild("50")
        if not room50 then return nil end

        local hintFrame = shared.player.PlayerGui.MainUI:FindFirstChild("AnchorHintFrame")
        if not hintFrame or not hintFrame.Visible then return nil end

        local anchorCodeText = hintFrame:FindFirstChild("AnchorCode") and hintFrame.AnchorCode.Text
        if not anchorCodeText or anchorCodeText == "" then return nil end

        local rawCode = hintFrame:FindFirstChild("Code") and hintFrame.Code.Text or ""

        local nestHandler = room50:FindFirstChild("_NestHandler")
        if not nestHandler then return nil end

        for _, d in pairs(nestHandler:GetChildren()) do
            if d.Name == "MinesAnchor"
                and d:FindFirstChild("Sign")
                and d.Sign:FindFirstChild("TextLabel")
                and d.Sign.TextLabel.Text == anchorCodeText
                and d:FindFirstChild("AnchorBase")
                and d:FindFirstChild("AnchorRemote") then

                local notifyCode = rawCode
                local noteObj = d:FindFirstChild("Note")

                if noteObj then
                    local surfaceGui = noteObj:FindFirstChildOfClass("SurfaceGui")
                    if surfaceGui then
                        local textLabel = surfaceGui:FindFirstChild("TextLabel")
                        if textLabel then
                            notifyCode = solveCode(rawCode, tonumber(textLabel.Text) or 0)
                        end
                    end
                end

                return {
                    Instance = d,
                    Remote = d.AnchorRemote,
                    RawCode = rawCode,
                    NotifyCode = notifyCode,
                    Position = d.AnchorBase.Position,
                    SignText = anchorCodeText,
                    HasNote = noteObj ~= nil
                }
            end
        end

        return nil
    end

    local function stopProximityLoop()
        if shared.connections.AnchorSolveProximity then
            shared.connections.AnchorSolveProximity:Disconnect()
            shared.connections.AnchorSolveProximity = nil
        end
    end

    local function resolveCurrentAnchor()
        if not Toggles.AutoAnchoras.Value then return end

        local anchor = getCurrentAnchor()
        if not anchor then return end

        if not savedPosition then
            local hrp = shared.player.Character and shared.player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then savedPosition = hrp.CFrame end
        end

        Notify({
            Title = api:getTranslate("Anchor Solved", "Âncora Resolvida"),
            Description = string.format("Anchor %s\nCode: %s", anchor.SignText, anchor.NotifyCode),
            Reason = anchor.HasNote and "Calculated with note modifier" or "Direct code",
            Image = "rbxassetid://10747384394",
            Color = Color3.fromRGB(0, 200, 255),
            Style = "EVENT",
            Duration = 5,
            NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
        })

        if getgenv().msdoors.anchorinchat then
            padlocknotify(string.format("Anchor %s\nCode: %s", anchor.SignText, anchor.NotifyCode))
        end

        stopProximityLoop()

        if shared.anticheatbypass and shared.anticheatbypass.bypassed then
            local character = shared.player.Character
            if not character then return end
            character:PivotTo(CFrame.new(anchor.Position + Vector3.new(0, 3, 0)))
            task.wait(0.2)
            for i = 1, 5 do
                anchor.Remote:InvokeServer(anchor.RawCode)
                task.wait(0.1)
                if anchor.Instance:GetAttribute("Activated") == true then break end
            end
        else
            shared.connections.AnchorSolveProximity = RunService.Heartbeat:Connect(function()
                if not Toggles.AutoAnchoras.Value then
                    stopProximityLoop()
                    return
                end

                if shared.anticheatbypass and shared.anticheatbypass.bypassed then
                    stopProximityLoop()
                    task.spawn(resolveCurrentAnchor)
                    return
                end

                local character = shared.player.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                if anchor.Instance:GetAttribute("Activated") == true then
                    stopProximityLoop()
                    return
                end

                local dist = (hrp.Position - anchor.Position).Magnitude

                if dist > 10 then
                    character:PivotTo(CFrame.new(
                        hrp.Position:Lerp(anchor.Position + Vector3.new(0, 3, 0), 0.15)
                    ))
                else
                    anchor.Remote:InvokeServer(anchor.RawCode)
                end
            end)
        end
    end

    local function bindAnchorCode(anchorCode)
        if shared.connections.AnchorSolveHint then
            shared.connections.AnchorSolveHint:Disconnect()
        end

        shared.connections.AnchorSolveHint = anchorCode:GetPropertyChangedSignal("Text"):Connect(function()
            task.wait(0.1)
            stopProximityLoop()
            task.spawn(resolveCurrentAnchor)
        end)

        if anchorCode.Text ~= "" then
            task.spawn(resolveCurrentAnchor)
        end
    end

    local function setupWithFrame(hintFrame)
        local anchorCode = hintFrame:FindFirstChild("AnchorCode")
        if anchorCode then
            bindAnchorCode(anchorCode)
        else
            shared.connections.AnchorSolveCodeAdded = hintFrame.DescendantAdded:Connect(function(desc)
                if desc.Name == "AnchorCode" then
                    shared.connections.AnchorSolveCodeAdded:Disconnect()
                    shared.connections.AnchorSolveCodeAdded = nil
                    bindAnchorCode(desc)
                end
            end)
        end

        shared.connections.AnchorSolveHintVisible = hintFrame:GetPropertyChangedSignal("Visible"):Connect(function()
            if hintFrame.Visible then
                task.wait(0.1)
                stopProximityLoop()
                task.spawn(resolveCurrentAnchor)
            else
                stopProximityLoop()
                if savedPosition and shared.player.Character then
                    shared.player.Character:PivotTo(savedPosition)
                    savedPosition = nil
                end
            end
        end)

        if hintFrame.Visible then
            task.spawn(resolveCurrentAnchor)
        end
    end

    local function setupRoom50(room)
        local hintFrame = shared.player.PlayerGui.MainUI:FindFirstChild("AnchorHintFrame")
        if hintFrame then
            setupWithFrame(hintFrame)
        end

        shared.connections.AnchorSolveRoom = room.DescendantAdded:Connect(function(desc)
            if desc.Name == "AnchorHintFrame" then
                task.wait(0.1)
                setupWithFrame(desc)
            end
        end)
    end

    local room50 = workspace.CurrentRooms:FindFirstChild("50")
    if room50 then
        setupRoom50(room50)
    else
        shared.connections.AnchorSolveRoomWait = workspace.CurrentRooms.ChildAdded:Connect(function(child)
            if child.Name == "50" then
                shared.connections.AnchorSolveRoomWait:Disconnect()
                shared.connections.AnchorSolveRoomWait = nil
                setupRoom50(child)
            end
        end)
    end
end)
	
else
print(" AUTO ANCHOR SOLVE ONLY IN THE MINES. ")
end

