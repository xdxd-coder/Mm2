    local env = (getgenv and getgenv()) or shared
    if type(env.msdoorsRPC) == "table" and type(env.msdoorsRPC.createRPC) == "function" then
        drpc.rpc = env.msdoorsRPC
        return drpc.rpc
    end
    local ok, mod = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/Msdoors/Msdoors.gg/refs/heads/main/Scripts/Msdoors/internal/MyLonglegsahurApiClientIdk.luau"))()
    end)
    if ok and type(mod) == "table" and type(mod.createRPC) == "function" then
        env.msdoorsRPC = mod
        drpc.rpc = mod
        return mod
    end
    return nil
end

