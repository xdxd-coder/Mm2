local WaterESPManager = { IsActive = false }

shared.globals.WATERTOESPELETRIC = shared.globals.WATERTOESPELETRIC or {}

function WaterESPManager:GetWaterDisplayText(waterPool)
    if waterPool:GetAttribute("Electrified") == true then
        return api:getTranslate("Water [UNSAFE]", "Água [INSEGURA]") 
    else
        return api:getTranslate("Water [SAFE]", "Água [SEGURA]") 
    end
end

function WaterESPManager:GetWaterColor(waterPool)
    return waterPool:GetAttribute("Electrified") and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
end

function WaterESPManager:AddWaterESP(waterPool)
    if not waterPool then return end
    if waterPool:GetAttribute("Electrified") == nil then return end
    
    if not table.find(shared.globals.WATERTOESPELETRIC, waterPool) then
        table.insert(shared.globals.WATERTOESPELETRIC, waterPool)
    end

    local displayText = self:GetWaterDisplayText(waterPool)
    local color = self:GetWaterColor(waterPool)
    ESPManager:AddESP(waterPool, displayText, color, "water")

    if not ESPManager.Connections[waterPool] then
        ESPManager.Connections[waterPool] = {}
    end

    table.insert(ESPManager.Connections[waterPool], waterPool:GetAttributeChangedSignal("Electrified"):Connect(function()
        if ESPManager.Active[waterPool] then
            local newText = self:GetWaterDisplayText(waterPool)
            local newColor = self:GetWaterColor(waterPool)
            ESPManager:UpdateESP(waterPool, newText, newColor)
        end
    end))
end

function WaterESPManager:ScanForWater()
    if not self.IsActive then return end
    local currentRoomNumber = shared.player:GetAttribute("CurrentRoom")
    if not currentRoomNumber then return end
    local currentRoom = workspace.CurrentRooms:FindFirstChild(tostring(currentRoomNumber))
    if not currentRoom then return end
    
    local waterFolder = currentRoom:FindFirstChild("Water")
    if waterFolder then
        for _, pool in ipairs(waterFolder:GetChildren()) do
            if pool.Name:match("^Pool%d+$") or pool:IsA("BasePart") or pool:IsA("Model") then
                if pool:GetAttribute("Electrified") ~= nil then
                    self:AddWaterESP(pool)
                end
            end
        end
    end
end

function WaterESPManager:Toggle(state)
    self.IsActive = state
    getgenv().msdoors.espsettings.wateresp = state
    if state then
        self:ScanForWater()
    else
        ESPManager:ClearByType("water")
    end
end
--[[ DOORS ]]--

local function GetDoorNumber(roomName)
    local roomNumber = tonumber(roomName)

    if not roomNumber then
        return roomName
    end

    if shared.info.floor == "Mines" then
        return roomNumber + 101
    end

    return roomNumber + 1
end

function DoorESPManager:CreateDoorESP(door, config)
    local doorModel = door.Parent
    local room = doorModel.Parent
    local doorNumber = GetDoorNumber(room.Name)
    local opened = doorModel:GetAttribute("Opened")
    local locked = room:GetAttribute("RequiresKey")
    local doorState = opened and api:getTranslate("esp_door_opened", "Aberta") or (locked and api:getTranslate("esp_door_locked", "Trancada") or "")
    local displayName = string.format("%s %s %s", config.Name, tostring(doorNumber), doorState)

    if shared.info.floor == "Archives" then
        local sign = doorModel:FindFirstChild("Sign", true)
        if sign then
            local stinker = sign:FindFirstChild("Stinker", true)
            if stinker then
                local highlight = stinker:FindFirstChild("Highlight", true)
                if highlight then
                    local textProp = highlight.Text
                    if textProp and textProp ~= "" then
                        displayName = string.format("%s %s %s", config.Name, tostring(textProp), doorState)
                    end
                end
            end
        end
    end

    self.HighlightObjects = self.HighlightObjects or {}
    self.HighlightModels = self.HighlightModels or {}
    self.HighlightParts = self.HighlightParts or {}
    self.HighlightHumanoids = self.HighlightHumanoids or {}

    local espObject = door
    local highlightModel = nil
    local highlightPart = nil
    local highlightHumanoid = nil

    local doorParts = {}
    for _, child in ipairs(doorModel:GetChildren()) do
        if child.Name == "Door" and child:IsA("BasePart") then
            table.insert(doorParts, child)
        end
    end

    if #doorParts == 2 then
        highlightModel = Instance.new("Model")
        highlightModel.Name = "HighlightModel"
        highlightModel.Parent = doorModel
        
        highlightHumanoid = Instance.new("Humanoid")
        highlightHumanoid.Name = "HighlightHumanoid"
        highlightHumanoid.Parent = highlightModel

        for _, doorPart in ipairs(doorParts) do
            local hp = Instance.new("Part")
            hp.Transparency = 0.999
            hp.Size = doorPart.Size
            hp.CanCollide = false
            hp.CFrame = doorPart.CFrame
            hp.Name = "HighlightPart"
            hp.Material = Enum.Material.Plastic
            
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = hp
            weld.Part1 = doorPart
            weld.Enabled = true
            weld.Parent = hp
            
            hp.Parent = highlightModel
        end
        espObject = highlightModel
    else
        local rootPart = #doorParts > 0 and doorParts[1] or door
        highlightPart = Instance.new("Part")
        highlightPart.Transparency = 0.999
        highlightPart.Size = rootPart.Size
        highlightPart.CanCollide = false
        highlightPart.CFrame = rootPart.CFrame
        highlightPart.Name = "HighlightPart"
        highlightPart.Material = Enum.Material.Plastic
        highlightPart.Parent = doorModel
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = highlightPart
        weld.Part1 = rootPart
        weld.Enabled = true
        weld.Parent = highlightPart
        
        highlightHumanoid = Instance.new("Humanoid")
        highlightHumanoid.Name = "HighlightHumanoid"
        highlightHumanoid.Parent = doorModel
        
        espObject = highlightPart
    end

    self.HighlightObjects[door] = espObject
    self.HighlightModels[door] = highlightModel
    self.HighlightParts[door] = highlightPart
    self.HighlightHumanoids[door] = highlightHumanoid

    ESPLibrary:AddESP({ Object = espObject, Text = displayName, Color = config.GetColor() })
    return true, displayName
end

function DoorESPManager:AddDoorESP(door)
    if not door or self.ActiveDoorESPs[door] or self.ProcessedDoors[door] then return end
    local config = DoorESPConfig.Types[door.Name]
    if not config then return end
    self.ProcessedDoors[door] = true
    local success = self:CreateDoorESP(door, config)
    if success then
        local room = door.Parent.Parent
        room:SetAttribute("DOOR_ESP", true)
        if self.DoorUpdateConnections[door] then
            self.DoorUpdateConnections[door]:Disconnect()
        end
        self.DoorUpdateConnections[door] = door.Parent:GetAttributeChangedSignal("Opened"):Connect(function()
            if self.ActiveDoorESPs[door] then
                self:RemoveDoorESP(door)
                self:AddDoorESP(door)
            end
        end)
        self.ActiveDoorESPs[door] = true
    end
end

function DoorESPManager:RemoveDoorESP(door)
    if self.ActiveDoorESPs[door] then
        if self.HighlightObjects and self.HighlightObjects[door] then
            ESPLibrary:RemoveESP(self.HighlightObjects[door])
            self.HighlightObjects[door] = nil
        end
        
        if self.HighlightModels and self.HighlightModels[door] then
            self.HighlightModels[door]:Destroy()
            self.HighlightModels[door] = nil
        end
        
        if self.HighlightParts and self.HighlightParts[door] then
            if self.HighlightParts[door].Parent then
                self.HighlightParts[door]:Destroy()
            end
            self.HighlightParts[door] = nil
        end
        
        if self.HighlightHumanoids and self.HighlightHumanoids[door] then
            if self.HighlightHumanoids[door].Parent then
                self.HighlightHumanoids[door]:Destroy()
            end
            self.HighlightHumanoids[door] = nil
        end

        self.ActiveDoorESPs[door] = nil
        local room = door.Parent and door.Parent.Parent
        if room then
            room:SetAttribute("DOOR_ESP", false)
        end
    end
    if self.DoorUpdateConnections[door] then
        self.DoorUpdateConnections[door]:Disconnect()
        self.DoorUpdateConnections[door] = nil
    end
    self.ProcessedDoors[door] = nil
end

function DoorESPManager:GetDoorFromRoom(roomNumber)
    local room = workspace.CurrentRooms:FindFirstChild(tostring(roomNumber))
    if not room then return nil end
    local door = room:FindFirstChild("Door")
    if not door then return nil end
    return door:FindFirstChild("Door")
end

function DoorESPManager:OnRoomChanged(newRoom)
    if not self.IsActive then return end

    for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
        local roomNumber = tonumber(room.Name)
        if not roomNumber then continue end

        local door = room:FindFirstChild("Door")
        local doorObj = door and door:FindFirstChild("Door")
        if not doorObj then continue end

        local hasESP = room:GetAttribute("DOOR_ESP")

        if roomNumber >= newRoom and not hasESP then
            self:AddDoorESP(doorObj)
        elseif roomNumber < newRoom and hasESP then
            self:RemoveDoorESP(doorObj)
        end
    end
end

function DoorESPManager:ClearAllDoorESPs()
    for door in pairs(self.ActiveDoorESPs) do
        if self.HighlightObjects and self.HighlightObjects[door] then
            ESPLibrary:RemoveESP(self.HighlightObjects[door])
        end
        if self.HighlightModels and self.HighlightModels[door] then
            self.HighlightModels[door]:Destroy()
        end
        if self.HighlightParts and self.HighlightParts[door] then
            if self.HighlightParts[door].Parent then
                self.HighlightParts[door]:Destroy()
            end
        end
        if self.HighlightHumanoids and self.HighlightHumanoids[door] then
            if self.HighlightHumanoids[door].Parent then
                self.HighlightHumanoids[door]:Destroy()
            end
        end

        local room = door.Parent and door.Parent.Parent
        if room then
            room:SetAttribute("DOOR_ESP", false)
        end
    end

    self.ActiveDoorESPs = {}
    self.HighlightObjects = {}
    self.HighlightModels = {}
    self.HighlightParts = {}
    self.HighlightHumanoids = {}

    for _, connection in pairs(self.DoorUpdateConnections) do
        if typeof(connection) == "RBXScriptConnection" then
            connection:Disconnect()
        end
    end
    self.DoorUpdateConnections = {}
    self.ProcessedDoors = setmetatable({}, {__mode = "k"})
end

function DoorESPManager:ScanExistingRooms()
    if not self.IsActive then return end
    local currentRoom = shared.player:GetAttribute("CurrentRoom")
    for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
        local roomNumber = tonumber(room.Name)
        if roomNumber and currentRoom and roomNumber >= currentRoom then
            local door = room:FindFirstChild("Door")
            if door and door:FindFirstChild("Door") then
                self:AddDoorESP(door.Door)
            end
        end
    end
end

function DoorESPManager:Toggle(state)
    self.IsActive = state
    getgenv().msdoors.espsettings.dooresp = state
    if state then
        self:ScanExistingRooms()

        if not self.RoomChangeConnection then
            self.RoomChangeConnection = shared.player:GetAttributeChangedSignal("CurrentRoom"):Connect(function()
                if not self.IsActive then return end
                local newRoom = shared.player:GetAttribute("CurrentRoom")
                self:OnRoomChanged(newRoom)
            end)
        end

        if not self.RoomAddedConnection then
            self.RoomAddedConnection = workspace.CurrentRooms.ChildAdded:Connect(function(newRoom)
                if not self.IsActive then return end
                local currentRoom = shared.player:GetAttribute("CurrentRoom")
                local roomNumber = tonumber(newRoom.Name)
                if not roomNumber or not currentRoom or roomNumber < currentRoom then return end
                task.spawn(function()
                    local door = newRoom:WaitForChild("Door", 5)
                    if door then
                        local doorObj = door:WaitForChild("Door", 5)
                        if doorObj and self.IsActive then
                            self:AddDoorESP(doorObj)
                        end
                    end
                end)
            end)
        end

        if not self.RoomRemovedConnection then
            self.RoomRemovedConnection = workspace.CurrentRooms.ChildRemoved:Connect(function(removedRoom)
                local door = removedRoom:FindFirstChild("Door")
                if door then
                    local doorObj = door:FindFirstChild("Door")
                    if doorObj then
                        self:RemoveDoorESP(doorObj)
                    end
                end
            end)
        end
    else
        self:ClearAllDoorESPs()

        if self.RoomChangeConnection then
            self.RoomChangeConnection:Disconnect()
            self.RoomChangeConnection = nil
        end

        if self.RoomAddedConnection then
            self.RoomAddedConnection:Disconnect()
            self.RoomAddedConnection = nil
        end

        if self.RoomRemovedConnection then
            self.RoomRemovedConnection:Disconnect()
            self.RoomRemovedConnection = nil
        end
    end
end

--[[ ENTITY ESP ]]--
local EntityESPDropdown
local EntityESPDropdownUpdating = false

local function getEntityNameFromTitle(title)
    for name, config in pairs(EntityESPConfig.Types) do
        if config.Name == title then
            return name
        end
    end
    return title
end

local function ShouldESPEntity(entityName)
    local sel = getgenv().msdoors.entityEspSelectedEntities
    if not sel or #sel == 0 or table.find(sel, "All") then return true end
    if table.find(sel, entityName) then return true end
    
    local title = EntityESPConfig.Types[entityName] and EntityESPConfig.Types[entityName].Name
    return title and table.find(sel, title) or false
end

local function GetEntityESPDropdownValues()
    local values = {"All"}
    local seen = {}
    for _, config in pairs(EntityESPConfig.Types) do
        if not seen[config.Name] then
            table.insert(values, config.Name)
            seen[config.Name] = true
        end
    end
    return values
end

local function UpdateSelectedEntitiesESP(values)
    if EntityESPDropdownUpdating then return end

    local selectedEntities = {}
    local hasAll = values["All"]
    local hasOthers = false

    for displayName, selected in pairs(values) do
        if selected and displayName ~= "All" then
            hasOthers = true
            break
        end
    end

    local newState = {}

    if hasAll and hasOthers then
        EntityESPDropdownUpdating = true
        
        local prevState = getgenv().msdoors.entityEspSelectedEntities or {}
        local prevHadAll = false
        for _, v in ipairs(prevState) do
            if v == "All" then 
                prevHadAll = true 
                break 
            end
        end

        task.spawn(function()
            if prevHadAll then
                for displayName, selected in pairs(values) do
                    if selected and displayName ~= "All" then
                        newState[displayName] = true
                        table.insert(selectedEntities, getEntityNameFromTitle(displayName))
                    end
                end
            else
                newState["All"] = true
                selectedEntities = {"All"}
            end
            
            if EntityESPDropdown then
                EntityESPDropdown:SetValue(newState)
            end
            getgenv().msdoors.entityEspSelectedEntities = selectedEntities
            
            if EntityESPManager.IsEnabled then
                ESPManager:ClearByType("entity")
                EntityESPManager:ScanExisting()
            end
            
            task.wait()
            EntityESPDropdownUpdating = false
        end)
    elseif hasAll then
        selectedEntities = {"All"}
        getgenv().msdoors.entityEspSelectedEntities = selectedEntities
        if EntityESPManager.IsEnabled then
            ESPManager:ClearByType("entity")
            EntityESPManager:ScanExisting()
        end
    else
        for displayName, selected in pairs(values) do
            if selected and displayName ~= "All" then
                table.insert(selectedEntities, getEntityNameFromTitle(displayName))
            end
        end
        getgenv().msdoors.entityEspSelectedEntities = selectedEntities
        if EntityESPManager.IsEnabled then
            ESPManager:ClearByType("entity")
            EntityESPManager:ScanExisting()
        end
    end
end

function EntityESPManager:PrepareEntityForESP(entity)
    if table.find(IGNOREMEONESPNOW, entity.Name) then
        return nil
    end
    local base = entity.PrimaryPart
    if not base then
        local startTime = tick()
        while entity.PrimaryPart == nil and tick() - startTime < 1 do
            base = entity:FindFirstChildWhichIsA("BasePart", true)
            if base then
                entity.PrimaryPart = base
                break
            end
            task.wait()
        end
        base = entity.PrimaryPart
    end
    if not entity:FindFirstChildOfClass("Humanoid") and not table.find(EntityESPHumanoidBlacklist, entity.Name) then
        local hum = Instance.new("Humanoid", entity)
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    end
    if base then
        base.Transparency = 0.99
    end
    return base
end

function EntityESPManager:AddEntityESP(entity)
    if not entity or not EntityESPConfig.Types[entity.Name] then return end
    if not ShouldESPEntity(entity.Name) then return end
    
    task.spawn(function()
        local base = self:PrepareEntityForESP(entity)
        if not base then return end
        local config = EntityESPConfig.Types[entity.Name]
        ESPManager:AddESP(entity, config.Name, config.GetColor(), "entity")
        if not ESPManager.Connections[entity] then
            ESPManager.Connections[entity] = {}
        end
        table.insert(ESPManager.Connections[entity], entity.AncestryChanged:Connect(function()
            if not entity.Parent then
                ESPManager:RemoveESP(entity)
            end
        end))
    end)
end

function EntityESPManager:ScanExisting()
    if not self.IsEnabled then return end
    for _, child in ipairs(workspace:GetChildren()) do
        if EntityESPConfig.Types[child.Name] and ShouldESPEntity(child.Name) then
            self:AddEntityESP(child)
        end
    end
    if workspace:FindFirstChild("CurrentRooms") then
        for _, descendant in ipairs(workspace.CurrentRooms:GetDescendants()) do
            if EntityESPConfig.Types[descendant.Name] and ShouldESPEntity(descendant.Name) then
                self:AddEntityESP(descendant)
            end
        end
    end
end

function EntityESPManager:Toggle(state)
    self.IsEnabled = state
    getgenv().msdoors.espsettings.entityesp = state
    if state then
        self:ScanExisting()
    else
        ESPManager:ClearByType("entity")
    end
end
--[[ OBJECTIVE ESP ]]--
function ObjectiveESPManager:AddObjectiveESP(object)
    if not object or not ObjectiveESPConfig.Types[object.Name] then return end
    
    local config = ObjectiveESPConfig.Types[object.Name]
    
    if config.Name == "MinesAnchor" then
        local sign = object:FindFirstChild("Sign")
        if sign then
            local textLabel = sign:FindFirstChild("TextLabel")
            if textLabel then
                ESPManager:AddESP(object, config.Name.. textLabel.Text, config.GetColor(), "objective")
            else
                ESPManager:AddESP(object, config.Name, config.GetColor(), "objective")
            end
        else
            ESPManager:AddESP(object, config.Name, config.GetColor(), "objective")
        end
    elseif object.Name == "ArchivesStorageBox" then
        local toolBoxID = object:GetAttribute("Tool_BoxID")
        if not toolBoxID then return end
        
        if shared.globals.VALIDBOXS and table.find(shared.globals.VALIDBOXS, toolBoxID) then
            local displayText = config.Name .. " [ID: " .. tostring(toolBoxID) .. "]"
            ESPManager:AddESP(object, displayText, config.GetColor(), "objective")
        end
    elseif object.Name == "ArchivesPackageDeposit" then
        local boxID = object:GetAttribute("BoxID")
        if boxID then
            if shared.globals.VALIDBOXS and not table.find(shared.globals.VALIDBOXS, boxID) then
                table.insert(shared.globals.VALIDBOXS, boxID)
            end
            
            local displayText = config.Name .. " [ID: " .. tostring(boxID) .. "]"
            ESPManager:AddESP(object, displayText, config.GetColor(), "objective")
        end
    else
        ESPManager:AddESP(object, config.Name, config.GetColor(), "objective")
    end
end

function ObjectiveESPManager:ScanForObjectives()
    if not self.IsActive then return end
    local currentRoomNumber = shared.player:GetAttribute("CurrentRoom")
    if not currentRoomNumber then return end
    
    local currentRoom = workspace.CurrentRooms:WaitForChild(tostring(currentRoomNumber), 5)
    if not currentRoom then return end
    
    for _, descendant in ipairs(currentRoom:GetDescendants()) do
        if ObjectiveESPConfig.Types[descendant.Name] then
            if descendant:IsA("Model") and not descendant.PrimaryPart then
                local part = descendant:FindFirstChildWhichIsA("BasePart", true)
                if part then descendant.PrimaryPart = part end
            end
            
            if (descendant:IsA("Model") and descendant.PrimaryPart) or descendant:IsA("Part") then
                self:AddObjectiveESP(descendant)
            end
        end
    end
end

function ObjectiveESPManager:Toggle(state)
    self.IsActive = state
    getgenv().msdoors.espsettings.objectiveesp = state
    if state then
        if not shared.globals.VALIDBOXS then
            shared.globals.VALIDBOXS = {}
        end
        
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name == "ArchivesPackageDeposit" then
                local id = d:GetAttribute("BoxID")
                if id and not table.find(shared.globals.VALIDBOXS, id) then
                    table.insert(shared.globals.VALIDBOXS, id)
                end
            end
        end
        
        self:ScanForObjectives()
    else
        ESPManager:ClearByType("objective")
    end
end

