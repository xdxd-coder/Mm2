GroupAmbient:AddToggle("ShowEntityPath", {
    Text = api:getTranslate("See Entities Path", "Ver Caminho das Entidades"),
    Default = getgenv().msdoors.seentitypaths,
    Callback = function(state)
        getgenv().msdoors.seentitypaths = state
    
        shared.connections.ENTITYPATH = shared.connections.ENTITYPATH or {}
        shared.globals.ENTITYPATHBEAMS = shared.globals.ENTITYPATHBEAMS or {}
        shared.globals.ENTITYPATHNODES = shared.globals.ENTITYPATHNODES or {}

        local Y_OFFSET = Vector3.new(0, 1.5, 0)
        local BEAM_COLOR = Color3.fromRGB(0, 255, 255)

        local function createBeamBetweenPoints(startPos, endPos, parentFolder)
            local beam = Instance.new("Beam")
            local att0 = Instance.new("Attachment")
            local att1 = Instance.new("Attachment")
            
            local part0 = Instance.new("Part")
            part0.Anchored = true
            part0.CanCollide = false
            part0.Transparency = 1
            part0.Size = Vector3.new(0.1, 0.1, 0.1)
            part0.CFrame = CFrame.new(startPos + Y_OFFSET)
            part0.Parent = parentFolder
            
            local part1 = Instance.new("Part")
            part1.Anchored = true
            part1.CanCollide = false
            part1.Transparency = 1
            part1.Size = Vector3.new(0.1, 0.1, 0.1)
            part1.CFrame = CFrame.new(endPos + Y_OFFSET)
            part1.Parent = parentFolder
            
            att0.Parent = part0
            att1.Parent = part1
            
            beam.Attachment0 = att0
            beam.Attachment1 = att1
            beam.Color = ColorSequence.new(BEAM_COLOR)
            beam.Width0 = 0.8
            beam.Width1 = 0.8
            beam.FaceCamera = true
            beam.Transparency = NumberSequence.new(0.5)
            beam.LightEmission = 0.5
            beam.LightInfluence = 0
            beam.Brightness = 10
            beam.Parent = part0
            
            return {beam = beam, part0 = part0, part1 = part1}
        end

        local function processNodesFolder(folder, createBeams)
            if not folder or not (folder:IsA("Folder") or folder:IsA("Model")) then return end
            if folder:GetAttribute("msdoors_Processed") then return end
            folder:SetAttribute("msdoors_Processed", true)

            local nodes = {}
            for _, node in ipairs(folder:GetChildren()) do
                if node:IsA("BasePart") and not node.Name:match("^_msdoors") then
                    local id = tonumber(node.Name) or math.huge
                    table.insert(nodes, {id = id, part = node})
                end
            end

            if #nodes == 0 then return end

            table.sort(nodes, function(a, b) return a.id < b.id end)

            local beamFolder
            if createBeams then
                beamFolder = folder:FindFirstChild("_msdoors_entity_beams")
                if not beamFolder then
                    beamFolder = Instance.new("Folder")
                    beamFolder.Name = "_msdoors_entity_beams"
                    beamFolder.Parent = folder
                end
            end

            for i = 1, #nodes do
                local nodePart = nodes[i].part

                if not shared.globals.ENTITYPATHNODES[nodePart] then
                    shared.globals.ENTITYPATHNODES[nodePart] = true

                    if nodePart:GetAttribute("KKAIOUVE") == nil then
                        nodePart:SetAttribute("KKAIOUVE", nodePart.Transparency)
                    end
                    nodePart.Transparency = 0.6

                    if createBeams and i < #nodes then
                        local nextNodePart = nodes[i+1].part
                        local beamData = createBeamBetweenPoints(nodePart.Position, nextNodePart.Position, beamFolder)
                        table.insert(shared.globals.ENTITYPATHBEAMS, beamData)
                    end
                end
            end
        end

        local function scanRoom(room)
            if not room or not room:IsA("Model") then return end
            
            local pathNodes = room:FindFirstChild("PathfindNodes")
            if pathNodes then
                processNodesFolder(pathNodes, true)
            end

            local figureSetup = room:FindFirstChild("FigureSetup")
            if figureSetup then
                local chaseNodes = figureSetup:FindFirstChild("ChaseNodes")
                if chaseNodes then
                    processNodesFolder(chaseNodes, false)
                end
                
                local figureNodes = figureSetup:FindFirstChild("FigureNodes")
                if figureNodes then
                    processNodesFolder(figureNodes, false)
                end
            end
        end

        local function monitorAllRooms()
            local currentRooms = workspace:FindFirstChild("CurrentRooms")
            if not currentRooms then return end

            for _, room in pairs(currentRooms:GetChildren()) do
                scanRoom(room)
            end

            local conn1 = currentRooms.ChildAdded:Connect(function(room)
                if room:IsA("Model") and getgenv().msdoors.seentitypaths then
                    local conn2 = room.DescendantAdded:Connect(function(desc)
                        if desc:IsA("Folder") or desc:IsA("Model") then
                            if desc.Name == "PathfindNodes" then
                                processNodesFolder(desc, true)
                            elseif desc.Name == "ChaseNodes" or desc.Name == "FigureNodes" then
                                processNodesFolder(desc, false)
                            end
                        end
                    end)
                    table.insert(shared.connections.ENTITYPATH, conn2)

                    scanRoom(room)
                end
            end)
            table.insert(shared.connections.ENTITYPATH, conn1)

            local conn3 = currentRooms.DescendantAdded:Connect(function(desc)
                if (desc:IsA("Folder") or desc:IsA("Model")) then
                    if desc.Name == "PathfindNodes" then
                        processNodesFolder(desc, true)
                    elseif desc.Name == "ChaseNodes" or desc.Name == "FigureNodes" then
                        processNodesFolder(desc, false)
                    end
                end
            end)
            table.insert(shared.connections.ENTITYPATH, conn3)
        end

        if state then
            monitorAllRooms()
        else
            for _, conn in pairs(shared.connections.ENTITYPATH) do
                if conn then conn:Disconnect() end
            end
            
            for _, beamData in pairs(shared.globals.ENTITYPATHBEAMS) do
                if beamData.beam and beamData.beam.Parent then beamData.beam:Destroy() end
                if beamData.part0 and beamData.part0.Parent then beamData.part0:Destroy() end
                if beamData.part1 and beamData.part1.Parent then beamData.part1:Destroy() end
            end
            
            for nodePart, _ in pairs(shared.globals.ENTITYPATHNODES) do
                if nodePart and nodePart.Parent then
                    local origTrans = nodePart:GetAttribute("KKAIOUVE")
                    if origTrans then
                        nodePart.Transparency = origTrans
                        nodePart:SetAttribute("KKAIOUVE", nil)
                    end
                end
            end
            
            local currentRooms = workspace:FindFirstChild("CurrentRooms")
            if currentRooms then
                for _, room in pairs(currentRooms:GetChildren()) do
                    local pn = room:FindFirstChild("PathfindNodes")
                    if pn then pn:SetAttribute("msdoors_Processed", nil) end
                    local fs = room:FindFirstChild("FigureSetup")
                    if fs then
                        local cn = fs:FindFirstChild("ChaseNodes")
                        if cn then cn:SetAttribute("msdoors_Processed", nil) end
                        local fn = fs:FindFirstChild("FigureNodes")
                        if fn then fn:SetAttribute("msdoors_Processed", nil) end
                    end
                end
            end
            
            shared.connections.ENTITYPATH = {}
            shared.globals.ENTITYPATHBEAMS = {}
            shared.globals.ENTITYPATHNODES = {}
        end
    end
})

