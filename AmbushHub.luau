        shared.connections.DeleteCreakConn = RunService.Heartbeat:Connect(function()
            local liveEntities = workspace:FindFirstChild("LiveEntities")
            local creak = liveEntities and liveEntities:FindFirstChild("Creak")
            if not creak then return end

            local creakHRP = creak:FindFirstChild("HumanoidRootPart")
            if not creakHRP then return end

            local targetPos = creakHRP.Position

            for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
                local assets = room:FindFirstChild("Assets")
                if assets then
                    for _, cart in ipairs(assets:GetChildren()) do
                        if cart.Name == "ShoppingCart" then
                            local lastPusher = cart:GetAttribute("LastPusherId")
                            if lastPusher == shared.player.UserId then
                                local base = cart:FindFirstChild("Base")
                                if base and base:IsA("BasePart") and base.CollisionGroup == "CartLoose" then
                                    local exists = false
                                    for _, d in ipairs(shared.globals.CreakCarts) do
                                        if d == cart then
                                            exists = true
                                            break
                                        end
                                    end
                                    if not exists then
                                        table.insert(shared.globals.CreakCarts, cart)
                                    end
                                end
                            end
                        end
                    end
                end
            end

            for i = #shared.globals.CreakCarts, 1, -1 do
                local cart = shared.globals.CreakCarts[i]

                if not cart or not cart.Parent then
                    table.remove(shared.globals.CreakCarts, i)
                else
                    local isValid = false
                    if cart.Name == "ShoppingCart" then
                        local lastPusher = cart:GetAttribute("LastPusherId")
                        if lastPusher == shared.player.UserId then
                            local base = cart:FindFirstChild("Base")
                            if base and base:IsA("BasePart") and base.CollisionGroup == "CartLoose" then
                                isValid = true
                            end
                        end
                    end

                    if not isValid then
                        for _, part in ipairs(cart:GetDescendants()) do
                            if part:IsA("BasePart") then
                                local bp = part:FindFirstChild("MsdoorsCreakBP")
                                if bp then bp:Destroy() end
                            end
                        end
                        table.remove(shared.globals.CreakCarts, i)
                    else
                        for _, part in ipairs(cart:GetDescendants()) do
                            if part:IsA("BasePart") and not part.Anchored then
                                local bp = part:FindFirstChild("MsdoorsCreakBP")
                                if not bp then
                                    for _, c in ipairs(part:GetChildren()) do
                                        if c:IsA("BodyPosition") or c:IsA("BodyGyro") or c:IsA("BodyAngularVelocity") then
                                            c:Destroy()
                                        end
                                    end
                                    bp = Instance.new("BodyPosition")
                                    bp.Name = "MsdoorsCreakBP"
                                    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                    bp.Position = part.Position
                                    bp.Parent = part
                                end
                                
                                pcall(function()
                                    part.CanCollide = false
                                    bp.Position = targetPos + Vector3.new(
                                        math.random(-2, 2),
                                        math.random(-2, 2),
                                        math.random(-2, 2)
                                    )
                                    part.AssemblyLinearVelocity = Vector3.new(
                                        math.random(-5000, 5000),
                                        math.random(-5000, 5000),
                                        math.random(-5000, 5000)
                                    )
                                    part.AssemblyAngularVelocity = Vector3.new(
                                        math.random(-90000, 90000),
                                        math.random(-90000, 90000),
                                        math.random(-90000, 90000)
                                    )
                                end)
                            end
                        end
                    end
                end
            end
        end)
    end
})

