GroupTroll:AddToggle("BringItems", {
    Text = api:getTranslate("bring items", "Trazer Itens"),
    Default = getgenv().msdoors.bringitems,
    Disabled = IsOldFloor,
    DisabledTooltip = "Old floor",
    Callback = function(Value)
        getgenv().msdoors.bringitems = Value
        
        if shared.connections.BringItemsRender then
            shared.connections.BringItemsRender:Disconnect()
            shared.connections.BringItemsRender = nil
        end

        if not shared.globals.BringItemsList then
            shared.globals.BringItemsList = {}
        end
        
        if not Value then
            for i = #shared.globals.BringItemsList, 1, -1 do
                local part = shared.globals.BringItemsList[i]
                if part and part.Parent then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                    part.CanCollide = part:GetAttribute("OrigCanCollide") or true
                    part:SetAttribute("BringItemsActive", nil)
                end
            end
            table.clear(shared.globals.BringItemsList)
            return
        end
        
        local ignoreNames = {"Plate", "BoxBase", "ScribblesPaper", "FloatingDebris", "Wood", "SeekMound"}
        
        local function isFakeGodmodePart(part)
            if shared.globals.PARTTOFOXGODMODE and part == shared.globals.PARTTOFOXGODMODE then
                return true
            end
            if part.Name and string.sub(part.Name, 1, 19) == "MsdoorsFakeCollision" then
                return true
            end
            return false
        end
        
        local function isValidItem(part)
            if not part:IsA("BasePart") or part.Anchored then return false end
            if isFakeGodmodePart(part) then return false end
            
            local char = shared.player.Character
            if char and part:IsDescendantOf(char) then return false end
            
            local p = part
            while p and p ~= workspace do
                if table.find(ignoreNames, p.Name) then return false end
                if p.Name == "ShoppingCart" then return false end
                p = p.Parent
            end
            
            local parent = part.Parent
            if not parent then return false end
            
            if parent:FindFirstChild("PickedUpEvent", true) then return true end
            if parent:GetAttribute("Tool_Pickup") then return true end
            
            local drops = workspace:FindFirstChild("Drops")
            if drops and part:IsDescendantOf(drops) then return true end
            
            return false
        end
        
        for _, part in ipairs(workspace:GetDescendants()) do
            if isValidItem(part) and not table.find(shared.globals.BringItemsList, part) then
                part:SetAttribute("OrigCanCollide", part.CanCollide)
                part:SetAttribute("BringItemsActive", true)
                part.CanCollide = false
                table.insert(shared.globals.BringItemsList, part)
            end
        end
        
        shared.player.ReplicationFocus = workspace
        
        shared.connections.BringItemsRender = RunService.RenderStepped:Connect(function()
            if not getgenv().msdoors.bringitems then return end
            
            pcall(function() sethiddenproperty(shared.player, "SimulationRadius", math.huge) end)
            
            local char = shared.player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local mode = getgenv().msdoors.bringitemsmode or "Camera"
            local radius = getgenv().msdoors.bringitemsdistance or 6
            local spinSpeed = 1.5
            local timeOffset = tick() * spinSpeed
            local heightOffset = 2
            local useOrbit = false
            local centerPos
            
            if mode == "Camera" then
                centerPos = shared.camera.CFrame.Position
            elseif mode == "SANS" then
                centerPos = hrp.Position + hrp.CFrame.LookVector * -3
                heightOffset = 1
            else
                useOrbit = true
                centerPos = hrp.Position
            end
            
            local list = shared.globals.BringItemsList
            local count = #list
            if count == 0 then return end
            
            for i = count, 1, -1 do
                local part = list[i]
                if not part or not part.Parent or part.Anchored or isFakeGodmodePart(part) then
                    if part and part.Parent then
                        part.AssemblyLinearVelocity = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                        part.CanCollide = part:GetAttribute("OrigCanCollide") or true
                        part:SetAttribute("BringItemsActive", nil)
                    end
                    table.remove(list, i)
                else
                    part.CanCollide = false
                    local targetX, targetY, targetZ
                    
                    if useOrbit then
                        local angle = ((i - 1) / count) * (math.pi * 2) + timeOffset
                        targetX = centerPos.X + math.cos(angle) * radius
                        targetY = centerPos.Y + heightOffset
                        targetZ = centerPos.Z + math.sin(angle) * radius
                    else
                        targetX = centerPos.X
                        targetY = centerPos.Y + heightOffset
                        targetZ = centerPos.Z
                    end
                    
                    part.AssemblyLinearVelocity = Vector3.new(
                        (targetX - part.Position.X) * 30,
                        (targetY - part.Position.Y) * 30,
                        (targetZ - part.Position.Z) * 30
                    )
                end
            end
        end)
    end
