NotifyHideTimeToggle:OnChanged(function(Value)
    if getgenv().msdoors.notifyhidetime then
        if CoreGui:FindFirstChild("HideTimeNotificationGui") then
            CoreGui:FindFirstChild("HideTimeNotificationGui"):Destroy()
        end
        
        local NotificationGui = Instance.new("ScreenGui")
        NotificationGui.Name = "HideTimeNotificationGui"
        NotificationGui.Parent = CoreGui
        NotificationGui.ResetOnSpawn = false

        local NotificationLabel = Instance.new("TextLabel")
        NotificationLabel.Name = "NotificationLabel"
        NotificationLabel.Size = UDim2.new(0, 300, 0, 50)
        NotificationLabel.Position = UDim2.new(0.5, -150, 0, 80)
        NotificationLabel.BackgroundTransparency = 1
        NotificationLabel.Text = ""
        NotificationLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        NotificationLabel.TextScaled = true
        NotificationLabel.TextStrokeTransparency = 0.5
        NotificationLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        NotificationLabel.Font = Enum.Font.SourceSans
        NotificationLabel.Parent = NotificationGui
        NotificationLabel.Visible = false
        
        shared.Character:GetAttributeChangedSignal("Hiding"):Connect(function()
            if not getgenv().msdoors.notifyhidetime or not shared.loaded or not IsAlive then return end
            
            local isHiding = shared.Character:GetAttribute("Hiding")
            if not isHiding then 
                NotificationLabel.Visible = false
                return 
            end
            
            local currentRoom = shared.player:GetAttribute("CurrentRoom")
            if not currentRoom then return end
            --[[ TY MSPAINT ]]--
            local HideTimeValues = {
                {min = 1, max = 5, a = -1/6, b = 1, c = 20},
                {min = 6, max = 19, a = -1/13, b = 6, c = 19},
                {min = 19, max = 22, a = -1/4, b = 19, c = 18},
                {min = 23, max = 26, a = 1/3, b = 23, c = 18},
                {min = 26, max = 30, a = -1/4, b = 26, c = 19},
                {min = 30, max = 35, a = -1/3, b = 30, c = 18},
                {min = 36, max = 60, a = -1/12, b = 36, c = 18},
                {min = 60, max = 90, a = -1/30, b = 60, c = 16},
                {min = 90, max = 99, a = -1/6, b = 90, c = 15}
            }
            
            local hideTime = math.huge
            for _, range in pairs(HideTimeValues) do
                if currentRoom >= range.min and currentRoom <= range.max then
                    hideTime = range.a * (currentRoom - range.b) + range.c
                    break
                end
            end
            
            if hideTime == math.huge then return end
            
            local finalTime = tick() + math.round(hideTime)
            
            local connection
            connection = RunService.Heartbeat:Connect(function()
                if not shared.Character:GetAttribute("Hiding") or not IsAlive or not shared.loaded or not getgenv().msdoors.notifyhidetime then
                    connection:Disconnect()
                    NotificationLabel.Visible = false
                    return
                end
                
                local remainingTime = math.max(0, finalTime - tick())
                local message = string.format("%.1f", remainingTime)
                
                if shared.testexecutor and shared.testexecutor.require then
                    local success = pcall(function()
                        local mainGame = require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game)
                        mainGame.caption(message, true)
                    end)
                    if success then return end
                end
                
                NotificationLabel.Text = message
                NotificationLabel.TextTransparency = 0
                NotificationLabel.Visible = true
                
                if remainingTime <= 0 then
                    connection:Disconnect()
                    local fadeOutTween = TweenService:Create(
                        NotificationLabel,
                        TweenInfo.new(1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                        {TextTransparency = 1}
                    )
                    fadeOutTween:Play()
                    
                    fadeOutTween.Completed:Connect(function()
                        NotificationLabel.Visible = false
                    end)
                end
            end)
        end)
        
    else
        if CoreGui:FindFirstChild("HideTimeNotificationGui") then
            CoreGui:FindFirstChild("HideTimeNotificationGui"):Destroy()
        end
    end
end)


