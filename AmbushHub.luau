GroupAntiEntity:AddToggle("AntiLimbo", {
    Text = api:getTranslate("Anti Limbo", "Anti Limbo"),
    Default = getgenv().msdoors.antilimbo,
    Visible = IsReignited,
    Callback = function(value)
        getgenv().msdoors.antilimbo = value

        if shared.connections.AntiLimbo then
            shared.connections.AntiLimbo:Disconnect()
            shared.connections.AntiLimbo = nil
        end

        if not value then
            return
        end

        local function removeLimbo()
            local success = false

            if shared.testexecutor.require then
                local ok, LimboModule = pcall(require, game:GetService("ReplicatedStorage").ModulesClient.EntityModules.Limbo)

                if ok and LimboModule and LimboModule.despawn then
                    pcall(function()
                        LimboModule.despawn(nil, 0)
                    end)
                    success = true
                end
            end

            if not success then
                for _, effect in pairs(Lighting:GetChildren()) do
                    if effect.Name == "LimboBlur" or effect.Name == "LimboSickness" then
                        effect:Destroy()
                    end
                end

                Lighting.Brightness = 2
                Lighting.Ambient = Color3.fromRGB(0, 0, 0)
                Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)

                for _, group in pairs(SoundService:GetChildren()) do
                    for _, sound in pairs(group:GetDescendants()) do
                        if sound:IsA("Sound") and (sound.Name == "Ambience" or sound.SoundId:find("79981254132880")) then
                            sound:Destroy()
                        end
                    end
                end

                local PlayerGui = shared.player:FindFirstChild("PlayerGui")
                if PlayerGui then
                    for _, gui in pairs(PlayerGui:GetChildren()) do
                        if gui.Name == "LimboBar" then
                            gui:Destroy()
                        end
                    end
                end

                local CurrentRooms = workspace:FindFirstChild("CurrentRooms")
                if CurrentRooms then
                    for _, room in pairs(CurrentRooms:GetChildren()) do
                        for _, light in pairs(room:GetDescendants()) do
                            if light:IsA("PointLight") or light:IsA("SpotLight") or light:IsA("SurfaceLight") then
                                light.Enabled = true
                            end

                            if light:IsA("BasePart") and light.Name == "Skybox" then
                                light.Color = Color3.fromRGB(33, 5, 35)
                            end
                        end
                    end
                end
            end
        end

        removeLimbo()

        shared.connections.AntiLimbo = Lighting.ChildAdded:Connect(function(child)
            if child.Name == "LimboBlur" or child.Name == "LimboSickness" then
                removeLimbo()
            end
        end)
    end
})

		
