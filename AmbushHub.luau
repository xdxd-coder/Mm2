                if not shared.Character or not shared.RootPart or not shared.Humanoid then return end
                if not getgenv().msdoors.fly.bodyvelo or not getgenv().msdoors.fly.bodygyro then return end

                shared.Humanoid.PlatformStand = true

                local dir = Vector3.zero
                local camCF = workspace.CurrentCamera.CFrame
                local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

                if UserInputService.KeyboardEnabled then
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + camCF.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - camCF.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - flatRight end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + flatRight end
                else
                    local moveDir = shared.Humanoid.MoveDirection
                    if moveDir.Magnitude > 0 then
                        local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
                        dir = camCF.LookVector * moveDir:Dot(flatLook) + flatRight * moveDir:Dot(flatRight)
                    end
                end

                if dir.Magnitude > 0 then
                    getgenv().msdoors.fly.bodyvelo.Velocity = dir.Unit * getgenv().msdoors.fly.speed
                else
                    getgenv().msdoors.fly.bodyvelo.Velocity = Vector3.zero
                end

                getgenv().msdoors.fly.bodygyro.CFrame = CFrame.new(shared.RootPart.Position) * CFrame.fromEulerAnglesYXZ(0, math.atan2(-camCF.LookVector.X, -camCF.LookVector.Z), 0)
end
					
