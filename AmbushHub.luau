            Content = t.Description or t.Content or "",
            Icon = _toIcon(t.Image) or t.Icon,
            Duration = t.Time or t.Duration or 5,
        })
    end)
end
Library._unloadCbs = {}
function Library:OnUnload(fn) table.insert(self._unloadCbs, fn) end
function Library:Unload()
    self.Unloaded = true
    for _, fn in ipairs(self._unloadCbs) do pcall(fn) end
    pcall(function() if self._window and self._window.Destroy then self._window:Destroy() end end)
end

local function makeEl(default)
    local el = { _cbs = {}, _value = default, Value = default, _disabled = false }
    el.OnChanged = function(self, fn) table.insert(self._cbs, fn) return self end
    el.Fire = function(self, v)
        self._value = v; self.Value = v
        for _, fn in ipairs(self._cbs) do pcall(fn, v) end
        return self
    end
    el.SetValue = function(self, v)
        self._value = v; self.Value = v
        pcall(function() if self._winduiObj and self._winduiObj.Set then self._winduiObj:Set(v) end end)
        for _, fn in ipairs(self._cbs) do pcall(fn, v) end
        return self
    end
    el.SetDisabled = function(self, d) self._disabled = d return self end
    return el
end

local function attachChained(wrapper, t, lib)
    wrapper._tab = t
    wrapper._lib = lib
    wrapper.AddToggle = function(_, id, o) return lib:_addGroupElement(t, id, "Toggle", o) end
    wrapper.AddCheckbox = function(_, id, o) return lib:_addGroupElement(t, id, "Toggle", o) end
    wrapper.AddButton = function(_, o1, o2) return lib:_addButtonElement(t, o1, o2) end
    wrapper.AddSlider = function(_, id, o) return lib:_addGroupElement(t, id, "Slider", o) end
    wrapper.AddDropdown = function(_, id, o) return lib:_addGroupElement(t, id, "Dropdown", o) end
    wrapper.AddInput = function(_, id, o) return lib:_addGroupElement(t, id, "Input", o) end
    wrapper.AddColorPicker = function(_, id, o) return lib:_addGroupElement(t, id, "Colorpicker", o) end
    wrapper.AddKeyPicker = function(_, id, o) return lib:_addGroupElement(t, id, "Keybind", o) end
    wrapper.AddLabel = function(_, text, isWrapped)
        local lab = { Text = text }
        attachChained(lab, t, lib)
        pcall(function() t:Section({ Title = text }) end)
        return lab
    end
    wrapper.AddDivider = function(_) pcall(function() t:Space({}) end) end
    wrapper.AddSection = function(_, name) pcall(function() t:Section({ Title = name }) end) end
    return wrapper
end

function Library:_addGroupElement(t, id, kind, o)
    o = o or {}
    local el
    if kind == "Toggle" then
        el = makeEl(o.Default)
        local cb = o.Callback
        local okt = pcall(function()
            el._winduiObj = t:Toggle({
                Title = o.Text or id,
                Desc = o.Tooltip or o.Desc or "",
                Value = o.Default,
                Default = o.Default,
                Type = o.Type,
                Callback = function(state)
                    el:Fire(state)
                    if cb then pcall(cb, state) end
                end,
            })
        end)
        if not (okt and el._winduiObj) then
            pcall(function()
                el._winduiObj = t:Button({
                    Title = (o.Text or id) .. " [toggle]",
                    Desc = o.Tooltip or "",
                    Callback = function()
                        el:Fire(not el._value)
                        if cb then pcall(cb, el._value) end
                    end,
                })
            end)
        end
        self.Toggles[id] = el
    elseif kind == "Slider" then
        local r = o.Rounding or 0
        el = makeEl(o.Default)
        local cb = o.Callback
        pcall(function()
            el._winduiObj = t:Slider({
                Title = o.Text or id,
                Desc = o.Tooltip or "",
                Step = r > 0 and (1 / (10 ^ r)) or 1,
                Value = { Min = o.Min or 0, Max = o.Max or 100, Default = o.Default or 0 },
                Min = o.Min, Max = o.Max, Default = o.Default,
                Callback = function(v)
                    local rv = (r > 0 and math.floor(v * (10 ^ r)) / (10 ^ r)) or v
                    el:Fire(rv)
                    if cb then pcall(cb, rv) end
                end,
            })
        end)
        self.Options[id] = el
    elseif kind == "Dropdown" then
        el = makeEl(o.Default)
        local cb = o.Callback
        local function toObs(v)
            if not o.Multi then return v end
            local out = {}
            if type(v) == "table" then
                for _, x in ipairs(v) do
                    local name = (type(x) == "table" and (x.Title or x.Name)) or tostring(x)
                    out[name] = true
                end
            elseif type(v) == "string" then
                out[v] = true
            end
            return out
        end
        pcall(function()
            el._winduiObj = t:Dropdown({
                Title = o.Text or id,
                Desc = o.Tooltip or "",
                Values = o.Values or {},
                Value = o.Default,
                Multi = o.Multi or false,
                AllowNone = true,
                Callback = function(sel)
                    local ov = toObs(sel)
                    el:Fire(ov)
                    if cb then pcall(cb, ov) end
                end,
            })
        end)
        el.SetValue = function(self, v)
            self._value = v; self.Value = v
            pcall(function() if self._winduiObj and self._winduiObj.Set then self._winduiObj:Set(v) end end)
            pcall(function() if self._winduiObj and self._winduiObj.Refresh then self._winduiObj:Refresh(v) end end)
            for _, fn in ipairs(self._cbs) do pcall(fn, v) end
        end
        el.SetValues = function(self, v) el:SetValue(v) end
        el.Refresh = function(self, v) el:SetValue(v) end
        self.Options[id] = el
    elseif kind == "Input" then
        el = makeEl(o.Default or "")
        local cb = o.Callback
        pcall(function()
            el._winduiObj = t:Input({
                Title = o.Text or id,
                Desc = o.Tooltip or "",
                Value = o.Default or "",
                Placeholder = o.Placeholder,
                Callback = function(v) el:Fire(v) if cb then pcall(cb, v) end end,
            })
        end)
        el.Set = function(self, v) el:Fire(v) end
        self.Options[id] = el
    elseif kind == "Colorpicker" then
        el = makeEl(o.Default or Color3.fromRGB(255, 255, 255))
        local cb = o.Callback
        pcall(function()
            el._winduiObj = t:Colorpicker({
                Title = o.Text or id or "",
                Desc = o.Tooltip or "",
                Default = o.Default,
                Transparency = 0,
                Callback = function(c) el:Fire(c) if cb then pcall(cb, c) end end,
            })
        end)
        self.Options[id] = el
    elseif kind == "Keybind" then
        local defKey = o.Default
        local defEnum
        if type(defKey) == "string" then
            defEnum = Enum.KeyCode[defKey] or Enum.KeyCode.LeftShift
        elseif typeof(defKey) == "EnumItem" then
            defEnum = defKey
        else
            defEnum = Enum.KeyCode.LeftShift
        end
        el = makeEl(defEnum)
        local cb = o.Callback
        pcall(function()
            el._winduiObj = t:Keybind({
                Title = o.Text or id or "",
                Desc = o.Tooltip or "",
                Value = (type(defKey) == "string" and defKey) or defEnum.Name,
                Callback = function(keyname)
                    local kc = (type(keyname) == "string" and Enum.KeyCode[keyname]) or keyname or defEnum
                    el:Fire(kc)
                    if cb then pcall(cb, kc) end
                end,
            })
        end)
        el.SetKeybind = function(self, k) self:Fire(k) end
        self.Options[id] = el
    end
    if not el then el = makeEl(nil) end
    attachChained(el, t, self)
    if o.Disabled then el:SetDisabled(true) end
    return el
end

function Library:_addButtonElement(t, o1, o2)
    local o = type(o1) == "table" and o1 or { Text = o1, Func = o2 }
    local self = self
    local btn = {}
    local function fire() if o.Func then pcall(o.Func) end end
    local lastClick
    pcall(function()
        btn._winduiObj = t:Button({
            Title = o.Text or "Button",
            Desc = o.DisabledTooltip or o.Tooltip or "",
            Callback = function()
                if o.DoubleClick then
                    if lastClick and (tick() - lastClick) < 0.5 then
                        fire(); lastClick = nil
                    else
                        lastClick = tick()
                    end
                else
                    fire()
                end
            end,
        })
    end)
    btn.Highlight = function(b) pcall(function() if b._winduiObj and b._winduiObj.Highlight then b._winduiObj:Highlight() end end) end
    btn.AddButton = function(_, oo) return self:_addButtonElement(t, oo) end
    attachChained(btn, t, self)
    return btn
end

function Library:CreateWindow(opts)
    opts = opts or {}
    local wOpts = {
        Title = opts.Title or "AmbushHub",
        Author = "voidena x vanta",
        Folder = "AmbushHub",
        Icon = _toIcon(opts.Icon) or "solar:ghost-bold",
        Theme = "Dark",
        Size = UDim2.fromOffset(620, 460),
    }
    local w
    local ok, err = pcall(function() w = WindUI:CreateWindow(wOpts) end)
    if not ok or not w then
        warn("[ AmbushHub ] WindUI CreateWindow failed: " .. tostring(err))
        local stubTab = {}
        local function nope() end
        stubTab.Toggle = function() return {} end
        stubTab.Button = function() return {} end
        stubTab.Slider = function() return {} end
        stubTab.Dropdown = function() return {} end
        stubTab.Input = function() return {} end
        stubTab.Colorpicker = function() return {} end
        stubTab.Keybind = function() return {} end
        stubTab.Section = nope
        stubTab.Space = nope
        stubTab.Group = function() return stubTab end
        w = { Tab = function() return stubTab end, Destroy = nope }
    end
    self._window = w
    if opts.ToggleKeybind then
        pcall(function() if w.SetToggleKey then w:SetToggleKey(opts.ToggleKeybind) end end)
    end

    local Win = {}
    Win._winduiWindow = w
    Win.Groupboxes = {}
    Win.Tabboxes = {}
    function Win:AddTab(title, icon, desc)
        local t
        pcall(function() t = w:Tab({ Title = title, Icon = _toIcon(icon), Desc = desc }) end)
        if not t then pcall(function() t = w:Tab(title, _toIcon(icon)) end) end
        local Tab = {}
        Tab._winduiTab = t
        Tab.Groupboxes = {}
        Tab.Tabboxes = {}
        local function makeGroup(name)
            local G = { Name = name }
            attachChained(G, t, self)
            table.insert(Tab.Groupboxes, G)
            return G
        end
        Tab.AddLeftGroupbox = function(_, name) return makeGroup(name) end
        Tab.AddRightGroupbox = function(_, name) return makeGroup(name) end
        Tab.AddLeftTabbox = function(_)
            local TB = {}
            TB.AddTab = function(_, name) return makeGroup(name) end
            table.insert(Tab.Tabboxes, TB)
            return TB
        end
        Tab.AddRightTabbox = function(_) return Tab:AddLeftTabbox() end
        self.Tabs[title] = Tab
        return Tab
    end
    return Win
end

