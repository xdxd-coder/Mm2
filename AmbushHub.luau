            shared.Humanoid = shared.Character:WaitForChild("Humanoid")
            shared.RootPart = shared.Character:WaitForChild("HumanoidRootPart")
            clearCollisionClones()
            
            if getgenv().msdoors.jumpboostEnable then
                shared.Character:SetAttribute("CanJump", true)
                shared.Humanoid.JumpHeight = 7.2
            end
            
            if getgenv().msdoors.speedBypassEnable then
                task.wait(0.2)
                getgenv().msdoors.bypassActive = true
                startWallBypass()
            end
            
       updateSpeeds()
        end)
        
        getgenv().msdoors.speedBypassConnections.Heartbeat = RunService.Heartbeat:Connect(function()
            if getgenv().msdoors.speedBypassEnable and getgenv().msdoors.walkspeed > 0 then
                shared.Humanoid.WalkSpeed = getgenv().msdoors.walkspeed
            end
        end)
        
    else
        if VelocitySlider then
            VelocitySlider:SetMax(30)
        end
        local maxSpeed = getgenv().msdoors.Bypassed and 75 or (getgenv().msdoors.jumpboostEnable and 18 or 22)
        getgenv().msdoors.walkspeed = math.min(getgenv().msdoors.walkspeed, maxSpeed)
