    if TrashESPManager.IsActive and TrashESPConfig.Types[descendant.Name] then
        TrashESPManager:AddTrashESP(descendant)
    end

    if DepotESPManager.IsActive and shared.info.floor == "Stairwell" then
        if descendant.Name == "Grinder1" then
            local depot = descendant.Parent
            if depot and IsDepotObject(depot) then
                DepotESPManager:AddDepotESP(depot)
            end
        end
        if descendant.Name == "SalvageScrap" then
            local depot = descendant.Parent
            if depot and IsDepotObject(depot) then
                DepotESPManager:UpdateDepotESP(depot)
            end
        end
    end

    if EntityESPManager.IsEnabled and EntityESPConfig.Types[descendant.Name] and ShouldESPEntity(descendant.Name) then
        EntityESPManager:AddEntityESP(descendant)
    end
end)

