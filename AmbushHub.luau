function shared.NotifyEntity(entityName, isDespawn)
    local notificationData = EntityTable.NotifyReason[entityName]
    if notificationData then
        local messageTemplate = isDespawn
            and (getgenv().msdoors.entitydespawnmessage or "entity despawned: %s")
            or (getgenv().msdoors.entityCustomMessage or "detected entity: %s")

        local finalMessage
        if string.find(messageTemplate, "%%s") then
            local success, result = pcall(string.format, messageTemplate, notificationData.Title)
            if success then
                finalMessage = result
            else
                finalMessage = messageTemplate .. " " .. notificationData.Title
            end
        else
            finalMessage = messageTemplate
        end

        task.spawn(function()
            Notify({
                Title = notificationData.Title,
                Description = finalMessage,
                Reason = notificationData.reason,
                Image = "rbxassetid://" .. notificationData.Image,
                Color = isDespawn and Color3.fromRGB(0, 100, 255) or Color3.fromRGB(255, 0, 0),
                Style = "ENTITIES",
                Duration = 6,
                NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
            })

            if getgenv().msdoors.chatActive and shared.loaded then
                TrySendChatMessage("" .. notificationData.Title .. " | " .. finalMessage)
            else
                -- print("")
            end
        end)
    end
end

function shared.NotifyRoom(roomName)
    local roomData = RoomTable[roomName]
    if roomData and getgenv().msdoors.roomNotify then
        task.spawn(function()
            Notify({
                Title = roomData.Title,
                Description = roomData.Description,
                Reason = roomData.reason,
                Image = "rbxassetid://" .. roomData.Image,
                Color = Color3.fromRGB(255, 0, 0),
                Style = "EVENT",
                Duration = 6,
                NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
            })

            if getgenv().msdoors.chatActive then
                TrySendChatMessage("[" .. roomData.Title .. "] - " .. roomData.Description)
            end
        end)
    end
end

local function GetItemDropdownValues()
    local values = {"All"}
    local seen = {}
    for id, name in pairs(ItemNames) do
        if not seen[name] then
            table.insert(values, name)
            seen[name] = true
        end
    end
    return values
end

local function getItemIDFromTitle(title)
    for id, name in pairs(ItemNames) do
        if name == title then
            return id
        end
    end
    return title
end



local ItemDropdown
local ItemDropdownUpdating = false
local function UpdateSelectedItemsNotify(values)
    if ItemDropdownUpdating then return end

    local selectedItems = {}
    local hasAll = values["All"]
    local hasOthers = false

    for displayName, selected in pairs(values) do
        if selected and displayName ~= "All" then
            hasOthers = true
            break
        end
    end

    local newState = {}

    if hasAll and hasOthers then
        ItemDropdownUpdating = true
        
        local prevState = getgenv().msdoors.itemNotifySelectedItems or {}
        local prevHadAll = false
        for _, v in ipairs(prevState) do
            if v == "All" then 
                prevHadAll = true 
                break 
            end
        end

        task.spawn(function()
            if prevHadAll then
                for displayName, selected in pairs(values) do
                    if selected and displayName ~= "All" then
                        newState[displayName] = true
                        table.insert(selectedItems, getItemIDFromTitle(displayName))
                    end
                end
            else
                newState["All"] = true
                selectedItems = {"All"}
            end
            
            if ItemDropdown then
                ItemDropdown:SetValue(newState)
            end
            getgenv().msdoors.itemNotifySelectedItems = selectedItems
            
            task.wait()
            ItemDropdownUpdating = false
        end)
    elseif hasAll then
        selectedItems = {"All"}
        getgenv().msdoors.itemNotifySelectedItems = selectedItems
    else
        for displayName, selected in pairs(values) do
            if selected and displayName ~= "All" then
                table.insert(selectedItems, getItemIDFromTitle(displayName))
            end
        end
        getgenv().msdoors.itemNotifySelectedItems = selectedItems
    end
end

