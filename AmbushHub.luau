local Showseekpath = GroupHotel:AddToggle("Showseekpath", {
    Text = api:getTranslate("toggle_mines_showseekpath", "Show Seek Path"),
    Default = getgenv().msdoors.showseekpath.enabled,
})

Showseekpath:OnChanged(function(state)
    getgenv().msdoors = getgenv().msdoors or {}
    getgenv().msdoors.showseekpath = getgenv().msdoors.showseekpath or {}
    getgenv().msdoors.showseekpath.enabled = state
    getgenv().msdoors.showseekpath.conncs = getgenv().msdoors.showseekpath.conncs or {}
    getgenv().msdoors.showseekpath.beams = getgenv().msdoors.showseekpath.beams or {}
    getgenv().msdoors.showseekpath.nodes = getgenv().msdoors.showseekpath.nodes or {}
    
    if state then
        local function createBeamBetweenPoints(startPos, endPos, color, toggleValue)
            local beam = Instance.new("Beam")
            local att0 = Instance.new("Attachment")
            local att1 = Instance.new("Attachment")
            
            local part0 = Instance.new("Part")
            part0.Anchored = true
            part0.CanCollide = false
            part0.Transparency = 1
            part0.Size = Vector3.new(0.1, 0.1, 0.1)
            part0.CFrame = CFrame.new(startPos)
            part0.Parent = workspace
            
            local part1 = Instance.new("Part")
            part1.Anchored = true
            part1.CanCollide = false
            part1.Transparency = 1
            part1.Size = Vector3.new(0.1, 0.1, 0.1)
            part1.CFrame = CFrame.new(endPos)
            part1.Parent = workspace
            
            att0.Parent = part0
            att1.Parent = part1
            
            beam.Attachment0 = att0
            beam.Attachment1 = att1
            beam.Color = ColorSequence.new(color)
            beam.Width0 = 0.8
            beam.Width1 = 0.8
            beam.FaceCamera = true
            beam.Transparency = NumberSequence.new(toggleValue and 0 or 1)
            beam.LightEmission = 0.5
            beam.LightInfluence = 0
            beam.Brightness = 10
            beam.CurveSize0 = 0
            beam.CurveSize1 = 0
            beam.Segments = 10
            beam.Parent = part0
            
            return {beam = beam, part0 = part0, part1 = part1, att0 = att0, att1 = att1}
        end
        
        local function processSeekGuidingLight(light)
            if not getgenv().msdoors.showseekpath.enabled then return end
            
            local attachStart = light:WaitForChild("AttachStart", 5)
            local attachEnd = light:WaitForChild("AttachEnd", 5)
            
            if attachStart and attachEnd then
                local startPos = attachStart.WorldPosition
                local endPos = attachEnd.WorldPosition
                
                local midPos = (startPos + endPos) / 2
                
                local midPart = Instance.new("Part")
                midPart.Anchored = true
                midPart.CanCollide = false
                midPart.Transparency = 1
                midPart.Size = Vector3.new(0.1, 0.1, 0.1)
                midPart.CFrame = CFrame.new(midPos)
                midPart.Parent = workspace
                
                local nodeData = {
                    startPos = startPos,
                    endPos = endPos,
                    midPos = midPos,
                    midPart = midPart,
                    light = light
                }
                
                table.insert(getgenv().msdoors.showseekpath.nodes, nodeData)
                
                local prevNode = getgenv().msdoors.showseekpath.nodes[#getgenv().msdoors.showseekpath.nodes - 1]
                
                if prevNode then
                    local beamData = createBeamBetweenPoints(prevNode.midPos, midPos, Color3.fromRGB(0, 255, 0), true)
                    table.insert(getgenv().msdoors.showseekpath.beams, beamData)
                end
            end
        end
        
        local function monitorPathLights(pathLights)
            for _, child in pairs(pathLights:GetChildren()) do
                if child.Name == "SeekGuidingLight" then
                    task.spawn(processSeekGuidingLight, child)
                end
            end
            
            table.insert(getgenv().msdoors.showseekpath.conncs, pathLights.ChildAdded:Connect(function(child)
