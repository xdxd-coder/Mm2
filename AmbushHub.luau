        enabled = false
    end
    
    if shared.globals.PARTTOFOXGODMODE then
        shared.globals.PARTTOFOXGODMODE:Destroy()
        shared.globals.PARTTOFOXGODMODE = nil
    end
    if shared.connections.ISCROUCHING then
        shared.connections.ISCROUCHING:Disconnect()
        shared.connections.ISCROUCHING = nil
    end
    
    if enabled then
        local fakeCollision = Instance.new("Part")
        fakeCollision.Name = "MsdoorsFakeCollision_" .. char.Name
        
        fakeCollision.Size = Vector3.new(2.5, 2, 2.5) 
        fakeCollision.Transparency = 1
        fakeCollision.CanCollide = true
        fakeCollision.CollisionGroup = "Player"
        fakeCollision.CanQuery = false 
        fakeCollision.CanTouch = false
        fakeCollision.Massless = true
        
        fakeCollision.BottomParamA = 0
        fakeCollision.BottomParamB = 1
        fakeCollision.TopParamA = 0
        fakeCollision.TopParamB = 1
        
        fakeCollision.Parent = workspace
        
        shared.globals.PARTTOFOXGODMODE = fakeCollision
        
        local w = Instance.new("Weld")
        w.Name = "FakeCollisionWeld"
        w.Part0 = hrp
        w.Part1 = fakeCollision
        w.C0 = CFrame.new(0, 1, 0) 
        w.Parent = fakeCollision
        
        local collisionCrouch = char:FindFirstChild("Collision") and char.Collision:FindFirstChild("CollisionCrouch")
        
        if collisionCrouch then
            if collisionCrouch.CanCollide then
                fakeCollision.CanCollide = false
                fakeCollision.CollisionGroup = "PlayerCrouching"
            else
                fakeCollision.CanCollide = true
                fakeCollision.CollisionGroup = "Player"
            end
            
            shared.connections.ISCROUCHING = collisionCrouch:GetPropertyChangedSignal("CanCollide"):Connect(function()
