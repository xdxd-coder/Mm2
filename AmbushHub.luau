local SkipForgetMeNot = GroupAuto:AddToggle('SkipForgetMeNot', {
    Text = api:getTranslate("Skip Forget Me Not", "Pular Forget-Me-Not"),
    Default = getgenv().msdoors.skipforgetmenot,
    Callback = function(Value)
        getgenv().msdoors.skipforgetmenot = Value

        if shared.connections.skipFMNPlayerConn then
            shared.connections.skipFMNPlayerConn:Disconnect()
            shared.connections.skipFMNPlayerConn = nil
        end

        if shared.connections.skipFMNRoomConn then
            shared.connections.skipFMNRoomConn:Disconnect()
            shared.connections.skipFMNRoomConn = nil
        end

        if shared.connections.skipFMNHoldTask then
            pcall(function() task.cancel(shared.connections.skipFMNHoldTask) end)
            shared.connections.skipFMNHoldTask = nil
        end

        if not Value then return end

        shared.connections.skipFMNRoomConn = workspace.CurrentRooms.ChildAdded:Connect(function(room)
            if room:GetAttribute("RawName") ~= "Archives_ForgetMeNotRoom" then return end

            local roomNum = tonumber(room.Name)
            if not roomNum then return end

            local targetRoomNum = roomNum + 1

            shared.connections.skipFMNPlayerConn = room.ChildAdded:Connect(function(child)
                if child.Name ~= shared.player.Name then return end

                if shared.connections.skipFMNPlayerConn then
                    shared.connections.skipFMNPlayerConn:Disconnect()
                    shared.connections.skipFMNPlayerConn = nil
                end

                if shared.connections.skipFMNHoldTask then
                    pcall(function() task.cancel(shared.connections.skipFMNHoldTask) end)
                end

                shared.connections.skipFMNHoldTask = task.spawn(function()
                    local startedHold = false
                    local holdDuration = 4
                    local holdStartTime = 0

                    while getgenv().msdoors.skipforgetmenot do
                        local targetRoomModel = workspace.CurrentRooms:FindFirstChild(tostring(targetRoomNum))
                        if not targetRoomModel then task.wait(0.1) continue end

                        local doorModel = targetRoomModel:FindFirstChild("Door")
                        if not doorModel or not doorModel:FindFirstChild("Door") then task.wait(0.1) continue end

                        local doorPart = doorModel.Door
                        local char = shared.player.Character
                        if not char or not char:FindFirstChild("HumanoidRootPart") then task.wait(0.1) continue end

                        local hrp = char.HumanoidRootPart
                        local targetCFrame = CFrame.new(doorPart.Position + doorPart.CFrame.LookVector * -2)
                        local isOpen = doorModel:GetAttribute("Opened")

                        if isOpen and not startedHold then
                            startedHold = true
                            holdStartTime = tick()
                            holdDuration = 4
                        end

                        if not startedHold then
                            hrp.CFrame = targetCFrame
                            local lock = doorModel:FindFirstChild("Lock")
                            if lock then
                                local distance = (hrp.Position - lock.Position).Magnitude
                                if distance < 5.5 then
                                    local prompt = lock:FindFirstChildOfClass("ProximityPrompt")
                                    if prompt then
                                        fireproximityprompt(prompt)
                                    end
                                end
                            end
                            
                            if doorModel:GetAttribute("Opened") then
                                startedHold = true
                                holdStartTime = tick()
                                holdDuration = 0
                            end
                        else
                            hrp.CFrame = targetCFrame
                            if tick() - holdStartTime >= holdDuration then
                                break
                            end
                        end

                        task.wait(0.1)
                    end
                    
                    if shared.connections.skipFMNHoldTask then
                        shared.connections.skipFMNHoldTask = nil
                    end
                end)
            end)
        end)
    end
})

local AutoAlma = GroupAuto:AddToggle('AutoAlma', {
    Text = api:getTranslate("Auto Alma", "Auto Alma"),
    Default = getgenv().msdoors.autoalma,
    Callback = function(Value)
        getgenv().msdoors.autoalma = Value

        if shared.connections.AUTOALMAISFORDUMBPERSONS then
            for _, conn in pairs(shared.connections.AUTOALMAISFORDUMBPERSONS) do
                if typeof(conn) == "RBXScriptConnection" then
                    pcall(function() conn:Disconnect() end)
                end
            end
        end
        shared.connections.AUTOALMAISFORDUMBPERSONS = {}

        if not Value then return end

        local function processAlmaModel(almaModel)
            if not almaModel or not almaModel.Parent then return end
            
            local function replaceFailRemote()
                local oldFail = almaModel:FindFirstChild("AlmaMinigameFail")
                if oldFail and oldFail:IsA("RemoteEvent") then
                    local fakeFail = Instance.new("RemoteEvent")
                    fakeFail.Name = "AlmaMinigameFail"
                    fakeFail.Parent = almaModel
                    oldFail:Destroy()
                    return true
                end
                return false
            end

            if not replaceFailRemote() then
                local conn
                conn = almaModel.ChildAdded:Connect(function(child)
                    if getgenv().msdoors.autoalma and child.Name == "AlmaMinigameFail" then
                        replaceFailRemote()
                        if conn then 
                            conn:Disconnect() 
                            shared.connections.AUTOALMAISFORDUMBPERSONS[conn] = nil
                        end
                    end
                end)
                table.insert(shared.connections.AUTOALMAISFORDUMBPERSONS, conn)
            end
        end

        local function monitorParent(parent)
            if not parent then return end
            
            for _, child in ipairs(parent:GetChildren()) do
                if child.Name == "Alma" then
                    processAlmaModel(child)
                end
            end
            
            local conn = parent.ChildAdded:Connect(function(child)
                if getgenv().msdoors.autoalma and child.Name == "Alma" then
                    processAlmaModel(child)
                end
            end)
            table.insert(shared.connections.AUTOALMAISFORDUMBPERSONS, conn)
        end

        local liveEntities = workspace:FindFirstChild("LiveEntities")
        if liveEntities then
            monitorParent(liveEntities)
        end
        
        monitorParent(workspace)
    end
})

