            if figure:IsA("Model") and figure.Name == "FigureRig" and figure:FindFirstChild("Root") then
                task.spawn(function()
                    if not isnetworkowner(figure.Root) then
                        local success = pcall(function()
                            setOwnerPart(figure.Root, shared.player)
                        end)
                        
                        if not success then
                            for i = 1, 30 do
                                if figure.Parent and figure:FindFirstChild("Root") then
                                    local currentCF = figure.Root.CFrame
                                    figure.Root.CFrame = currentCF * CFrame.new(0, 0.01, 0)
                                    figure.Root.CFrame = currentCF
                                    if isnetworkowner(figure.Root) then
                                        break
                                    end
                                    task.wait()
                                end
                            end
                            
                            if not isnetworkowner(figure.Root) then
                                Notify({
                                    Title = "Delete Figure",
                                    Description = "Failed to delete figure: Unable to get network owner.",
                                    Reason = "",
                                    Image = "rbxassetid://6023426923",
                                    Color = Color3.fromRGB(255, 50, 50),
                                    Style = "EVENT",
                                    Duration = 6,
                                    NotifyStyle = getgenv().msdoors.LibraryNotifyStyle 
                                })
                                return
                            end
                        end
                    end
                    
                    Notify({
                        Title = "Delete Figure",
                        Description = "Deleting figure...",
                        Reason = "",
                        Image = "rbxassetid://6023426923",
                        Color = Color3.fromRGB(255, 200, 0),
                        Style = "EVENT",
                        Duration = 6,
                        NotifyStyle = getgenv().msdoors.LibraryNotifyStyle 
                    })
                    
                    if shared.connections.deletefigure then
                        shared.connections.deletefigure:Disconnect()
                    end
                    
                    shared.connections.deletefigure = RunService.Heartbeat:Connect(function()
                        if figure.Parent and figure:FindFirstChild("Root") then
                            figure:PivotTo(CFrame.new(-49999, -49999, -49999))
                            figure.Root.Size = Vector3.new(0.4, 2000, 0.4)
                            figure.Root.CanCollide = false
                            if figure:FindFirstChild("Hitbox") then
                                figure.Hitbox.CanCollide = false
                            end
                        else
                            shared.connections.deletefigure:Disconnect()
                            shared.connections.deletefigure = nil
                            
                            Notify({
                                Title = "Delete Figure",
                                Description = "Figure deleted successfully!",
                                Reason = "",
                                Image = "rbxassetid://6023426923",
                                Color = Color3.fromRGB(0, 255, 100),
                                Style = "EVENT",
                                Duration = 6,
                                NotifyStyle = getgenv().msdoors.LibraryNotifyStyle 
                            })
                        end
                    end)
                end)
            end
        end
    else
        if shared.connections.deletefigure then
            shared.connections.deletefigure:Disconnect()
            shared.connections.deletefigure = nil
        end
    end
end)


		
