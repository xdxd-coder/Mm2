AutoLibrarySolverToggle:OnChanged(function(value)
    getgenv().msdoors.autolibrarysolver.enable = value
    
    if getgenv().msdoors.autolibrarysolver.connection then
        getgenv().msdoors.autolibrarysolver.connection:Disconnect()
        getgenv().msdoors.autolibrarysolver.connection = nil
    end
    
    if getgenv().msdoors.autolibrarysolver.characterconnection then
        getgenv().msdoors.autolibrarysolver.characterconnection:Disconnect()
        getgenv().msdoors.autolibrarysolver.characterconnection = nil
    end
    
    local function processLibraryPaper(child)
        if not getgenv().msdoors.autolibrarysolver.enable then return end
        
        local paperName
        if shared.info.floor == "Super Hard Mode" then
            paperName = "LibraryHintPaperHard"
        elseif shared.info.floor == "Hotel" then
            paperName = "LibraryHintPaper"
        else
            paperName = "LibraryHintPaper"
        end
        
        if not (child:IsA("Tool") and child.Name:match(paperName)) then return end

        local codeData = {}

        if child:FindFirstChild("UI") then
            for _, img in pairs(child.UI:GetChildren()) do
                if img:IsA("ImageLabel") and tonumber(img.Name) then
                    codeData[img.ImageRectOffset.X .. img.ImageRectOffset.Y] = {tonumber(img.Name), "_"}
                end
            end
        end

        for _, img in pairs(game.Players.LocalPlayer.PlayerGui.PermUI.Hints:GetChildren()) do
            if img.Name == "Icon" and codeData[img.ImageRectOffset.X .. img.ImageRectOffset.Y] then
                codeData[img.ImageRectOffset.X .. img.ImageRectOffset.Y][2] = img.TextLabel.Text
            end
        end

        local finalCode = {}
        for _, num in pairs(codeData) do 
            finalCode[num[1]] = num[2]
        end

        local codeString = table.concat(finalCode)
        
        local padlock = workspace:FindFirstChild("Padlock", true)
        local padlockPos = nil
        if padlock then
            if padlock:FindFirstChild("PrimaryPart") and padlock.PrimaryPart.Position then
                padlockPos = padlock.PrimaryPart.Position
            else
                for _, padlockChild in pairs(padlock:GetChildren()) do
                    if padlockChild:IsA("BasePart") and padlockChild.Position then
                        padlockPos = padlockChild.Position
                        break
                    end
                end
            end
        end
        
        local playerPos = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character.PrimaryPart and game.Players.LocalPlayer.Character.PrimaryPart.Position
        
        local isInRange = false
        if padlockPos and playerPos then
            local distance = (padlockPos - playerPos).Magnitude
            isInRange = distance <= getgenv().msdoors.autolibrarysolver.distancetoopen
        end

        local function setPadlockNumbers(code)
            if padlock then
                for i, padlockChild in pairs(padlock:GetChildren()) do
                    if padlockChild:FindFirstChild("NumberUI") and padlockChild.NumberUI:FindFirstChild("TextLabel") then
                        local digit = code:sub(i, i)
                        if digit and digit ~= "" then
                            padlockChild.NumberUI.TextLabel.Text = digit
                        end
                    end
                end
            end
        end

        if tonumber(codeString) and padlock and isInRange then
            if not getgenv().msdoors.autolibrarysolver.enable then return end
            
            setPadlockNumbers(codeString)

            if shared.info.floor == "Super Hard Mode" then
                local args = { [1] = codeString }
                game:GetService("ReplicatedStorage").EntityInfo.PL:FireServer(unpack(args))
            	else
                local code = { [1] = codeString }
                game:GetService("ReplicatedStorage").RemotesFolder.PL:FireServer(unpack(code))
            end
        elseif getgenv().msdoors.autolibrarysolver.bruteforce and padlock and isInRange then
            local missingCount = 0
            for i = 1, #codeString do
                local char = codeString:sub(i, i)
                if char == "_" then
                    missingCount = missingCount + 1
                end
            end
					
            if missingCount == 2 or missingCount == 1 then
                if getgenv().msdoors.padlocknotifychatActive then
                    Notify({
                        Title = api:getTranslate("notify_padlockcode", "Código do cadeado"),
                        Description = api:getTranslate("Guessing numbers, please wait...", "Adivinhando números, aguarde..."),
                        Reason = api:getTranslate("Trying to figure out the missing digits", "Tentando descobrir os dígitos faltantes"),
                        Color = Color3.fromRGB(255, 165, 0),
                        Style = "SISTEMA",
                        Duration = 3,
                        NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                    })
                end
                
                local foundCode = false
                for first = 0, 9 do
                    for second = 0, 9 do
                        if not getgenv().msdoors.autolibrarysolver.enable then break end
                        
                        local currentPadlock = workspace:FindFirstChild("Padlock", true)
                        if not currentPadlock then 
                            foundCode = true
                            break 
                        end
                        
                        if currentPadlock:FindFirstChild("Solved") and currentPadlock.Solved.Value == true then
                            foundCode = true
                            if getgenv().msdoors.padlocknotifychatActive then
                                Notify({
                                    Title = api:getTranslate("notify_padlockcode", "Código do cadeado"),
                                    Description = api:getTranslate("Combination found, success!", "Combinação encontrada, sucesso!"),
                                    Reason = api:getTranslate("Padlock solved!", "Cadeado resolvido!"),
                                    Color = Color3.fromRGB(0, 255, 0),
                                    Style = "SYSTEM",
                                    Duration = 5,
                                    NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                                })
                            end
                            break
                        end
                        
                        local fullCode = ""
                        local missingIndex = 1
                        
                        for j = 1, #codeString do
                            local char = codeString:sub(j, j)
                            if char == "_" then
                                if missingIndex == 1 then
                                    fullCode = fullCode .. tostring(first)
                                else
                                    fullCode = fullCode .. tostring(second)
                                end
                                missingIndex = missingIndex + 1
                            else
                                fullCode = fullCode .. char
                            end
                        end
                        
                        setPadlockNumbers(fullCode)
                        
                        if shared.info.floor == "Super Hard Mode" then
                            local args = { [1] = fullCode }
                            ReplicatedStorage.EntityInfo.PL:FireServer(unpack(args))
							print(fullCode)
						else
						    local code = { [1] = fullCode }
                            ReplicatedStorage.RemotesFolder.PL:FireServer(unpack(code))
							print(fullCode)
                        end
                        
                        task.wait(0.1)
                        
                        currentPadlock = workspace:FindFirstChild("Padlock", true)
                        if not currentPadlock then
                            foundCode = true
                            if getgenv().msdoors.padlocknotifychatActive then
                                Notify({
                                    Title = api:getTranslate("notify_padlockcode", "Código do cadeado"),
                                    Description = api:getTranslate("Combination found, success!", "Combinação encontrada, sucesso!"),
                                    Reason = api:getTranslate("code:", "código:") .. fullCode,
                                    Color = Color3.fromRGB(0, 255, 0),
                                    Style = "SISTEMA",
                                    Duration = 5,
                                    NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                                })
								
                            end
                            
                            break
                        end
                        
                        if currentPadlock:FindFirstChild("Solved") and currentPadlock.Solved.Value == true then
                            foundCode = true
                            if getgenv().msdoors.padlocknotifychatActive then
                                Notify({
                                    Title = api:getTranslate("notify_padlockcode", "Código do cadeado"),
                                    Description = api:getTranslate("Combination found, success!", "Combinação encontrada, sucesso!"),
                                    Reason = api:getTranslate("code:", "código:") .. fullCode,
                                    Color = Color3.fromRGB(0, 255, 0),
                                    Style = "SISTEMA",
                                    Duration = 5,
                                    NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                                })
                            end
                            break
                        end
                    end
                    if not getgenv().msdoors.autolibrarysolver.enable then break end
                    if foundCode then break end
                end
            end
        end

    end
    
    if value then
        if shared.Character then
            getgenv().msdoors.autolibrarysolver.connection = game.Players.LocalPlayer.Character.ChildAdded:Connect(processLibraryPaper)
        end
        
        getgenv().msdoors.autolibrarysolver.characterconnection = shared.player.CharacterAdded:Connect(function(character)
            if not getgenv().msdoors.autolibrarysolver.enable and shared.loaded then return end
            
            getgenv().msdoors.autolibrarysolver.connection = character.ChildAdded:Connect(processLibraryPaper)
        end)
    end
end)
	
