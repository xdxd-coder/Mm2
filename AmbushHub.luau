GroupRankedPlayer:AddToggle("AimProjectiles", {
    Text = api:getTranslate("Auto Aim Projectiles", "Mirar Automaticamente em oponentes"),
    Default = getgenv().msdoors.aimprojectiles,
    Callback = function(value)
        getgenv().msdoors.aimprojectiles = value
        
        if value then
            local connection
            connection = RunService.RenderStepped:Connect(function()
                if not getgenv().msdoors.aimprojectiles then 
                    connection:Disconnect()
                    return 
                end
                
                if not LocalPlayer.Character then return end
                
                for _, child in pairs(Workspace[shared.player.Name]:GetChildren()) do
                    if child:GetAttribute("ProjectileType") then
                        local closestDist = math.huge
                        local closestPlayer = nil
                        local closestRootPart = nil
                        
                        for _, player in pairs(Players:GetPlayers()) do
                            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                                local dist = (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                                if dist < closestDist then
                                    closestDist = dist
                                    closestPlayer = player
                                    closestRootPart = player.Character.HumanoidRootPart
                                end
                            end
                        end
                        
                        if closestRootPart and closestPlayer then
                            local playerPos = LocalPlayer.Character.HumanoidRootPart.Position
                            local targetPos = closestRootPart.Position
                            
                            local direction = (targetPos - playerPos).Unit
                            local itemName = child.Name
                            local projectileId = tostring(math.random(9e9, 9999999999)) .. "_" .. tostring(tick())
                            
                            local fireArgs = {
                                projectileId,
                                vector.create(playerPos.X, playerPos.Y, playerPos.Z),
                                vector.create(direction.X, direction.Y, direction.Z),
                                vector.create(targetPos.X, targetPos.Y, targetPos.Z),
                                "BigProp",
                                itemName,
                                {
                                    workspace:WaitForChild("Props"),
                                    LocalPlayer.Character
                                }
                            }
                            
                            game:GetService("ReplicatedStorage"):WaitForChild("RemotesFolder"):WaitForChild("FireProjectile"):FireServer(unpack(fireArgs))
                            
                            task.wait(0.1)
                            
                            local hitArgs = {
                                projectileId,
                                {
                                    Normal = vector.create(0, 1, 0),
                                    Material = Enum.Material.Plastic,
                                    Instance = closestRootPart,
                                    Position = vector.create(targetPos.X, targetPos.Y, targetPos.Z)
                                },
                                vector.create(targetPos.X, targetPos.Y, targetPos.Z)
                            }
                            
                            game:GetService("ReplicatedStorage"):WaitForChild("RemotesFolder"):WaitForChild("ProjectileHit"):FireServer(unpack(hitArgs))
                        end
                        break
                    end
                end
            end)
        end
    end
})
--[[ AUTO BLOCKED DOORS ]]--
GroupRankedPlayer:AddToggle("AutoBlockedDoors", {
    Text = api:getTranslate("Auto Blocked Door", "Chutar porta Automáticamente"),
    Default = getgenv().msdoors.autoblockeddoor,
    Callback = function(state)
        getgenv().msdoors.autoblockeddoor = state
        
        if state then
            local function handlePrompt(prompt)
                if prompt.Name == "PartyDoorPrompt" and prompt:IsA("ProximityPrompt") then
                    local isDoorDescendant = false
                    local parent = prompt.Parent
                    while parent do
                        if parent.Name == "Door" then
                            isDoorDescendant = true
                            break
                        end
                        parent = parent.Parent
                    end
                    
                    if isDoorDescendant then
                        task.spawn(function()
                            local clickCount = 0
                            while getgenv().msdoors.autoblockeddoor and prompt.Parent and clickCount < 30 do
                                fireproximityprompt(prompt)
                                clickCount = clickCount + 1
                                task.wait(0.1)
                            end
                        end)
                    end
                end
            end
            
            local function checkCurrentRoom()
                local roomId = shared.player:GetAttribute("CurrentRoom")
                if roomId then
                    local room = workspace.CurrentRooms:FindFirstChild(tostring(roomId))
                    if room then
                        local door = room:FindFirstChild("Door")
                        if door then
                            for _, descendant in pairs(door:GetDescendants()) do
                                if descendant.Name == "PartyDoorPrompt" and descendant:IsA("ProximityPrompt") then
                                    handlePrompt(descendant)
                                end
                            end
                            
                            door.DescendantAdded:Connect(function(descendant)
                                if getgenv().msdoors.autoblockeddoor then
                                    handlePrompt(descendant)
                                end
                            end)
                        end
                    end
                end
            end
            
            checkCurrentRoom()
            
            shared.player:GetAttributeChangedSignal("CurrentRoom"):Connect(function()
                if getgenv().msdoors.autoblockeddoor then
                    checkCurrentRoom()
                end
            end)
        end
    end
})		
