        local function expandAwayFromGate(part, gateOrigin)
            local rel = part.Position - gateOrigin
            rel = Vector3.new(rel.X, 0, rel.Z)
            if rel.Magnitude < 0.5 then return end
            local dir = rel.Unit
            local amount = 12
            local cf = part.CFrame
            local axes = {
                {vec = cf.RightVector, idx = 1},
                {vec = cf.UpVector, idx = 2},
                {vec = cf.LookVector, idx = 3}
            }
            local best = nil
            local bestDot = 0
            for _, ax in ipairs(axes) do
                local dot = math.abs(ax.vec:Dot(dir))
                if dot > bestDot then
                    bestDot = dot
                    best = ax
                end
            end
            if not best or bestDot < 0.3 then return end
            local sign = best.vec:Dot(dir) >= 0 and 1 or -1
            local size = part.Size
            local newSize
            if best.idx == 1 then
                newSize = Vector3.new(size.X + amount, size.Y, size.Z)
            elseif best.idx == 2 then
                newSize = Vector3.new(size.X, size.Y + amount, size.Z)
            else
                newSize = Vector3.new(size.X, size.Y, size.Z + amount)
            end
            part.Size = newSize
            part.CFrame = cf + best.vec * (sign * amount / 2)
        end

        local function handleGateRamp(gate)
            if shared.globals.AUTOHOTEL_GateRamps[gate] then return end

            local thingToOpen = gate:FindFirstChild("ThingToOpen") or gate:FindFirstChildWhichIsA("BasePart")
            if not thingToOpen then return end

            local gateWall = gate:FindFirstChild("GateWall")
            if gateWall and gateWall:IsA("BasePart") then
                gateWall.CanCollide = false
            end

            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {gate, shared.globals.AUTOHOTEL_NodesFolder, shared.Character}
            rayParams.RespectCanCollide = true

            local origin = thingToOpen.Position
            local size = thingToOpen.Size
            local ray = workspace:Raycast(origin, Vector3.new(0, -120, 0), rayParams)
            local floorY = ray and ray.Position.Y or (origin.Y - size.Y / 2)
            local topY = origin.Y + size.Y / 2 - 0.35
            local height = topY - floorY
            if height < 1 then return end

            local width = math.clamp(size.X + 2, 4, 12)
            local rampLen = math.clamp(height * 1.7, 6, 24)
            local flatLen = 4

            local look = thingToOpen.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude < 0.05 then
                flatLook = Vector3.new(0, 0, 1)
            else
                flatLook = flatLook.Unit
            end
            local flatRight = Vector3.new(-flatLook.Z, 0, flatLook.X)

            local topPos = Vector3.new(origin.X, topY, origin.Z)
            local flatFront = topPos - flatLook * (flatLen / 2)
            local flatBack = topPos + flatLook * (flatLen / 2)
            local frontFloorPos = flatFront - flatLook * rampLen - Vector3.new(0, height, 0)
            local backFloorPos = flatBack + flatLook * rampLen - Vector3.new(0, height, 0)

            local function createRamp(startPos, endPos)
                local horizDist = ((endPos - startPos) * Vector3.new(1, 0, 1)).Magnitude
                if horizDist < 1 then return nil end
                local midY = (startPos.Y + endPos.Y) / 2
                local mid = Vector3.new((startPos.X + endPos.X) / 2, midY, (startPos.Z + endPos.Z) / 2)
                local w = Instance.new("WedgePart")
                w.Anchored = true
                w.CanCollide = true
                w.CanQuery = false
                w.CanTouch = false
                w.Size = Vector3.new(width, height, horizDist)
                w.Material = Enum.Material.Neon
                w.Transparency = 0.5
                w.Color = Color3.fromRGB(0, 255, 0)
                w.CFrame = CFrame.lookAt(mid, Vector3.new(startPos.X, midY, startPos.Z))
                w.Parent = shared.globals.AUTOHOTEL_NodesFolder
                return w
            end

            local function createSideBarrier(startPos, endPos, sideOffset)
                local horizDist = ((endPos - startPos) * Vector3.new(1, 0, 1)).Magnitude
                if horizDist < 1 then return nil end
                local midX = (startPos.X + endPos.X) / 2 + sideOffset.X
                local midZ = (startPos.Z + endPos.Z) / 2 + sideOffset.Z
                local b = Instance.new("Part")
                b.Anchored = true
                b.CanCollide = true
                b.CanQuery = false
                b.CanTouch = false
                b.Size = Vector3.new(0.5, 15, horizDist)
                b.Transparency = 1
                b.Name = "GATE_SIDE_BARRIER"
                b.CFrame = CFrame.lookAt(Vector3.new(midX, floorY + 7.5, midZ), Vector3.new(startPos.X + sideOffset.X, floorY + 7.5, startPos.Z + sideOffset.Z))
                b.Parent = shared.globals.AUTOHOTEL_NodesFolder
                return b
            end

            local flat = Instance.new("Part")
            flat.Anchored = true
            flat.CanCollide = true
            flat.CanQuery = false
            flat.CanTouch = false
            flat.Size = Vector3.new(width, 0.3, flatLen)
            flat.Material = Enum.Material.Neon
            flat.Transparency = 0.5
            flat.Color = Color3.fromRGB(0, 255, 0)
            flat.CFrame = CFrame.lookAt(topPos, topPos + flatLook) * CFrame.new(0, 0.15, 0)
            flat.Parent = shared.globals.AUTOHOTEL_NodesFolder

            local ramp1 = createRamp(frontFloorPos, flatFront)
            local ramp2 = createRamp(backFloorPos, flatBack)
            local sideOffsetL = flatRight * (width / 2 + 1)
            local sideOffsetR = -flatRight * (width / 2 + 1)
            local barrierL = createSideBarrier(frontFloorPos, backFloorPos, sideOffsetL)
            local barrierR = createSideBarrier(frontFloorPos, backFloorPos, sideOffsetR)

            local gateRoom = getRoomOf(gate)
            if gateRoom then
                local restored = {}
                for id, data in pairs(getgenv().msdoors.storedCrouchBarriers) do
                    local obj = data.Object
                    if obj and data.Parent and data.Parent.Parent == gateRoom then
                        gateCollisionSet[obj] = true
                        obj.Parent = data.Parent
                        restored[id] = true
                    end
                end
                for id in pairs(restored) do
                    getgenv().msdoors.storedCrouchBarriers[id] = nil
                end

                for _, desc in ipairs(gateRoom:GetDescendants()) do
                    if desc:IsA("BasePart") and desc.Name == "Collision" then
                        gateCollisionSet[desc] = true
                    end
                end
                for part in pairs(gateCollisionSet) do
                    if part.Parent and getRoomOf(part) == gateRoom then
                        expandAwayFromGate(part, origin)
                    end
                end

                local gateTopY = origin.Y + size.Y / 2
                local alongHalf = rampLen + flatLen / 2 + size.Z / 2 + 3
                local lateralHalf = width / 2 + 1
                for _, desc in ipairs(gateRoom:GetDescendants()) do
                    if desc:IsA("Model") and desc.Name == "Rafter" then
                        desc:Destroy()
                    elseif desc:IsA("BasePart") and desc.Parent and desc.Name ~= "Collision" and desc.CanCollide then
                        local bottomY = desc.Position.Y - desc.Size.Y / 2
                        if bottomY >= gateTopY - 1 then
                            local rel = desc.Position - origin
                            local along = rel:Dot(flatLook)
                            local lateral = rel:Dot(flatRight)
                            if math.abs(along) <= alongHalf and math.abs(lateral) <= lateralHalf then
                                desc.CanCollide = false
                            end
                        end
                    end
                end
            end

            if shared.globals.AUTOHOTEL_BlockedFolder then
                shared.globals.AUTOHOTEL_BlockedFolder:ClearAllChildren()
            end

            shared.globals.AUTOHOTEL_GateRamps[gate] = {ramp1, flat, ramp2, barrierL, barrierR}
        end

        local function removeBlacklist(inst)
            if inst.Name == "Luggage_Cart_Crouch" then
                local id = "LuggageCart_" .. tostring(inst)
                if not getgenv().msdoors.storedCrouchBarriers[id] then
                    getgenv().msdoors.storedCrouchBarriers[id] = {Parent = inst.Parent, Object = inst}
                    inst.Parent = nil
                end
            elseif inst:IsA("UnionOperation") and inst.Name == "SeeThroughGlass" then
                local id = "Glass_" .. tostring(inst)
                if not getgenv().msdoors.storedCrouchBarriers[id] then
                    getgenv().msdoors.storedCrouchBarriers[id] = {Parent = inst.Parent, Object = inst}
                    inst.Parent = nil
                end
            elseif inst:IsA("Part") and inst.Name == "Collision" and inst.Parent and inst.Parent.Name == "Parts" and not gateCollisionSet[inst] then
                local id = "Collision_" .. tostring(inst)
                if not getgenv().msdoors.storedCrouchBarriers[id] then
                    getgenv().msdoors.storedCrouchBarriers[id] = {Parent = inst.Parent, Object = inst}
                    inst.Parent = nil
                end
            elseif inst.Name == "DoorLattice" or inst.Name == "DoorFrame" then
                if inst:IsA("BasePart") then
                    inst.CanCollide = false
                    inst.CanQuery = false
                    inst.CanTouch = true
                end
                for _, child in ipairs(inst:GetDescendants()) do
                    if child:IsA("BasePart") then
                        child.CanCollide = false
                        child.CanQuery = false
                        child.CanTouch = true
                    elseif child.Name == "HingeConstraint" or child.Name == "KnobConstraint" then
                        child:Destroy()
                    end
                end
            elseif inst.Name == "HingeConstraint" or inst.Name == "KnobConstraint" then
                if inst.Parent and inst.Parent.Name == "DoorLattice" then
                    inst:Destroy()
                end
            end
        end

        local function handleObstruction(inst)
            if inst.Name == "LiveObstructionNew" or inst.Name == "LiveObstructionNewIntro" then
                task.spawn(function()
                    local collision = inst:WaitForChild("Collision", 5)
                    if collision then collision.CanCollide = false end
                end)
            end
        end

        local function createVisualNode(pos, roomId)
            if not shared.globals.AUTOHOTEL_NodesFolder then return end
            local node = Instance.new("Part")
            node.Anchored = true
            node.CanCollide = false
            node.CanQuery = false
            node.CanTouch = false
            node.Transparency = 0.5
            node.Size = Vector3.new(0.45, 0.45, 0.45)
            node.Position = pos
            node.Color = Color3.fromRGB(0, 255, 0)
            node.Material = Enum.Material.Neon
            node:SetAttribute("ROOM_ID", roomId or 0)
            node.Parent = shared.globals.AUTOHOTEL_NodesFolder
            table.insert(d.visualNodes, node)

            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {shared.Character, shared.globals.AUTOHOTEL_NodesFolder}
            local ray = workspace:Raycast(pos, Vector3.new(0, -10, 0), rayParams)
            if ray and ray.Instance and ray.Instance:IsA("BasePart") then
                ray.Instance.CanQuery = false
            end
        end

        local function modifyPrompt(target)
            local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
            if not prompt then
                prompt = target:FindFirstChild("ModulePrompt") or target:FindFirstChild("ActivateEventPrompt")
            end
            if prompt then
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = 14
            end
        end

        local function getPartOf(target)
            if target:IsA("BasePart") then
                return target
            end
            if target:IsA("Model") then
                if target.PrimaryPart then
                    return target.PrimaryPart
                end
                return target:FindFirstChildWhichIsA("BasePart", true)
            end
            return target:FindFirstChildWhichIsA("BasePart", true)
        end

        local function getPosOf(target)
            local part = getPartOf(target)
            if part then
                return part.Position, part
            end
            local okPivot, pivot = pcall(target.GetPivot, target)
            if okPivot and pivot then
                return pivot.Position, nil
            end
            return nil, nil
        end

        local function getItem(name)
            local char = shared.player.Character
            if char then
                local found = char:FindFirstChild(name)
                if found then return found end
            end
            local bp = shared.player:FindFirstChildOfClass("Backpack")
            if bp then
                return bp:FindFirstChild(name)
            end
            return nil
        end

        local function hasItem(name)
            return getItem(name) ~= nil
        end

        local function getRoom100Box()
            local room100 = workspace.CurrentRooms:FindFirstChild("100")
            if room100 then
                local industrialGate = room100:FindFirstChild("IndustrialGate")
                if industrialGate then
                    return industrialGate:FindFirstChild("Box")
                end
            end
            return nil
        end

        local function getBlockers(room)
            if blockerCache.room == room and blockerCache.list and tick() - blockerCache.time < 2 then
                return blockerCache.list
            end
            local list = {}
            for _, desc in ipairs(room:GetDescendants()) do
                if desc:IsA("BasePart") and desc.CanCollide then
                    table.insert(list, desc)
                end
            end
            blockerCache.room = room
            blockerCache.list = list
            blockerCache.time = tick()
            return list
        end

        local function isSpotClear(blockers, ground)
            local center = ground + Vector3.new(0, 3.2, 0)
            for _, part in ipairs(blockers) do
                local rel = center - part.Position
                if rel.Magnitude <= part.Size.Magnitude * 0.5 + 3.6 then
                    local lr = part.CFrame:VectorToObjectSpace(rel)
                    local h = part.Size * 0.5
                    if math.abs(lr.X) < h.X + 1.4 and math.abs(lr.Y) < h.Y + 2.7 and math.abs(lr.Z) < h.Z + 1.4 then
                        return false
                    end
                end
            end
            return true
        end

        local function findGroundSpot(target, keyPos)
            local cached = spotCache[target]
            if cached and tick() - cached.time < 1.5 then
                return cached.pos
            end
            local currentRoomNum = shared.player:GetAttribute("CurrentRoom")
            local room = currentRoomNum and workspace.CurrentRooms:FindFirstChild(tostring(currentRoomNum))
            local blockers = room and getBlockers(room) or {}
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {target, shared.Character, shared.globals.AUTOHOTEL_NodesFolder}
            rayParams.RespectCanCollide = true
            local rootFloorY = getRootPos().Y - 3
            local spot = nil
            local clearFallback = nil
            local radii = {0, 2, 3.5, 5, 6.5, 8, 9.5, 11, 13}
            for _, radius in ipairs(radii) do
                local steps = radius == 0 and 1 or 8
                for step = 1, steps do
                    local angle = (step / steps) * math.pi * 2
                    local ox = radius == 0 and 0 or math.cos(angle) * radius
                    local oz = radius == 0 and 0 or math.sin(angle) * radius
                    local ray = workspace:Raycast(Vector3.new(keyPos.X + ox, keyPos.Y + 1, keyPos.Z + oz), Vector3.new(0, -250, 0), rayParams)
                    if ray and room and getRoomOf(ray.Instance) == room then
                        local ground = ray.Position
                        local dy = ground.Y - rootFloorY
                        if dy > -6 and dy < 1.1 then
                            local horiz = math.sqrt((ground.X - keyPos.X) ^ 2 + (ground.Z - keyPos.Z) ^ 2)
                            if isSpotClear(blockers, ground) then
                                if horiz <= 13 then
                                    spot = ground
                                    break
                                elseif not clearFallback then
                                    clearFallback = ground
                                end
                            end
                        end
                    end
                end
                if spot then break end
            end
            if not spot and clearFallback then
                spot = clearFallback
            end
            if not spot then
                local rawFallback = Vector3.new(keyPos.X, rootFloorY, keyPos.Z)
                if isSpotClear(blockers, rawFallback) then
                    spot = rawFallback
                else
                    spot = Vector3.new(getRootPos().X, rootFloorY, getRootPos().Z)
                end
            end
            spotCache[target] = { pos = spot, time = tick() }
            return spot
        end

        local function findPaperSpot(target, paperPos)
            local cached = spotCache[target]
            if cached and tick() - cached.time < 1.5 then
                return cached.pos
            end
            local currentRoomNum = shared.player:GetAttribute("CurrentRoom")
            local room = currentRoomNum and workspace.CurrentRooms:FindFirstChild(tostring(currentRoomNum))
            local blockers = room and getBlockers(room) or {}
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {target, shared.Character, shared.globals.AUTOHOTEL_NodesFolder}
            rayParams.RespectCanCollide = true
            local spot = nil
            local radii = {0, 2, 3.5, 5, 6.5, 8, 9.5, 11}
            for _, radius in ipairs(radii) do
                local steps = radius == 0 and 1 or 8
                for step = 1, steps do
                    local angle = (step / steps) * math.pi * 2
                    local ox = radius == 0 and 0 or math.cos(angle) * radius
                    local oz = radius == 0 and 0 or math.sin(angle) * radius
                    local ray = workspace:Raycast(Vector3.new(paperPos.X + ox, paperPos.Y + 1, paperPos.Z + oz), Vector3.new(0, -250, 0), rayParams)
                    if ray and room and getRoomOf(ray.Instance) == room and (ray.Instance.Size.X > 20 or ray.Instance.Size.Z > 20) then
                        local ground = ray.Position
                        if isSpotClear(blockers, ground) then
                            local horiz = math.sqrt((ground.X - paperPos.X) ^ 2 + (ground.Z - paperPos.Z) ^ 2)
                            if horiz <= 11.5 then
                                spot = ground
                                break
                            end
                        end
                    end
                end
                if spot then break end
            end
            if not spot then
                spot = Vector3.new(paperPos.X, getRootPos().Y - 3, paperPos.Z)
            end
            spotCache[target] = { pos = spot, time = tick() }
            return spot
        end

        local function getTargetPos(target)
            local targetPart = getPartOf(target)
            local targetPos
            if targetPart then
                targetPos = targetPart.Position
            else
                local okPivot, pivot = pcall(target.GetPivot, target)
                if not okPivot or not pivot then return nil end
                targetPos = pivot.Position
            end

            if target.Name == "KeyObtain" or target.Name == "LiveHintBook" or target.Name == "LiveBreakerPolePickup" or target.Name == "ElevatorBreaker" or target.Name == "ElevatorBreakerEmpty" or target.Name == "ElevatorRoot" then
                modifyPrompt(target)
                local spot = findGroundSpot(target, targetPos)
                targetPos = spot + Vector3.new(0, 2, 0)
                if shared.globals.AUTOHOTEL_TargetPart then
                    shared.globals.AUTOHOTEL_TargetPart.Position = spot
                    shared.globals.AUTOHOTEL_TargetPart.Transparency = 0.5
                end
            elseif target.Name == "ElectricalKeyObtain" then
                local spot = findGroundSpot(target, targetPos)
                targetPos = spot + Vector3.new(0, 2, 0)
                if shared.globals.AUTOHOTEL_TargetPart then
                    shared.globals.AUTOHOTEL_TargetPart.Position = spot
                    shared.globals.AUTOHOTEL_TargetPart.Transparency = 0.5
                end
            elseif target.Name == "LibraryHintPaper" then
                modifyPrompt(target)
                local spot = findPaperSpot(target, targetPos)
                targetPos = spot + Vector3.new(0, 2, 0)
                if shared.globals.AUTOHOTEL_TargetPart then
                    shared.globals.AUTOHOTEL_TargetPart.Position = spot
                    shared.globals.AUTOHOTEL_TargetPart.Transparency = 0.5
                end
            else
                if shared.globals.AUTOHOTEL_TargetPart then
                    shared.globals.AUTOHOTEL_TargetPart.Transparency = 1
                end
                if target.Name == "Door" or target.Name == "Lock" then
                    local look
                    if targetPart then
                        look = targetPart.CFrame.LookVector
                    else
                        local okPivot, pivot = pcall(target.GetPivot, target)
                        look = (okPivot and pivot) and pivot.LookVector or Vector3.new(0, 0, -1)
                    end
                    targetPos = targetPos + (-look * 3)
                end
            end
            return targetPos
        end

        local function getTarget()
            local char = shared.player.Character
            if not char then return nil end
            local currentRoomNum = shared.player:GetAttribute("CurrentRoom")
            if not currentRoomNum then return nil end
            local room = workspace.CurrentRooms:FindFirstChild(tostring(currentRoomNum))
            if not room then return nil end
            local doorModel = room:FindFirstChild("Door")

            if currentRoomNum == 100 then
                if (d.room100Phase or 0) == 0 then
                    local box = getRoom100Box()
                    if box then
                        local prompt = box:FindFirstChild("ActivateEventPrompt")
                        local interactions = prompt and prompt:GetAttribute("Interactions")
                        if interactions and interactions >= 1 then
                            d.room100Phase = 1
                        else
                            return box
                        end
                    else
                        return nil
                    end
                end
                if (d.room100Phase or 0) == 1 then
                    local known = {}
                    for _, pole in ipairs(d.room100Poles) do
                        known[pole] = true
                    end
                    for _, desc in pairs(room:GetDescendants()) do
                        if desc.Name == "LiveBreakerPolePickup" and not known[desc] then
                            table.insert(d.room100Poles, desc)
                            known[desc] = true
                        end
                    end
                    for i = #d.room100Poles, 1, -1 do
                        local pole = d.room100Poles[i]
                        if not pole or not pole.Parent or not pole:IsDescendantOf(room) then
                            table.remove(d.room100Poles, i)
                        end
                    end
                    if #d.room100Poles > 0 then
                        return d.room100Poles[1]
                    end
                    d.room100Phase = 2
                    d.room100PhaseTime = tick()
                end
                if (d.room100Phase or 0) == 2 then
                    if hasItem("KeyElectrical") then
                        d.room100Phase = 3
                    else
                        local assets = room:FindFirstChild("Assets")
                        local electricalKey = assets and assets:FindFirstChild("ElectricalKeyObtain")
                        if electricalKey and electricalKey.Parent then
                            return electricalKey
                        end
                        if not d.room100PhaseTime then
                            d.room100PhaseTime = tick()
                        end
                        if tick() - d.room100PhaseTime > 8 then
                            d.room100Phase = 3
                        else
                            return nil
                        end
                    end
                end
                if (d.room100Phase or 0) == 3 then
                    if hasItem("KeyElectrical") then
                        local electricalDoor = room:FindFirstChild("ElectricalDoor")
                        if electricalDoor then
                            local doorPart = electricalDoor:FindFirstChild("Door")
                            if doorPart then
                                local lock = doorPart:FindFirstChild("Lock")
                                if lock then return lock end
                                return doorPart
                            end
                        end
                        return nil
                    end
                    d.room100Phase = 4
                    d.room100PhaseTime = tick()
                end
                if (d.room100Phase or 0) == 4 then
                    local breakerEmpty = room:FindFirstChild("ElevatorBreakerEmpty", true)
                    if breakerEmpty and breakerEmpty.Parent then
                        local pos = getPosOf(breakerEmpty)
                        if pos then
                            d.room100BreakerPos = pos
                        end
                        return breakerEmpty
                    end
                    local breaker = room:FindFirstChild("ElevatorBreaker", true)
                    if breaker and breaker.Parent then
                        local pos = getPosOf(breaker)
                        if pos then
                            d.room100BreakerPos = pos
                        end
                        return breaker
                    end
                    if not d.room100PhaseTime then
                        d.room100PhaseTime = tick()
                    end
                    if tick() - d.room100PhaseTime > 10 then
                        d.room100Phase = 5
                    else
                        return nil
                    end
                end
                if (d.room100Phase or 0) == 6 then
                    local elevatorCar = room:FindFirstChild("ElevatorCar")
                    if elevatorCar then
                        local root = elevatorCar:FindFirstChild("ElevatorRoot")
                        if root then
                            return root
                        end
                    end
                    return nil
                end
                return nil
            end

            local rawName = room:GetAttribute("RawName")
            if (rawName and string.find(rawName, "Seek")) or workspace:FindFirstChild("SeekMovingNewClone") then
                if doorModel and not doorModel:GetAttribute("Opened") then
                    local doorPart = doorModel:FindFirstChild("Door")
                    if doorPart then return doorPart end
                    return doorModel
                end
                local nextRoom = workspace.CurrentRooms:FindFirstChild(tostring(currentRoomNum + 1))
                if nextRoom then
                    local exit = nextRoom:FindFirstChild("RoomExit")
                    if not exit then
                        local nDoor = nextRoom:FindFirstChild("Door")
                        if nDoor then exit = nDoor:FindFirstChild("Door") or nDoor end
                    end
                    if exit then return exit end
                end
                local exit = room:FindFirstChild("RoomExit")
                if not exit then
                    if doorModel then exit = doorModel:FindFirstChild("Door") or doorModel end
                end
                if exit then return exit end
                return nil
            end

            if currentRoomNum == 50 then
                local room50Open = doorModel and doorModel:GetAttribute("Opened")
                if not room50Open then
                    if #d.books == 0 then
                        for _, desc in pairs(room:GetDescendants()) do
                            if desc.Name == "LiveHintBook" then
                                table.insert(d.books, desc)
                            end
                        end
                    end

                    for i = #d.books, 1, -1 do
                        if not d.books[i] or not d.books[i].Parent then
                            table.remove(d.books, i)
                        end
                    end
                    if #d.books > 0 then
                        return d.books[1]
                    end

                    if not hasItem("LibraryHintPaper") then
                        local paper = room:FindFirstChild("LibraryHintPaper", true)
                        if paper then return paper end
                    end
                end
            end

            local isLocked = room:GetAttribute("RequiresKey") or (doorModel and doorModel:FindFirstChild("Lock"))
            if isLocked and doorModel and doorModel:GetAttribute("Opened") then
                isLocked = false
            end
            if isLocked then
                if hasItem("Key") then
                    if doorModel then
                        local doorPart = doorModel:FindFirstChild("Door")
                        if doorPart then return doorPart end
                        local lock = doorModel:FindFirstChild("Lock")
                        if lock then return lock end
                        return doorModel
                    end
                else
                    local keyObtain = room:FindFirstChild("KeyObtain", true)
                    if keyObtain then
                        if keyObtain.Parent.Name == "DrawerContainer" then
                            handleDrawer(keyObtain.Parent)
                        else
                            for drawer, _ in pairs(shared.globals.AUTOHOTEL_DrawerConnections) do
                                disconnectDrawer(drawer)
                            end
                        end
                        return keyObtain
                    end
                    local doorPart = doorModel and doorModel:FindFirstChild("Door")
                    if doorPart then return doorPart end
                    local lock = doorModel and doorModel:FindFirstChild("Lock")
                    if lock then return lock end
                    if doorModel then return doorModel end
                    return nil
                end
            else
                for drawer, _ in pairs(shared.globals.AUTOHOTEL_DrawerConnections) do
                    disconnectDrawer(drawer)
                end
            end

            if doorModel then
                local doorPart = doorModel:FindFirstChild("Door")
                if doorPart then
                    if not doorModel:GetAttribute("Opened") then
                        return doorPart
                    else
                        if currentRoomNum + 1 == 100 then
                            local box = getRoom100Box()
                            if box then return box end
                        end
                        local nextRoom = workspace.CurrentRooms:FindFirstChild(tostring(currentRoomNum + 1))
                        if nextRoom then
                            local exit = nextRoom:FindFirstChild("RoomExit")
                            if not exit then
                                local nDoor = nextRoom:FindFirstChild("Door")
                                if nDoor then exit = nDoor:FindFirstChild("Door") or nDoor end
                            end
                            if exit then return exit end
                        end
                        return doorPart
                    end
                end
            end

            return nil
        end

        local function clearPath()
            d.currentWaypoints = {}
            d.isCalculatingPath = false
            d.stuckCounter = 0
            d.lastWaypointDistance = 0
            d.waypointDistanceChecks = 0
            d.lastPosition = Vector3.new(0, 0, 0)
            d.lastStuckCheck = 0
            for _, node in pairs(d.visualNodes) do
                if node and node.Parent then node:Destroy() end
            end
            d.visualNodes = {}
        end

        local function createBlockedPoint(point)
            if not shared.globals.AUTOHOTEL_BlockedFolder then return end
            local block = Instance.new("Part")
            local pathMod = Instance.new("PathfindingModifier")
            pathMod.Label = "_seek_pathBlock"
            pathMod.Parent = block
            block.Name = "_seekhelper_blocked_path"
            block.Size = Vector3.new(2, 15, 2)
            block.Position = point.Position + Vector3.new(0, 7.5, 0)
            block.Anchored = true
            block.CanCollide = false
            block.CanQuery = false
            block.CanTouch = false
            block.Transparency = 1
            block.Parent = shared.globals.AUTOHOTEL_BlockedFolder
        end

        local function ensureFigureBlock()
            if figureBlockPart and figureBlockPart.Parent then
                return figureBlockPart
            end
            local block = Instance.new("Part")
            local pathMod = Instance.new("PathfindingModifier")
            pathMod.Label = "_figure_block"
            pathMod.Parent = block
            block.Name = "_figure_avoid_block"
            block.Size = Vector3.new(16, 15, 16)
            block.Anchored = true
            block.CanCollide = false
            block.CanQuery = false
            block.CanTouch = false
            block.Transparency = 1
            block.Parent = shared.globals.AUTOHOTEL_BlockedFolder
            figureBlockPart = block
            return block
        end

        local function computeFleeTarget(figurePos)
            local away = getRootPos() - figurePos
            away = Vector3.new(away.X, 0, away.Z)
            if away.Magnitude < 0.1 then
                return nil
            end
            away = away.Unit
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {shared.Character, shared.globals.AUTOHOTEL_NodesFolder}
            rayParams.RespectCanCollide = true
            local origin = getRootPos() - Vector3.new(0, 2.5, 0)
            local angles = {0, 45, -45, 90, -90}
            for _, deg in ipairs(angles) do
                local rad = math.rad(deg)
                local dir = Vector3.new(away.X * math.cos(rad) - away.Z * math.sin(rad), 0, away.X * math.sin(rad) + away.Z * math.cos(rad))
                local hit = workspace:Raycast(origin, dir * 16, rayParams)
                local dist = 16
                if hit then
                    dist = (hit.Position - origin).Magnitude
                end
                if dist > 7 then
                    local targetDist = math.min(dist - 2.5, 14)
                    if targetDist > 4 then
                        return shared.RootPart.Position + dir * targetDist
                    end
                end
            end
            return nil
        end

        local function getSeekPathfindingGoal()
            local currentRoom = shared.player:GetAttribute("CurrentRoom") or 1
            local nextRoomModel = workspace.CurrentRooms:FindFirstChild(tostring(currentRoom + 1))
            if nextRoomModel then
                local exit = nextRoomModel:FindFirstChild("RoomExit")
                if not exit then
                    local door = nextRoomModel:FindFirstChild("Door")
                    if door then
                        local inner = door:FindFirstChild("Door")
                        if inner then return inner end
                        return door
                    end
                end
                if exit then return exit end
            end
            local curRoomModel = workspace.CurrentRooms:FindFirstChild(tostring(currentRoom))
            if curRoomModel then
                local exit = curRoomModel:FindFirstChild("RoomExit")
                if not exit then
                    local door = curRoomModel:FindFirstChild("Door")
                    if door then
                        local inner = door:FindFirstChild("Door")
                        if inner then return inner end
                        return door
                    end
                end
                if exit then return exit end
            end
            return nil
        end

        local function computeSeekPath(startPos, endPos)
            for attempt = 1, 5 do
                local path = pathService:CreatePath({
                    AgentCanJump = false, AgentCanClimb = false,
                    WaypointSpacing = 2, AgentRadius = 1, AgentHeight = 5,
                    Costs = {_seek_pathBlock = 20, _blocked_path = 100000}
                })
                local ok = pcall(function() path:ComputeAsync(startPos, endPos) end)
                if ok and path.Status == Enum.PathStatus.Success then
                    local wps = path:GetWaypoints()
                    if wps and #wps > 0 then return wps end
                end
                task.wait(0.2)
            end
            return nil
        end

        local function extendPathToNextRoom()
            if not d.isSeekActive then return false end
            local goal = getSeekPathfindingGoal()
            if not goal then return false end
            local goalPos = getPosOf(goal)
            if not goalPos then return false end
            local lastWp = d.currentWaypoints[#d.currentWaypoints]
            if not lastWp then
                task.spawn(doPathfinding)
                return true
            end
            local wps = computeSeekPath(lastWp.Position, goalPos)
            if wps and d.isSeekActive and #d.currentWaypoints > 0 then
                local goalRoom = getRoomOf(goal)
                local roomTag = goalRoom and tonumber(goalRoom.Name) or (shared.player:GetAttribute("CurrentRoom") or 0)
                for i = 2, #wps do
                    local wp = {Position = wps[i].Position, Action = wps[i].Action, Room = roomTag}
                    table.insert(d.currentWaypoints, wp)
                    createVisualNode(wp.Position, roomTag)
                end
                return true
            end
            return false
        end

        local function extendPath(target)
            if d.isCalculatingPath then return end
            if d.isSeekActive then return end
            if not shared.RootPart then return end
            d.isCalculatingPath = true
            pcall(function()
                local targetPos = getTargetPos(target)
                if not targetPos then return end

                local targetRoom = getRoomOf(target)
                local roomTag = targetRoom and tonumber(targetRoom.Name) or (shared.player:GetAttribute("CurrentRoom") or 0)

                local startPos = getRootPos()
                if #d.currentWaypoints > 0 then
                    startPos = d.currentWaypoints[#d.currentWaypoints].Position
                end

                local path = pathService:CreatePath({
                    AgentCanJump = false,
                    AgentCanClimb = false,
                    WaypointSpacing = 2,
                    AgentRadius = 2,
                    AgentHeight = 5,
                    Costs = {_seek_pathBlock = 20, _figure_block = 500, _blocked_path = 100000}
                })

                local ok = pcall(function() path:ComputeAsync(startPos, targetPos) end)

                if ok and path.Status == Enum.PathStatus.Success then
                    local wps = path:GetWaypoints()
                    for i = 1, #wps do
                        local wp = {Position = wps[i].Position, Action = wps[i].Action, Room = roomTag}
                        table.insert(d.currentWaypoints, wp)
                        createVisualNode(wp.Position, roomTag)
                    end
                end
            end)
            d.isCalculatingPath = false
        end

        local function doPathfinding(forceTarget)
            if d.isCalculatingPath then return end
            if d.lastPathFail and tick() - d.lastPathFail < 0.25 then return end
            d.isCalculatingPath = true
            pcall(function()
                local target = forceTarget or getTarget()
                if not target then return end
                local targetPos = getTargetPos(target)
                if not targetPos then return end
                local roomTag = shared.player:GetAttribute("CurrentRoom") or 0

                if d.isSeekActive then
                    local wps = computeSeekPath(getRootPos() - Vector3.new(0, 2.5, 0), targetPos)
                    clearPath()
                    if wps then
                        for i = 1, #wps do
                            local wp = {Position = wps[i].Position, Action = wps[i].Action, Room = roomTag}
                            table.insert(d.currentWaypoints, wp)
                            createVisualNode(wp.Position, roomTag)
                        end
                    else
                        d.lastPathFail = tick()
                    end
                else
                    local succeeded = false
                    local attempts = {
                        {offset = Vector3.new(0, 2.5, 0), radius = 2},
                        {offset = Vector3.new(0, 1, 0), radius = 1.6},
                        {offset = Vector3.new(0, 4, 0), radius = 1.3},
                        {offset = Vector3.new(0, 2.5, 0), radius = 1},
                        {offset = Vector3.new(0, 1, 0), radius = 2},
                        {offset = Vector3.new(0, 4, 0), radius = 1.6}
                    }
                    for _, attempt in ipairs(attempts) do
                        if succeeded then break end
                        local path = pathService:CreatePath({
                            AgentCanJump = false,
                            AgentCanClimb = false,
                            WaypointSpacing = 2,
                            AgentRadius = attempt.radius,
                            AgentHeight = 5,
                            Costs = {_seek_pathBlock = 20, _figure_block = 500, _blocked_path = 100000}
                        })
                        local ok = pcall(function() path:ComputeAsync(getRootPos() - attempt.offset, targetPos) end)
                        if ok and path.Status == Enum.PathStatus.Success then
                            local wps = path:GetWaypoints()
                            if wps and #wps > 0 then
                                clearPath()
                                for i = 1, #wps do
                                    local wp = {Position = wps[i].Position, Action = wps[i].Action, Room = roomTag}
                                    table.insert(d.currentWaypoints, wp)
                                    createVisualNode(wp.Position, roomTag)
                                end
                                succeeded = true
                            end
                        end
                    end
                    if not succeeded then
                        clearPath()
                        d.lastPathFail = tick()
                    end
                end
            end)
            d.isCalculatingPath = false
        end

        local function checkStuck(currentWaypoint)
            if d.isWaitingForDoor then return false end
            local currentTime = tick()
            local currentDistance = (getRootPos() - currentWaypoint.Position).Magnitude

            if d.lastStuckCheck == 0 then
                d.lastStuckCheck = currentTime
                d.lastPosition = getRootPos()
                d.lastWaypointDistance = currentDistance
                return false
            end

            if currentTime - d.lastStuckCheck > 0.8 then
                local positionDistance = (getRootPos() - d.lastPosition).Magnitude

                if currentDistance > 8 and d.waypointDistanceChecks > 2 then
                    clearPath()
                    task.spawn(doPathfinding)
                    return true
                end

                if positionDistance < 1.8 then
                    d.stuckCounter = d.stuckCounter + 1
                    if math.abs(currentDistance - d.lastWaypointDistance) < 0.8 then
                        d.waypointDistanceChecks = d.waypointDistanceChecks + 1
                    else
                        d.waypointDistanceChecks = 0
                    end
                    if d.stuckCounter >= 2 or d.waypointDistanceChecks >= 3 then
                        createBlockedPoint(currentWaypoint)
                        clearPath()
                        task.spawn(doPathfinding)
                        return true
                    end
                else
                    d.stuckCounter = math.max(0, d.stuckCounter - 1)
                    d.waypointDistanceChecks = 0
                end

                d.lastPosition = getRootPos()
                d.lastStuckCheck = currentTime
                d.lastWaypointDistance = currentDistance
            end

            return false
        end

        local function executeWaypointMovement()
            if #d.currentWaypoints == 0 then return false end

            local currentRoomNum = shared.player:GetAttribute("CurrentRoom")
            if currentRoomNum then
                for i = #d.currentWaypoints, 1, -1 do
                    if d.currentWaypoints[i].Room and d.currentWaypoints[i].Room < currentRoomNum then
                        table.remove(d.currentWaypoints, i)
                        if d.visualNodes[i] then
                            d.visualNodes[i]:Destroy()
                            table.remove(d.visualNodes, i)
                        end
                    end
                end
                if #d.currentWaypoints == 0 then
                    task.spawn(doPathfinding)
                    return false
                end
            end

            local currentWaypoint = d.currentWaypoints[1]
            if not currentWaypoint then return false end

            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {shared.Character, shared.globals.AUTOHOTEL_NodesFolder}
            rayParams.RespectCanCollide = true
            local ceilRay = workspace:Raycast(currentWaypoint.Position + Vector3.new(0, 5, 0), Vector3.new(0, -6, 0), rayParams)
            if ceilRay and (currentWaypoint.Position.Y - ceilRay.Position.Y > 2.5) then
                createBlockedPoint(currentWaypoint)
                table.remove(d.currentWaypoints, 1)
                if d.visualNodes[1] then
                    d.visualNodes[1]:Destroy()
                    table.remove(d.visualNodes, 1)
                end
                task.spawn(doPathfinding)
                return false
            end

            local distance = (getRootPos() - currentWaypoint.Position).Magnitude
            shared.Humanoid:MoveTo(currentWaypoint.Position)

            local isAtTarget = (#d.currentWaypoints <= 1 and distance < 6)
            if not isAtTarget and not d.isWaitingForDoor then
                if checkStuck(currentWaypoint) then return false end
            end

            if distance < 4 then
                table.remove(d.currentWaypoints, 1)
                if d.visualNodes[1] then
                    d.visualNodes[1]:Destroy()
                    table.remove(d.visualNodes, 1)
                end

                if #d.currentWaypoints == 0 then
                    pcall(function()
                        local finalTarget = getTarget()
                        if finalTarget then
                            local targetPos = getPosOf(finalTarget)
                            local gate = (finalTarget.Name == "KeyObtain" or finalTarget.Name == "ElectricalKeyObtain") and 30 or 15
                            if targetPos and (getRootPos() - targetPos).Magnitude < gate then
                                local roomNum = shared.player:GetAttribute("CurrentRoom")
                                if finalTarget.Name == "Door" then
                                    if finalTarget.Parent and not finalTarget.Parent:GetAttribute("Opened") then
                                        if roomNum == 50 then
                                            d.isWaitingForDoor = true
                                            d.waitStartTime = tick()
                                            local paper = getItem("LibraryHintPaper")
                                            if paper then
                                                local bp = shared.player:FindFirstChildOfClass("Backpack")
                                                local ch = shared.player.Character
                                                if bp and ch then
                                                    paper.Parent = bp
                                                    task.wait(0.05)
                                                    paper.Parent = ch
                                                end
                                            end
                                            local clientOpen = finalTarget.Parent:FindFirstChild("ClientOpen")
                                            if clientOpen then clientOpen:FireServer() end
                                        else
                                            local clientOpen = finalTarget.Parent:FindFirstChild("ClientOpen")
                                            if clientOpen then clientOpen:FireServer() end
                                            d.isWaitingForDoor = true
                                            d.waitStartTime = tick()
                                        end
                                    end
                                elseif tick() - (d.lastPromptFire or 0) > 0.6 then
                                    d.lastPromptFire = tick()
                                    if finalTarget.Name == "LiveHintBook" then
                                        local prompt = finalTarget:FindFirstChild("ActivateEventPrompt")
                                        if prompt then fireproximityprompt(prompt) end
                                    elseif finalTarget.Name == "LibraryHintPaper" then
                                        local prompt = finalTarget:FindFirstChild("ModulePrompt")
                                        if prompt then fireproximityprompt(prompt) end
                                    elseif finalTarget.Name == "KeyObtain" then
                                        local prompt = finalTarget:FindFirstChild("ModulePrompt")
                                        if prompt then fireproximityprompt(prompt) end
                                    elseif finalTarget.Name == "Box" then
                                        local prompt = finalTarget:FindFirstChild("ActivateEventPrompt")
                                        if prompt then fireproximityprompt(prompt) end
                                    elseif finalTarget.Name == "LiveBreakerPolePickup" then
                                        local prompt = finalTarget:FindFirstChildWhichIsA("ProximityPrompt", true)
                                        if prompt then fireproximityprompt(prompt) end
                                    elseif finalTarget.Name == "ElectricalKeyObtain" then
                                        local prompt = finalTarget:FindFirstChild("ModulePrompt")
                                        if prompt then fireproximityprompt(prompt) end
                                    elseif finalTarget.Name == "ElevatorBreaker" then
                                        local prompt = finalTarget:FindFirstChildWhichIsA("ProximityPrompt", true)
                                        if prompt then fireproximityprompt(prompt) end
                                        d.room100Phase = 5
                                    elseif finalTarget.Name == "ElevatorBreakerEmpty" then
                                        local prompt = finalTarget:FindFirstChildWhichIsA("ProximityPrompt", true)
                                        if prompt then fireproximityprompt(prompt) end
                                        d.room100Phase = 5
                                    elseif finalTarget.Name == "Lock" then
                                        if roomNum == 50 then
                                            local paper = getItem("LibraryHintPaper")
                                            if paper then
                                                local bp = shared.player:FindFirstChildOfClass("Backpack")
                                                local ch = shared.player.Character
                                                if bp and ch then
                                                    paper.Parent = bp
                                                    task.wait(0.05)
                                                    paper.Parent = ch
                                                end
                                            end
                                        end
                                        local prompt = finalTarget:FindFirstChild("UnlockPrompt") or finalTarget:FindFirstChild("FakePrompt")
                                        if prompt then fireproximityprompt(prompt) end
                                    end
                                end
                            end
                        end
                    end)
                    return false
                end
            end

            return true
        end

        if Value then
            if shared.connections.AUTOHOTEL_Loop then shared.connections.AUTOHOTEL_Loop:Disconnect() end
            if shared.connections.AUTOHOTEL_Barriers then shared.connections.AUTOHOTEL_Barriers:Disconnect() end
            if shared.connections.AUTOHOTEL_RoomAdded then shared.connections.AUTOHOTEL_RoomAdded:Disconnect() end

            if not shared.globals.AUTOHOTEL_BlockedFolder then
                shared.globals.AUTOHOTEL_BlockedFolder = Instance.new("Folder")
                shared.globals.AUTOHOTEL_BlockedFolder.Name = "_internal_seekhelper_pathfinding_block"
                shared.globals.AUTOHOTEL_BlockedFolder.Parent = workspace
            else
                shared.globals.AUTOHOTEL_BlockedFolder:ClearAllChildren()
            end

            for _, inst in pairs(workspace:GetDescendants()) do
                removeBlacklist(inst)
                handleObstruction(inst)
                handleTriggerEvent(inst)
                handleSpecialDestroy(inst)
                enableWallStripCollision(inst)
            end

            shared.connections.AUTOHOTEL_Barriers = workspace.DescendantAdded:Connect(function(inst)
                removeBlacklist(inst)
                handleObstruction(inst)
                handleTriggerEvent(inst)
                handleSpecialDestroy(inst)
                enableWallStripCollision(inst)
            end)

            shared.connections.AUTOHOTEL_RoomAdded = workspace.CurrentRooms.ChildAdded:Connect(function(newRoom)
                task.wait(0.1)
                local n = tonumber(newRoom.Name)
                if n then
                    local newRawName = newRoom:GetAttribute("RawName")
                    if newRawName == "Hotel_SeekChaseFinal" then
                        d.seekEndRoom = n
                        d.seekFinalRoom = n + 1
                    end
                    if d.isSeekActive or (newRawName and string.find(newRawName, "Seek")) then
                        setRoomQueryable(newRoom, false)
                    end
                    for _, desc in ipairs(newRoom:GetDescendants()) do
                        enableWallStripCollision(desc)
                    end
                    if d.isSeekActive and n > (d.seekStartRoom or 0) then
                        task.spawn(function()
                            task.wait(0.1)
                            if d.isSeekActive then
                                extendPathToNextRoom()
                            end
                        end)
                    end
                    if not d.isSeekActive then
                        if n == 100 then
                            local box = getRoom100Box()
                            if box then
                                task.spawn(extendPath, box)
                            end
                        else
                            local exit = newRoom:FindFirstChild("RoomExit")
                            if not exit then
                                local door = newRoom:FindFirstChild("Door")
                                if door then exit = door:FindFirstChild("Door") or door end
                            end
                            if exit then
                                task.spawn(extendPath, exit)
                            end
                        end
                    end
                end
            end)

            shared.connections.AUTOHOTEL_Loop = game:GetService("RunService").RenderStepped:Connect(function()
                if not shared.Character or not shared.RootPart or not shared.Humanoid then return end
                local ok, err = pcall(function()
                    local currentRoomNum = shared.player:GetAttribute("CurrentRoom")
                    local room = workspace.CurrentRooms:FindFirstChild(tostring(currentRoomNum))
                    local doorModel = room and room:FindFirstChild("Door")
                    local isLocked = room and (room:GetAttribute("RequiresKey") or (doorModel and doorModel:FindFirstChild("Lock")))
                    if isLocked and doorModel and doorModel:GetAttribute("Opened") then
                        isLocked = false
                    end
                    local hasKey = hasItem("Key")
                    local rawName = room and room:GetAttribute("RawName")

                    if not d.idlePos or not d.idleTime or (getRootPos() - d.idlePos).Magnitude > 2.5 then
                        d.idlePos = getRootPos()
                        d.idleTime = tick()
                    elseif not d.isWaitingForDoor and tick() - d.idleTime > 3 then
                        d.idlePos = getRootPos()
                        d.idleTime = tick()
                        if not d.isCalculatingPath then
                            if currentRoomNum ~= 50 and currentRoomNum ~= 100 and d.lastPathFail and tick() - d.lastPathFail < 2 then
                                shared.Humanoid.Jump = true
                            end
                            clearPath()
                            task.spawn(doPathfinding)
                        end
                    end

                    if currentRoomNum and d.blockedRoom ~= currentRoomNum then
                        d.blockedRoom = currentRoomNum
                        if shared.globals.AUTOHOTEL_BlockedFolder then
                            shared.globals.AUTOHOTEL_BlockedFolder:ClearAllChildren()
                        end
                        spotCache = {}
                        blockerCache.room = nil
                        blockerCache.time = 0
                        d.isWaitingForDoor = false
                        for i = #d.currentWaypoints, 1, -1 do
                            if d.currentWaypoints[i].Room and d.currentWaypoints[i].Room < currentRoomNum then
                                table.remove(d.currentWaypoints, i)
                                if d.visualNodes[i] then
                                    d.visualNodes[i]:Destroy()
                                    table.remove(d.visualNodes, i)
                                end
                            end
                        end
                        if room then
                            for _, desc in ipairs(room:GetDescendants()) do
                                enableWallStripCollision(desc)
                            end
                        end
                    end

                    if tick() - (d.rampCleanup or 0) > 1 then
                        d.rampCleanup = tick()
                        for gate, ramps in pairs(shared.globals.AUTOHOTEL_GateRamps) do
                            if not gate or not gate.Parent or not getRoomOf(gate) then
                                for _, ramp in ipairs(ramps) do
                                    if ramp and ramp.Parent then ramp:Destroy() end
                                end
                                shared.globals.AUTOHOTEL_GateRamps[gate] = nil
                            end
                        end
                    end

                    if currentRoomNum == 100 and room and (d.room100Phase or 0) == 0 then
                        if tick() - (d.room100Scan or 0) > 1 then
                            d.room100Scan = tick()
                            local known = {}
                            for _, pole in ipairs(d.room100Poles) do
                                known[pole] = true
                            end
                            for _, desc in pairs(room:GetDescendants()) do
                                if desc.Name == "LiveBreakerPolePickup" and not known[desc] then
                                    table.insert(d.room100Poles, desc)
                                    known[desc] = true
                                end
                            end
                            local elevatorBreaker = room:FindFirstChild("ElevatorBreakerEmpty", true) or room:FindFirstChild("ElevatorBreaker", true)
                            if elevatorBreaker then
                                local pos = getPosOf(elevatorBreaker)
                                if pos then
                                    d.room100BreakerPos = pos
                                end
                            end
                        end
                    end

                    if currentRoomNum == 100 and (d.room100Phase or 0) == 5 then
                        local room100 = workspace.CurrentRooms:FindFirstChild("100")
                        if room100 and room100:FindFirstChild("DoorToBreakDown") then
                            local remotesFolder = game:GetService("ReplicatedStorage"):FindFirstChild("RemotesFolder")
                            if remotesFolder then
                                local ebf = remotesFolder:FindFirstChild("EBF")
                                if ebf then ebf:FireServer() end
                            end
                        else
                            d.room100Phase = 6
                        end
                    end

                    if currentRoomNum == 50 and room and doorModel and not doorModel:GetAttribute("Opened") then
                        if #d.books > 0 then
                            local firstBook = d.books[1]
                            if not firstBook or not firstBook.Parent then
                                if tick() - (d.bookRepath or 0) > 0.4 then
                                    d.bookRepath = tick()
                                    clearPath()
                                    task.spawn(doPathfinding)
                                end
                            else
                                if d.bookTargetRef ~= firstBook then
                                    d.bookTargetRef = firstBook
                                    d.bookTargetSince = tick()
                                end
                                if tick() - d.bookTargetSince > 15 then
                                    d.bookFail[firstBook] = (d.bookFail[firstBook] or 0) + 1
                                    local allFailed = true
                                    for _, b in ipairs(d.books) do
                                        if (d.bookFail[b] or 0) < 2 then
                                            allFailed = false
                                            break
                                        end
                                    end
                                    if allFailed then
                                        d.books = {}
                                    else
                                        table.remove(d.books, 1)
                                        table.insert(d.books, firstBook)
                                    end
                                    d.bookTargetRef = nil
                                    clearPath()
                                    task.spawn(doPathfinding)
                                end
                            end
                        elseif not hasItem("LibraryHintPaper") then
                            if tick() - (d.room50Rescan or 0) > 1.5 then
                                d.room50Rescan = tick()
                                clearPath()
                                task.spawn(doPathfinding)
                            end
                        end
                    end

                    if not d.isSeekActive and rawName == "Hotel_SeekIntro" and workspace:FindFirstChild("SeekMovingNewClone") then
                        d.isSeekActive = true
                        d.seekStartRoom = currentRoomNum or 0
                        d.seekEndRoom = 0
                        d.seekFinalRoom = 0
                        clearPath()
                        for _, seekRoom in pairs(workspace.CurrentRooms:GetChildren()) do
                            if seekRoom:IsA("Model") then
                                local seekRoomNumber = tonumber(seekRoom.Name)
                                if seekRoomNumber then
                                    if seekRoomNumber >= (currentRoomNum or 0) then
                                        setRoomQueryable(seekRoom, false)
                                    end
                                    if seekRoom:GetAttribute("RawName") == "Hotel_SeekChaseFinal" then
                                        d.seekEndRoom = seekRoomNumber
                                        d.seekFinalRoom = seekRoomNumber + 1
                                    end
                                end
                            end
                        end
                        task.spawn(doPathfinding)
                    end

                    if d.isSeekActive then
                        local cloneExists = workspace:FindFirstChild("SeekMovingNewClone") ~= nil
                        local finished = d.seekFinalRoom > 0 and currentRoomNum and currentRoomNum >= d.seekFinalRoom
                        local lost = not cloneExists and not (rawName and string.find(rawName, "Seek"))
                        if finished or lost then
                            d.isSeekActive = false
                            d.seekStartRoom = 0
                            d.seekEndRoom = 0
                            d.seekFinalRoom = 0
                            shared.Humanoid:MoveTo(shared.RootPart.Position)
                            clearPath()
                            task.spawn(doPathfinding)
                        end
                    end

                    if room and room:FindFirstChild("Assets") and room.Assets:FindFirstChild("Gate") then
                        handleGateRamp(room.Assets.Gate)
                    end
                    if currentRoomNum then
                        local nextRoomModel = workspace.CurrentRooms:FindFirstChild(tostring(currentRoomNum + 1))
                        if nextRoomModel and nextRoomModel:FindFirstChild("Assets") and nextRoomModel.Assets:FindFirstChild("Gate") then
                            handleGateRamp(nextRoomModel.Assets.Gate)
                        end
                    end

                    if (currentRoomNum == 50 or currentRoomNum == 100) and room then
                        if not d.figureRig or not d.figureRig.Parent then
                            if tick() - (d.figureScan or 0) > 1 then
                                d.figureScan = tick()
                                d.figureRig = room:FindFirstChild("FigureRig", true) or workspace:FindFirstChild("FigureRig")
                            end
                        end
                        local figure = (d.figureRig and d.figureRig.Parent) and d.figureRig or nil
                        if figure then
                            local figurePos = getPosOf(figure)
                            if figurePos then
                                local blockPart = ensureFigureBlock()
                                blockPart.Position = Vector3.new(figurePos.X, figurePos.Y + 4, figurePos.Z)
                                local distFigure = (getRootPos() - figurePos).Magnitude
                                if distFigure < 10 then
                                    local fleeTarget = computeFleeTarget(figurePos)
                                    if fleeTarget then
                                        if #d.currentWaypoints > 0 then
                                            clearPath()
                                        end
                                        shared.Humanoid:MoveTo(fleeTarget)
                                    end
                                    return
                                end
                                local blocked = false
                                for i = 1, math.min(#d.currentWaypoints, 8) do
                                    if (d.currentWaypoints[i].Position - figurePos).Magnitude < 10 then
                                        blocked = true
                                        break
                                    end
                                end
                                if blocked then
                                    if tick() - (d.figureRepath or 0) > 1 then
                                        d.figureRepath = tick()
                                        clearPath()
                                        task.spawn(doPathfinding)
                                    end
                                    return
                                end
                            end
                        else
                            if figureBlockPart and figureBlockPart.Parent then
                                figureBlockPart:Destroy()
                            end
                            figureBlockPart = nil
                        end
                    end

                    local lockedKeyObtain = isLocked and not hasKey and room and room:FindFirstChild("KeyObtain", true) or nil
                    if lockedKeyObtain then
                        local keyObtain = lockedKeyObtain
                        if keyObtain.Parent.Name == "DrawerContainer" then
                            handleDrawer(keyObtain.Parent)
                        else
                            for drawer, _ in pairs(shared.globals.AUTOHOTEL_DrawerConnections) do
                                disconnectDrawer(drawer)
                            end
                        end

                        local targetPos = getTargetPos(keyObtain)
                        local lastWp = #d.currentWaypoints > 0 and d.currentWaypoints[#d.currentWaypoints].Position
                        if lastWp and targetPos and (lastWp - targetPos).Magnitude > 10 then
                            clearPath()
                        end

                        if #d.currentWaypoints == 0 and not d.isCalculatingPath then
                            task.spawn(doPathfinding)
                        elseif #d.currentWaypoints > 0 then
                            task.spawn(executeWaypointMovement)
                        end
                    else
                        if d.isWaitingForDoor then
                            local waitLimit = d.isSeekActive and 1 or 1.5
                            if doorModel and doorModel:GetAttribute("Opened") then
                                d.isWaitingForDoor = false
                                clearPath()
                                task.spawn(doPathfinding)
                            elseif tick() - d.waitStartTime > waitLimit then
                                d.isWaitingForDoor = false
                                clearPath()
                                task.spawn(doPathfinding)
                            end
                        else
                            if #d.currentWaypoints <= 2 and not d.isCalculatingPath and not d.isSeekActive then
                                local isDoorOpen = doorModel and doorModel:GetAttribute("Opened")
                                if isDoorOpen then
                                    local nextRoomNum = currentRoomNum and currentRoomNum + 1
                                    if nextRoomNum == 100 then
                                        local box = getRoom100Box()
                                        if box then
                                            task.spawn(extendPath, box)
                                        end
                                    else
                                        local nextRoom = nextRoomNum and workspace.CurrentRooms:FindFirstChild(tostring(nextRoomNum))
                                        if nextRoom then
                                            local exit = nextRoom:FindFirstChild("RoomExit")
                                            if not exit then
                                                local nDoor = nextRoom:FindFirstChild("Door")
                                                if nDoor then exit = nDoor:FindFirstChild("Door") or nDoor end
                                            end
                                            if exit then
                                                task.spawn(extendPath, exit)
                                            end
                                        end
                                    end
                                end
                            end

                            if #d.currentWaypoints == 0 then
                                if not d.isCalculatingPath then
                                    task.spawn(doPathfinding)
                                end
                            else
                                task.spawn(executeWaypointMovement)
                            end
                        end
                    end
                end)
                if not ok then
                    warn("[AutoHotel] " .. tostring(err))
                end
            end)
        else
            if shared.connections.AUTOHOTEL_Loop then
                shared.connections.AUTOHOTEL_Loop:Disconnect()
                shared.connections.AUTOHOTEL_Loop = nil
            end
            if shared.connections.AUTOHOTEL_Barriers then
                shared.connections.AUTOHOTEL_Barriers:Disconnect()
                shared.connections.AUTOHOTEL_Barriers = nil
            end
            if shared.connections.AUTOHOTEL_RoomAdded then
                shared.connections.AUTOHOTEL_RoomAdded:Disconnect()
                shared.connections.AUTOHOTEL_RoomAdded = nil
            end
            for drawer, _ in pairs(shared.globals.AUTOHOTEL_DrawerConnections) do
                disconnectDrawer(drawer)
            end
            for lever, _ in pairs(shared.globals.AUTOHOTEL_LeverConnections) do
                disconnectLever(lever)
            end
            for gate, ramps in pairs(shared.globals.AUTOHOTEL_GateRamps) do
                for _, ramp in ipairs(ramps) do
                    if ramp and ramp.Parent then ramp:Destroy() end
                end
            end
            shared.globals.AUTOHOTEL_GateRamps = {}
            if shared.globals.AUTOHOTEL_BlockedFolder then
                shared.globals.AUTOHOTEL_BlockedFolder:ClearAllChildren()
            end
            figureBlockPart = nil
            for id, data in pairs(getgenv().msdoors.storedCrouchBarriers) do
                if data.Object and data.Parent then
                    data.Object.Parent = data.Parent
                end
            end
            getgenv().msdoors.storedCrouchBarriers = {}
            if shared.globals.AUTOHOTEL_TargetPart then
                shared.globals.AUTOHOTEL_TargetPart.Transparency = 1
            end
            d.books = {}
            d.bookFail = {}
            d.bookTargetRef = nil
            d.bookTargetSince = nil
            d.figureRig = nil
            d.room100Phase = 0
            d.room100Poles = {}
            d.room100PhaseTime = nil
            d.room100Scan = nil
            d.room100BreakerPos = nil
            d.room50Rescan = nil
            d.bookRepath = nil
            d.rampCleanup = nil
            clearPath()
            d.isSeekActive = false
            d.isWaitingForDoor = false
            d.seekStartRoom = 0
            d.seekEndRoom = 0
            d.seekFinalRoom = 0
        end
    end
})

