                                else
                                    Part.Size = Vector3.new(10, 2.0, 10)
                                    Part.CFrame = pool:GetPivot() * CFrame.new(0, 0.7, 0)
                                end

                                Part.Parent = room
                                shared.globals.WaterParts[pool] = Part
                            end
                        end
                    end
                end
            end
        else
            for pool, Part in pairs(shared.globals.WaterParts) do
                if Part then
                    Part:Destroy()
                end
                shared.globals.WaterParts[pool] = nil
            end
            table.clear(shared.globals.WaterParts)
        end
    end
})
		
GroupAuto:AddToggle("BringStorageBox", {
    Text = api:getTranslate("Bring StorageBox to Deposits", "Teleportar StorageBox para depósitos"),
    Default = getgenv().msdoors.bringStorageBox,
    Callback = function(Value)
        getgenv().msdoors.bringStorageBox = Value

        if shared.connections.BringStorageBoxConn then
            shared.connections.BringStorageBoxConn:Disconnect()
            shared.connections.BringStorageBoxConn = nil
        end

        if not Value then return end

        if not shared.globals.DROPPEDS then shared.globals.DROPPEDS = {} end
        if not shared.globals.DEPOSIT_INSTANCES then shared.globals.DEPOSIT_INSTANCES = {} end

        local dropsFolder = workspace:FindFirstChild("Drops")
        if dropsFolder then
            for _, item in ipairs(dropsFolder:GetChildren()) do
                if item.Name == "ArchivesStorageBox" and not table.find(shared.globals.DROPPEDS, item) then
                    table.insert(shared.globals.DROPPEDS, item)
                end
            end
        end

        for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
            for _, desc in ipairs(room:GetDescendants()) do
                if desc.Name == "ArchivesPackageDeposit" then
                    local id = desc:GetAttribute("BoxID")
                    if id then
                        if not shared.globals.VALIDBOXS then shared.globals.VALIDBOXS = {} end
                        if not table.find(shared.globals.VALIDBOXS, id) then
                            table.insert(shared.globals.VALIDBOXS, id)
                        end
                        shared.globals.DEPOSIT_INSTANCES[id] = desc
                    end
                end
            end
        end

        shared.connections.BringStorageBoxConn = RunService.Heartbeat:Connect(function()
            if not getgenv().msdoors.bringStorageBox then return end
            if not shared.globals.DROPPEDS then return end

            for i = #shared.globals.DROPPEDS, 1, -1 do
                local box = shared.globals.DROPPEDS[i]
                
                if not box or not box.Parent then
                    table.remove(shared.globals.DROPPEDS, i)
                    continue
                end

                if box.Name == "ArchivesStorageBox" and box:IsA("Model") and box.PrimaryPart then
                    local boxID = box:GetAttribute("Tool_BoxID") or box:GetAttribute("BoxID")
                    
                    if boxID and shared.globals.VALIDBOXS and table.find(shared.globals.VALIDBOXS, boxID) then
                        local targetDeposit = shared.globals.DEPOSIT_INSTANCES[boxID]
                        
                        if targetDeposit and targetDeposit.Parent and targetDeposit.PrimaryPart then
                            local boxPart = box.PrimaryPart
                            local depositPart = targetDeposit.PrimaryPart
                            
                            local targetPos = depositPart.Position + depositPart.CFrame.LookVector * 3 + Vector3.new(0, 2, 0)
                            
                            boxPart.CanCollide = false
                            boxPart.CustomPhysicalProperties = PhysicalProperties.new(0.001, 0, 0, 0, 0)
                            
                            local dir = (targetPos - boxPart.Position)
                            local dist = dir.Magnitude
                            
                            if dist > 1 then
                                boxPart.AssemblyLinearVelocity = dir.Unit * math.min(dist * 30, 100)
                            else
                                boxPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                boxPart.CFrame = CFrame.new(targetPos)
                            end
                        end
                    end
                end
            end
        end)
    end
})
		
