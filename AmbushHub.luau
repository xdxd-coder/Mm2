shared.globals.DRPC.createIsland = function()
    local drpc = shared.globals.DRPC
    if drpc.island or not DYNISLAND then return end
    local s = shared.msdoors
    local ok, inst = pcall(DYNISLAND.new, {
        Lyrics = s.DYNAMICLyrics,
        LyricsInCompact = true,
        ShowIdle = s.DYNAMICShowIdle,
        IdleText = "",
        TopOffset = s.DYNAMICTopOffset,
        NotifyDuration = 4,
        NotifyPlacement = s.DYNAMICCorner,
        Discreet = s.DYNAMICDiscreet,
        DockDelay = s.DYNAMICDockDelay,
    })
    if ok then
        drpc.island = inst
    end
end

shared.globals.DRPC.applyPresence = function(info)
    local d = shared.globals.DRPC
    d.lastPresence = info
    if not d.island then return end
    if not info.listening then
        if d.lastKey ~= "none" then
            d.lastKey = "none"
            d.lastCover = nil
            d.lyricsKey = nil
            pcall(d.island.SetMedia, d.island, d.waitingMedia())
        end
        return
    end
    local playing = info.playing ~= false
    local key = info.key ~= "" and info.key or (info.title .. "|" .. info.artist)
    if key ~= d.lastKey then
        d.lastKey = key
        d.lastCover = info.cover
        pcall(d.island.SetMedia, d.island, {
            Title = info.title,
            Artist = info.artist,
            Cover = info.cover,
            Color = Color3.fromRGB(88, 101, 242),
            Duration = info.duration,
            Position = info.position or 0,
            Playing = playing,
        })
        if d.lyricsKey == info.key and d.lyricsSynced then
            pcall(d.island.SetLyrics, d.island, d.lyricsSynced)
        end
    else
        local data = {
            Position = info.position,
            Duration = info.duration,
            Playing = playing,
        }
        if info.cover and info.cover ~= d.lastCover then
            d.lastCover = info.cover
            data.Cover = info.cover
            data.Title = info.title
            data.Artist = info.artist
        end
        pcall(d.island.UpdateMedia, d.island, data)
    end
end

shared.globals.DRPC.startIsland = function()
    local drpc = shared.globals.DRPC
    drpc.createIsland()
    if not drpc.island then return end
    drpc.island:Show()
    if drpc.lastPresence then
        drpc.applyPresence(drpc.lastPresence)
    else
        pcall(drpc.island.SetMedia, drpc.island, drpc.waitingMedia())
    end
end

shared.globals.DRPC.stopIsland = function()
    local drpc = shared.globals.DRPC
    if drpc.island then
        drpc.island:Hide()
    end
end

shared.globals.DRPC.setSetting = function(key, value)
    local map = {
        Discreet = "DYNAMICDiscreet",
        NotifyPlacement = "DYNAMICCorner",
        ShowIdle = "DYNAMICShowIdle",
        Lyrics = "DYNAMICLyrics",
        TopOffset = "DYNAMICTopOffset",
        DockDelay = "DYNAMICDockDelay",
    }
    shared.msdoors[map[key]] = value
    local island = shared.globals.DRPC.island
    if not island then return end
    if key == "Discreet" then
        pcall(island.SetDiscreet, island, value)
    elseif key == "ShowIdle" then
        island.Config.ShowIdle = value
        pcall(island._retarget, island)
    elseif key == "Lyrics" then
        pcall(island.SetLyricsEnabled, island, value)
    elseif key == "TopOffset" then
        island.Config.TopOffset = value
    elseif key == "DockDelay" then
        island.Config.DockDelay = value
    elseif key == "NotifyPlacement" then
        pcall(island.SetNotifyPlacement, island, value)
    end
end

