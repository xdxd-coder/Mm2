    end,
    ["Light Source Items"] = function(prompt)
        return prompt.Parent:GetAttribute("Tool_LightSource") == true and 
               prompt.Parent:GetAttribute("Tool_CanCutVines") ~= true
    end,
    ["Skull Prompt"] = function(prompt)
