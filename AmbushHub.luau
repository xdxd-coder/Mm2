--[[ SPEED & SPEED BYPASS ]]--..
local VelocitySlider
local BypassMethodDropdown
local SpeedBypassToggle

local SpeedBypassStatus = GroupBypass:AddLabel('<font color=\"rgb(255,0,0)\"><b>...</b></font>')

local function updateSpeeds()
    if not shared.Humanoid then return end
    local walkspeed = getgenv().msdoors.walkspeed or 16
    if getgenv().msdoors.walkspeedEnable then
        if getgenv().msdoors.speedBypassEnable then
            shared.Humanoid.WalkSpeed = walkspeed
        else
            local maxSpeed = getgenv().msdoors.Bypassed and 75 or (getgenv().msdoors.jumpboostEnable and 18 or 22)
            shared.Humanoid.WalkSpeed = 16
        end
    else
        shared.Humanoid.WalkSpeed = 16
    end
end

local function SPEEDBYPASS(method, Enabled)
    if getgenv().msdoors.masslessThread then pcall(task.cancel, getgenv().msdoors.masslessThread) getgenv().msdoors.masslessThread = nil end
    if getgenv().msdoors.slideThread then pcall(task.cancel, getgenv().msdoors.slideThread) getgenv().msdoors.slideThread = nil end
    if getgenv().msdoors.collisionClone and getgenv().msdoors.collisionClone.Parent then
        pcall(function() getgenv().msdoors.collisionClone.Massless = true getgenv().msdoors.collisionClone:Destroy() end)
        getgenv().msdoors.collisionClone = nil
    end
    
    getgenv().msdoors.masslessActive = false
    getgenv().msdoors.slideActive = false
    getgenv().msdoors.speedBypassEnable = Enabled 

    if Enabled then
        local char = shared.Character
        
        if method == "Method 1 (Massless)" or method == "All Methods" then
            getgenv().msdoors.masslessActive = true
            if char then
                local partA = char:FindFirstChild("CollisionPart")
                if partA then
                    local clone = partA:Clone()
                    clone.Name = "_CollisionClone"
                    clone.Massless = true
                    clone.CanCollide = false
                    clone.CanQuery = false
                    clone.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0.7, 0, 1, 1)
                    clone.Parent = char
                    getgenv().msdoors.collisionClone = clone
                    
                    getgenv().msdoors.masslessThread = task.spawn(function()
                        while getgenv().msdoors.masslessActive and clone and clone.Parent do
                            task.wait(0.23)
                            clone.Massless = false
                            task.wait(0.23)
                            local root = char:FindFirstChild("HumanoidRootPart")
                            if root and root.Anchored then
                                clone.Massless = true
                                task.wait(1)
                            end
                            clone.Massless = true
                        end
                        if clone and clone.Parent then clone.Massless = true end
                    end)
                end
            end
        end
        
        if method == "Method 2 (Slide)" or method == "All Methods" then
            getgenv().msdoors.slideActive = true
            local crouchRemote = game.ReplicatedStorage.RemotesFolder.Crouch
            getgenv().msdoors.slideThread = task.spawn(function()
                while getgenv().msdoors.slideActive do
                    task.wait()
                    crouchRemote:FireServer(true, true)
                end
            end)
        end
        
        SpeedBypassStatus:SetText('Speed Bypass: <font color="rgb(0,255,0)"><b>Enabled</b></font>')
        
        if not shared.connections.speedBypassCharAdded then
            shared.connections.speedBypassCharAdded = shared.player.CharacterAdded:Connect(function(newCharacter)
                task.wait(0.1)
                shared.Character = newCharacter
                shared.Humanoid = shared.Character:WaitForChild("Humanoid")
                shared.RootPart = shared.Character:WaitForChild("HumanoidRootPart")
                
                if getgenv().msdoors.speedBypassEnable then
                    SPEEDBYPASS(getgenv().msdoors.bypassMethod, true)
                end
                
                updateSpeeds()
            end)
        end
    else
        SpeedBypassStatus:SetText('Speed Bypass: <font color="rgb(255,0,0)"><b>Disabled</b></font>')
        
        if shared.connections.speedBypassCharAdded then
            shared.connections.speedBypassCharAdded:Disconnect()
            shared.connections.speedBypassCharAdded = nil
        end
    end
    
    updateSpeeds()
end

SpeedBypassToggle = GroupBypass:AddToggle("SpeedBypass", {
