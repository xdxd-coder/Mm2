GroupAuto:AddToggle("AutoCharles", {
    Text = api:getTranslate("Auto Charles", "Auto Charles"),
    Default = getgenv().msdoors.autocharles,
    Callback = function(value)
        getgenv().msdoors.autocharles = value

        for _, name in ipairs({"AutoCharles", "AutoCharlesChild"}) do
            if shared.connections[name] then
                shared.connections[name]:Disconnect()
                shared.connections[name] = nil
            end
        end

        if not value then return end

        local run = 0

        local function isEgg(tool)
            return tostring(tool:GetAttribute("ScannerMode") or ""):lower() == "egg"
        end

        local function onTool(tool)
            if tool.Name ~= "ObjectScanner" then return end

            run += 1
            local id = run

            task.spawn(function()
                local remote = tool:WaitForChild("Remote", 5)
                if not remote then return end

                for _ = 1, 40 do
                    if id ~= run or tool.Parent ~= shared.player.Character then return end
                    if isEgg(tool) then break end
                    remote:FireServer()
                    task.wait(0.3)
                end

                if not isEgg(tool) then
                    warn("Auto Charles: o scanner não chegou no modo Egg")
                    return
                end

                local folder = game:GetService("ReplicatedStorage"):WaitForChild("RemotesFolder", 5)
                local egg = folder and folder:WaitForChild("EggGame", 10)
                local wonRound = egg and egg:WaitForChild("WonRound", 10)
                if not wonRound then
                    -- warn("Auto Charles: WonRound não encontrado")
                    return
                end

                pcall(Notify, {
                    Title = api:getTranslate("Auto Charles", "Auto Charles"),
                    Description = api:getTranslate("Spoofing the Egg levels...", "Falsificando os níveis dos ovos..."),
                    Image = "rbxassetid://6023426923",
                    Color = Color3.fromRGB(255, 200, 0),
                    Duration = 4,
                    NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                })

                pcall(function()
                    wonRound:FireServer(1)
                    task.wait(0.1)
                    wonRound:FireServer(2)
                    task.wait(0.1)
                    wonRound:FireServer(3, true, true)
                end)

                pcall(Notify, {
                    Title = api:getTranslate("Auto Charles", "Auto Charles"),
                    Description = api:getTranslate("Spoofed the Egg levels.", "Níveis dos ovos falsificados."),
                    Image = "rbxassetid://6023426923",
                    Color = Color3.fromRGB(0, 255, 100),
                    Duration = 5,
                    NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                })
            end)
        end

        local function bind(char)
            if shared.connections.AutoCharlesChild then
                shared.connections.AutoCharlesChild:Disconnect()
            end

            local held = char:FindFirstChild("ObjectScanner")
            if held then onTool(held) end

            shared.connections.AutoCharlesChild = char.ChildAdded:Connect(onTool)
        end

        if shared.player.Character then bind(shared.player.Character) end
        shared.connections.AutoCharles = shared.player.CharacterAdded:Connect(bind)
    end
})

