local AutoStemToggle = GroupAntiEntity:AddToggle("AutoStem", {
    Text = api:getTranslate("toggle_antiEntity_autostem", "Auto Stem"),
    Default = getgenv().msdoors.autostem,
    Callback = function(Value)
        getgenv().msdoors.autostem = Value

        if shared.connections.AutoStem then
            for _, conn in pairs(shared.connections.AutoStem) do
                if typeof(conn) == "RBXScriptConnection" then
                    pcall(function() conn:Disconnect() end)
                elseif type(conn) == "thread" then
                    pcall(function() task.cancel(conn) end)
                end
            end
        end
        shared.connections.AutoStem = {}

        if not Value then return end

        local STEM_PARTES = { Nose = true, Mouth = true, Ear = true, Eye = true }
        local STEM_CFG = {
            Velocidade = 100,
            UsarBindableLocal = true,
            Debug = false,
        }

        local stemUltimoIdVisto, stemUltimaParteVista

        local RemotesFolder = ReplicatedStorage:FindFirstChild("RemotesFolder")
        local stemFireProjectileEvent = RemotesFolder and RemotesFolder:FindFirstChild("FireProjectile")
        local stemFireToolProjectile = RemotesFolder and RemotesFolder:FindFirstChild("FireToolProjectile")

        local function obterStem()
            local character = LocalPlayer.Character
            return character and character:FindFirstChild("Stem", true)
        end

        local function verificarStemEquipado()
            return obterStem() ~= nil
        end

        local function obterStemNoInventario()
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            if not bp then return nil end
            return bp:FindFirstChild("Stem", true)
        end

        local function equiparStemDoInventario()
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if not humanoid then return nil end
            if obterStem() then return obterStem() end
            local stemInv = obterStemNoInventario()
            if stemInv then
                pcall(function()
                    humanoid:EquipTool(stemInv)
                end)
                task.wait(0.05)
                return obterStem()
            end
            return nil
        end

        local function getStemPosicao(obj)
            if not obj then return nil end
            if obj:IsA("BasePart") then return obj.Position end
            if obj:IsA("Model") then
                if obj.PrimaryPart then return obj.PrimaryPart.Position end
                return obj:GetPivot().Position
            end
            return nil
        end

        local function ativarStemPrompt(prompt)
            if fireproximityprompt then
                pcall(fireproximityprompt, prompt)
            else
                pcall(function()
                    prompt.HoldDuration = 0
                    prompt:InputHoldBegin()
                    task.wait()
                    prompt:InputHoldEnd()
                end)
            end
        end

        local function origemDoStem(stem)
            local handle
            if stem:IsA("Tool") then
                handle = stem:FindFirstChild("Handle") or stem:FindFirstChildWhichIsA("BasePart", true)
            elseif stem:IsA("BasePart") then
                handle = stem
            else
                handle = stem:FindFirstChildWhichIsA("BasePart", true)
            end
            return handle and handle.Position
        end

        local function stringsStemDe(inst)
            local lista = { inst.Name }
            for _, v in pairs(inst:GetAttributes()) do
                if typeof(v) == "string" then
                    table.insert(lista, v)
                end
            end
            if inst:IsA("StringValue") then
                table.insert(lista, inst.Value)
            end
            return lista
        end

        local function identificarStem(stem)
            local id, parte
            local candidatos = { stem }
            for _, d in ipairs(stem:GetDescendants()) do
                table.insert(candidatos, d)
            end
            for _, inst in ipairs(candidatos) do
                for _, s in ipairs(stringsStemDe(inst)) do
                    if not id and s:match("^Stem_%d+_[%d%.]+$") then id = s end
                    if not parte and STEM_PARTES[s] then parte = s end
                end
            end
            return id or stemUltimoIdVisto, parte or stemUltimaParteVista
        end

        local function lancarStem(stem, character)
            local id, parte = identificarStem(stem)
            id = id or ("Stem_" .. math.random(1, 360) .. "_" .. tick())
            parte = parte or "Nose"

            local direction = Camera.CFrame.LookVector
            local originPos = origemDoStem(stem) or (Camera.CFrame.Position + direction * 2)
            local velocity = direction * STEM_CFG.Velocidade

            if STEM_CFG.UsarBindableLocal and stemFireToolProjectile then
                pcall(function()
                    stemFireToolProjectile:Fire("Stem", parte, originPos, direction, velocity, id)
                end)
            end

            if stemFireProjectileEvent then
                pcall(function()
                    stemFireProjectileEvent:FireServer(
                        id,
                        originPos,
                        direction,
                        velocity,
                        "Stem",
                        parte,
                        { workspace:FindFirstChild("Props"), character }
                    )
                end)
            end
        end

        if stemFireToolProjectile then
            local listenConn
            listenConn = stemFireToolProjectile.Event:Connect(function(nome, parte, _, _, _, id)
                if not getgenv().msdoors.autostem then
                    if listenConn then listenConn:Disconnect() end
                    return
                end
                if nome == "Stem" then
                    stemUltimoIdVisto, stemUltimaParteVista = id, parte
                end
            end)
            table.insert(shared.connections.AutoStem, listenConn)
        end

        local loopThread
        loopThread = task.spawn(function()
            while getgenv().msdoors.autostem do
                local character = LocalPlayer.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")

                if rootPart then
                    local stem = obterStem()

                    if stem then
                        lancarStem(stem, character)

                        local timeout = tick() + 3
                        while getgenv().msdoors.autostem and verificarStemEquipado() and tick() < timeout do
                            task.wait()
                        end
                    else
                        local equipado = equiparStemDoInventario()
                        if equipado then
                            task.wait(0.1)
                        else
                            local liveEntities = workspace:FindFirstChild("LiveEntities")
                            if liveEntities then
                                local found = false
                                local promptRange = getgenv().msdoors.MaxActivationDistance or 10
                                for _, descendant in ipairs(liveEntities:GetDescendants()) do
                                    if not getgenv().msdoors.autostem then break end
                                    if descendant:IsA("ProximityPrompt") and descendant.Enabled then
                                        local parent = descendant.Parent

                                        if parent and string.find(string.lower(parent.Name), "stem") then
                                            local promptPos = getStemPosicao(parent)
                                            if promptPos then
                                                local dist = (rootPart.Position - promptPos).Magnitude
                                                if dist <= promptRange then
                                                    ativarStemPrompt(descendant)
                                                    task.wait(0.1)
                                                    found = true
                                                    break
                                                end
                                            end
                                        end
                                    end
                                end
                                if not found then
                                    task.wait()
                                end
                            else
                                task.wait()
                            end
                        end
                    end
                else
                    task.wait()
                end
            end
        end)
        table.insert(shared.connections.AutoStem, loopThread)
    end
})


