local function GetCachedAsset(filePath)
    if not shared.globals.AUDIO_CACHE then shared.globals.AUDIO_CACHE = {} end
    if shared.globals.AUDIO_CACHE[filePath] then
        return shared.globals.AUDIO_CACHE[filePath]
    end
    
    local assetFunc = getcustomasset or getsynasset
    if assetFunc then
        local success, customId = pcall(assetFunc, filePath)
        if success and customId then
            shared.globals.AUDIO_CACHE[filePath] = customId
            return customId
        end
    end
    return nil
end

local function ProcessAudioQueue()
    if shared.globals.RANDOMSONS.isdownloading then return end
    shared.globals.RANDOMSONS.isdownloading = true
    
    task.spawn(function()
        local folderPath = "msdoors/.cache/audios/"
        if makefolder then pcall(function() makefolder(folderPath) end) end
        
        while #shared.globals.RANDOMSONS.AudioQueue > 0 do
            local item = table.remove(shared.globals.RANDOMSONS.AudioQueue, 1)
            if item and not isfile(item.filePath) then
                local success, audioData = pcall(function() return game:HttpGet(item.url) end)
                if success and audioData then
                    pcall(function() writefile(item.filePath, audioData) end)
                end
            end
            
            if isfile(item.filePath) then
                local customId = GetCachedAsset(item.filePath)
                if customId then
                    local pending = shared.globals.RANDOMSONS.PendingSounds[item.url]
                    if pending then
                        for i = #pending, 1, -1 do
                            local inst = pending[i]
                            if inst and inst.Parent then
                                pcall(function() inst.SoundId = customId end)
                            end
                            table.remove(pending, i)
                        end
                        shared.globals.RANDOMSONS.PendingSounds[item.url] = nil
                    end
                end
            end
            task.wait(0.2)
        end
        shared.globals.RANDOMSONS.isdownloading = false
    end)
end

shared.WHYAREYOURAT = function(inst)
    if typeof(inst) ~= "Instance" or not inst:IsA("Sound") then return end
    if inst:GetAttribute("CALA-BOCA-SEEK") then return end
    if not getgenv().msdoors.KAIOSAVEME then return end

    local currentId = inst.SoundId
    local newId = nil

    pcall(function()
        local entry = getgenv().msdoors.KAIOSAVEME[currentId]
        if entry and type(entry) == "table" and entry.Substituto then
            newId = entry.Substituto
        else
            if not getgenv().msdoors.KAIOSAVEME_KEYS then
                getgenv().msdoors.KAIOSAVEME_KEYS = {}
                for k, v in pairs(getgenv().msdoors.KAIOSAVEME) do
                    if type(v) == "table" and v.Substituto then
                        table.insert(getgenv().msdoors.KAIOSAVEME_KEYS, v.Substituto)
                    end
                end
            end
            if #getgenv().msdoors.KAIOSAVEME_KEYS > 0 then
                newId = getgenv().msdoors.KAIOSAVEME_KEYS[math.random(1, #getgenv().msdoors.KAIOSAVEME_KEYS)]
            end
        end
    end)

    if not newId then return end

    pcall(function()
        inst:SetAttribute("CALA-BOCA-SEEK", currentId)
        shared.globals.SONSAUDIO67[inst] = true
    end)

    if string.sub(newId, 1, 4) == "http" then
        local fileName = string.match(newId, "([^/]+)$") or tostring(math.random(100000, 999999)) .. ".mp3"
        local folderPath = "msdoors/.cache/audios/"
        local filePath = folderPath .. fileName
        
        if isfile(filePath) then
            local customId = GetCachedAsset(filePath)
            if customId and inst and inst.Parent then
                pcall(function() inst.SoundId = customId end)
            end
        else
            if not shared.globals.RANDOMSONS.PendingSounds[newId] then
                shared.globals.RANDOMSONS.PendingSounds[newId] = {}
            end
            table.insert(shared.globals.RANDOMSONS.PendingSounds[newId], inst)
            
            local inQueue = false
            for _, q in ipairs(shared.globals.RANDOMSONS.AudioQueue) do
                if q.url == newId then inQueue = true break end
            end
            if not inQueue then
                table.insert(shared.globals.RANDOMSONS.AudioQueue, {url = newId, filePath = filePath})
                ProcessAudioQueue()
            end
        end
    else
        pcall(function() inst.SoundId = newId end)
    end
end

MenuGroup:AddToggle("DoNotActivateThis", {
    Text = api:getTranslate("Do not activate this", "DO NOT ACTIVATE THIS"),
    Risky = true,
    Default = getgenv().msdoors.donotactivatethis or false,
    Callback = function(Value)
        getgenv().msdoors.donotactivatethis = Value
        
        if Value then
            if not shared.globals.SONSAUDIO67 then
                shared.globals.SONSAUDIO67 = {}
            end
            if not shared.globals.RANDOMSONS then
                shared.globals.RANDOMSONS = {
                    isdownloading = false,
                    AudioQueue = {},
                    PendingSounds = {}
                }
            end
            if not shared.globals.AUDIO_CACHE then
                shared.globals.AUDIO_CACHE = {}
            end
            if not getgenv().msdoors.KAIOSAVEME then
                local success, result = pcall(function()
                    return game:HttpGet("https://raw.githubusercontent.com/Sc-Rhyan57/RandomStuff/refs/heads/main/MSAUDIOS/JSON/PRE-DEFINIDOS.json")
                end)
                if success and result then
                    local parseSuccess, parsed = pcall(function()
                        return HttpService:JSONDecode(result)
                    end)
                    if parseSuccess and type(parsed) == "table" then
                        getgenv().msdoors.KAIOSAVEME = parsed
                    end
                end
            end

            if getgenv().msdoors.KAIOSAVEME then
                for k, v in pairs(getgenv().msdoors.KAIOSAVEME) do
                    if type(v) == "table" and v.Substituto then
                        local subId = v.Substituto
                        if type(subId) == "string" and string.sub(subId, 1, 4) == "http" then
                            local fileName = string.match(subId, "([^/]+)$") or tostring(math.random(100000, 999999)) .. ".mp3"
                            local folderPath = "msdoors/.cache/audios/"
                            local filePath = folderPath .. fileName
                            if not isfile(filePath) then
                                local inQueue = false
                                for _, q in ipairs(shared.globals.RANDOMSONS.AudioQueue) do
                                    if q.url == subId then inQueue = true break end
                                end
                                if not inQueue then
                                    table.insert(shared.globals.RANDOMSONS.AudioQueue, {url = subId, filePath = filePath})
                                end
                            end
                        end
                    end
                end
                ProcessAudioQueue()

                local folders = {workspace, shared.player:FindFirstChild("PlayerGui")}
                for _, folder in ipairs(folders) do
                    if folder then
                        for _, v in pairs(folder:GetDescendants()) do
                            if v:IsA("Sound") then
                                shared.WHYAREYOURAT(v)
                            end
                        end
                    end
                end
            end
        else
            for inst, _ in pairs(shared.globals.SONSAUDIO67) do
                if inst and inst.Parent and inst:GetAttribute("CALA-BOCA-SEEK") then
                    pcall(function()
                        inst.SoundId = inst:GetAttribute("CALA-BOCA-SEEK")
                        inst:SetAttribute("CALA-BOCA-SEEK", nil)
                    end)
                end
            end
            table.clear(shared.globals.SONSAUDIO67)
            table.clear(shared.globals.RANDOMSONS.AudioQueue)
            table.clear(shared.globals.RANDOMSONS.PendingSounds)
            shared.globals.AUDIO_CACHE = {}
        end
    end
})

