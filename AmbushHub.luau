GroupMosca:AddToggle("AutoDepotCandys", {
    Text = api:getTranslate("Auto Depot Candys", "Auto Depositar Doces"),
    Default = getgenv().msdoors.autodepotcandys,
    Callback = function(value)
        getgenv().msdoors.autodepotcandys = value

        if type(shared.globals.CandyDepotQueue) ~= "table" then
            shared.globals.CandyDepotQueue = {}
        end
        shared.globals.CandyDropping = false

        if shared.connections.CandyDepotHeartbeat then
            shared.connections.CandyDepotHeartbeat:Disconnect()
            shared.connections.CandyDepotHeartbeat = nil
        end
        if shared.connections.CandyDepotBackpack then
            shared.connections.CandyDepotBackpack:Disconnect()
            shared.connections.CandyDepotBackpack = nil
        end
        if shared.connections.CandyDepotCharChild then
            shared.connections.CandyDepotCharChild:Disconnect()
            shared.connections.CandyDepotCharChild = nil
        end
        if shared.connections.CandyDepotCharAdded then
            shared.connections.CandyDepotCharAdded:Disconnect()
            shared.connections.CandyDepotCharAdded = nil
        end

        if not value then
            table.clear(shared.globals.CandyDepotQueue)
            shared.globals.CandyDropping = false
            return
        end

        local CANDY = "Candy"
        local TOFARMCANY = {"BrokenHeadstone", "ChocolateCrate", "Haybale", "SmallCauldron", "CandyBucket", "WizardHat", "GiantGummyworm", "LargeCandyBag", "GiantGummyworm", "CandyBasket"}
        local DEPOT = "DepotHalloween" -- Leaked IA prompt soze ozkekkzjwjsjsks FUCK YOU SKIDDER, JUST SKID THIS CODE AND STOP ASKING "THIS IS AI" SHUT UP BRO, WTF 
        local DROP_HEIGHT = 3

        local function isFarmCandy(tool)
            if not tool:IsA("Tool") then return false end
            if tool.Name == CANDY then return true end
            for _, name in ipairs(TOFARMCANY) do
                if tool.Name == name then return true end
            end
            return false
        end

        local function getPos(obj)
            if not obj then return nil end
            if obj:IsA("BasePart") then return obj.Position end
            if obj:IsA("Model") then return obj:GetPivot().Position end
            return nil
        end

        local function nearestDepot()
            local char = shared.player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end
            local best, bestDist = nil, math.huge
            for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
                local assets = room:FindFirstChild("Assets")
                local depot = assets and assets:FindFirstChild(DEPOT)
                local pos = getPos(depot)
                if pos then
                    local dist = (pos - hrp.Position).Magnitude
                    if dist < bestDist then
                        best, bestDist = depot, dist
                    end
                end
            end
            return best
        end

        local function dropCandy(tool)
            local char = shared.player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum or not tool.Parent then return nil end

            if tool.Parent ~= char then
                hum:EquipTool(tool)
                task.wait(0.1)
            end

            local drops = workspace:FindFirstChild("Drops")
            local known = {}
            if drops then
                for _, c in ipairs(drops:GetChildren()) do known[c] = true end
            end

            local RemotesFolder = ReplicatedStorage:FindFirstChild("RemotesFolder")
            if not RemotesFolder then return nil end
            local dropRemote = RemotesFolder:FindFirstChild("DropItem")
            if not dropRemote then return nil end

            pcall(function()
                dropRemote:FireServer(tool)
            end)

            local start = tick()
            while tick() - start < 3 do
                drops = workspace:FindFirstChild("Drops")
                if drops then
                    for _, c in ipairs(drops:GetChildren()) do
                        if not known[c] then return c end
                    end
                end
                task.wait(0.05)
            end
            return nil
        end

        local function processTool(tool)
            if shared.globals.CandyDropping or not getgenv().msdoors.autodepotcandys or not tool or not tool.Parent then return end
            if not isFarmCandy(tool) then return end
            
            shared.globals.CandyDropping = true
            task.spawn(function()
                local depot = nil
                local startWait = tick()
                while getgenv().msdoors.autodepotcandys and tick() - startWait < 10 do
                    depot = nearestDepot()
                    if depot then break end
                    task.wait(0.5)
                end

                if depot and tool.Parent then
                    local dropped = dropCandy(tool)
                    if dropped then
                        table.insert(shared.globals.CandyDepotQueue, { obj = dropped, depot = depot, t = tick() })
                    end
                end
                task.wait(0.1)
                shared.globals.CandyDropping = false
                
                local char = shared.player.Character
                local tools = {}
                if char then
                    for _, t in ipairs(char:GetChildren()) do
                        if isFarmCandy(t) then table.insert(tools, t) end
                    end
                end
                for _, t in ipairs(shared.player.Backpack:GetChildren()) do
                    if isFarmCandy(t) then table.insert(tools, t) end
                end
                if #tools > 0 then
                    processTool(tools[1])
                end
            end)
        end

        shared.connections.CandyDepotHeartbeat = RunService.Heartbeat:Connect(function()
            if not getgenv().msdoors.autodepotcandys then return end
            local queue = shared.globals.CandyDepotQueue
            local i = 1
            while i <= #queue do
                local entry = queue[i]
                local obj, depot = entry.obj, entry.depot
                local depotPos = getPos(depot)
                if not obj.Parent or not depot.Parent or not depotPos or tick() - entry.t > 6 then
                    table.remove(queue, i)
                else
                    pcall(function()
                        if sethiddenproperty then
                            sethiddenproperty(shared.player, "SimulationRadius", math.huge)
                        end
                    end)
                    local target = depotPos + Vector3.new(0, DROP_HEIGHT, 0)
                    local parts = obj:GetDescendants()
                    table.insert(parts, obj)
                    for _, p in ipairs(parts) do
                        if p:IsA("BasePart") and not p.Anchored then
                            p.CanCollide = false
                            p.AssemblyLinearVelocity = (target - p.Position) * 30
                        end
                    end
                    i += 1
                end
            end
        end)

        local function hookChar(char)
            if shared.connections.CandyDepotCharChild then
                shared.connections.CandyDepotCharChild:Disconnect()
            end
            shared.connections.CandyDepotCharChild = char.ChildAdded:Connect(function(child)
                if getgenv().msdoors.autodepotcandys then
                    processTool(child)
                end
            end)
            task.wait(0.5)
            local tools = {}
            for _, t in ipairs(char:GetChildren()) do
                if isFarmCandy(t) then table.insert(tools, t) end
            end
            for _, tool in ipairs(tools) do
                processTool(tool)
            end
        end

        if shared.player.Character then
            hookChar(shared.player.Character)
        end

        shared.connections.CandyDepotCharAdded = shared.player.CharacterAdded:Connect(function(char)
            if getgenv().msdoors.autodepotcandys then
                hookChar(char)
            end
        end)

        shared.connections.CandyDepotBackpack = shared.player.Backpack.ChildAdded:Connect(function(child)
            if getgenv().msdoors.autodepotcandys then
                processTool(child)
            end
        end)

        local initialTools = {}
        for _, t in ipairs(shared.player.Backpack:GetChildren()) do
            if isFarmCandy(t) then table.insert(initialTools, t) end
        end
        for _, tool in ipairs(initialTools) do
            processTool(tool)
        end
    end
})
		
