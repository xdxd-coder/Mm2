local PlayerESPManager = { IsEnabled = false }

function PlayerESPManager:GetPlayerInfo(player)
    if not player or player == shared.player then return nil end
    local health = "0"
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        health = math.floor(player.Character.Humanoid.Health)
    end
    return string.format("%s | %s", player.Name, health)
end

function PlayerESPManager:AddPlayerESP(player)
    if not player or player == shared.player then return end
    if not player.Character or not player.Character.PrimaryPart then return end
    local displayText = self:GetPlayerInfo(player)
    if not displayText then return end
    ESPManager:AddESP(player.Character, displayText, getgenv().msdoors.espsettings.playercolor, "player")
    if not ESPManager.Connections[player.Character] then
        ESPManager.Connections[player.Character] = {}
    end
    if player.Character:FindFirstChild("Humanoid") then
        table.insert(ESPManager.Connections[player.Character],
            player.Character.Humanoid:GetPropertyChangedSignal("Health"):Connect(function()
                if ESPManager.Active[player.Character] then
                    ESPManager:UpdateESP(player.Character, self:GetPlayerInfo(player), nil)
                end
            end)
        )
    end
end

function PlayerESPManager:OnPlayerAdded(player)
    if not self.IsEnabled or player == shared.player then return end
    local function onCharacterAdded(character)
        if not self.IsEnabled then return end
        character:WaitForChild("HumanoidRootPart", 10)
        task.wait(0.1)
        self:AddPlayerESP(player)
    end
    if player.Character then
        onCharacterAdded(player.Character)
    end
    player.CharacterAdded:Connect(onCharacterAdded)
end

function PlayerESPManager:Toggle(state)
    self.IsEnabled = state
    getgenv().msdoors.espsettings.playeresp = state
