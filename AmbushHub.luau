            table.remove(getgenv().msdoors.autointeract.table, i)
        else
            if canInteractWithPrompt(prompt, hrp) then
                if not shouldIgnoreFromList(prompt) and not shouldAlwaysIgnore(prompt) then
                    local skip = false
                    
                    if prompt.Name == "UnlockPrompt" then
                        local lock = prompt.Parent
                        local doorModel = lock and lock.Parent
                        if doorModel and doorModel.Name == "Door" and doorModel:GetAttribute("Opened") == true then
                            skip = true
                        end
                    end
                    
                    local boxModel = prompt.Parent
                    if not boxModel or boxModel.Name ~= "ArchivesStorageBox" then
                        local current = prompt.Parent
                        boxModel = nil
                        while current and current ~= workspace do
                            if current.Name == "ArchivesStorageBox" then
                                boxModel = current
