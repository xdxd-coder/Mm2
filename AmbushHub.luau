shared.globals.DRPC.init = function()
    local drpc = shared.globals.DRPC
    if drpc.initialized then return true end
    if not drpc.ensureRPC() then return false end
    drpc.rpc:SetConfig("NOTIFY", false)
    drpc.rpc:SetConfig("AUTO_CHECK_DC", false)
    drpc.rpc:createRPC({
        OnStatus = function(msg, kind, quiet)
            shared.globals.DCSTATUS:SetText("Status: " .. msg)
            if quiet then return end
            local island = shared.globals.DRPC.island
            if island then
                pcall(island.Notify, island, {
                    Title = "Discord",
                    Text = msg,
                    Type = (kind == "success" and "Success") or (kind == "error" and "Error") or "Info",
                })
            end
        end,
        OnPresence = function(info)
            shared.globals.DRPC.applyPresence(info)
        end,
        OnLogout = function()
            local d = shared.globals.DRPC
            d.lastKey = nil
            d.lastCover = nil
            d.lastPresence = nil
            d.lyricsKey = nil
            d.lyricsSynced = nil
            if shared.globals.DCVerifyButton then
                shared.globals.DCVerifyButton:SetDisabled(false)
            end
            if d.island then
                pcall(d.island.SetMedia, d.island, d.waitingMedia())
            end
        end,
        OnLyrics = function(data)
            local drpc = shared.globals.DRPC
            drpc.lyricsKey = data.key
            drpc.lyricsSynced = data.synced or ""
            if not drpc.island or not drpc.lastPresence then return end
            if drpc.lastPresence.key ~= data.key then return end
            pcall(drpc.island.SetLyrics, drpc.island, drpc.lyricsSynced)
        end,
        Callback = function(username)
            shared.globals.DRPC.onLoggedIn(username)
        end,
    })
    drpc.initialized = true
    return true
end

