--// DEPOT ESP (Stairwell) //--
local function IsDepotObject(obj)
    if not obj or not obj.Parent then return false end
    if obj.Parent.Name ~= "Assets" then return false end
    return obj:FindFirstChild("Grinder1") ~= nil
end

DepotESPManager = { IsActive = false }

function DepotESPManager:GetDepotDisplayText(depot)
    local hasScrap = false
    pcall(function()
        local salvage = depot:FindFirstChild("SalvageScrap")
        if salvage then
            if salvage:IsA("BoolValue") then
                hasScrap = salvage.Value
            elseif salvage:IsA("IntValue") or salvage:IsA("NumberValue") then
                hasScrap = salvage.Value > 0
            else
                hasScrap = true
            end
        end
    end)
    local label = api:getTranslate("esp_objective_depot", "Depot")
    return hasScrap and (label .. " [sucata]") or label
end

function DepotESPManager:IsRelevant(depot)
    local room = depot and depot.Parent and depot.Parent.Parent
    local roomNumber = room and tonumber(room.Name)
    local currentRoom = shared.player:GetAttribute("CurrentRoom")
    return roomNumber ~= nil and currentRoom ~= nil and roomNumber >= currentRoom
end

function DepotESPManager:AddDepotESP(depot)
    if not depot or ESPManager.Active[depot] then return end
    if not self:IsRelevant(depot) then return end

    if depot:IsA("Model") and not depot.PrimaryPart then
        local grinder = depot:FindFirstChild("Grinder1")
        if grinder then
            if grinder:IsA("BasePart") then
                depot.PrimaryPart = grinder
            else
                local part = grinder:FindFirstChildWhichIsA("BasePart", true)
                if part then depot.PrimaryPart = part end
            end
        end
        if not depot.PrimaryPart then
            local part = depot:FindFirstChildWhichIsA("BasePart", true)
            if part then depot.PrimaryPart = part end
        end
    end

    if (depot:IsA("Model") and depot.PrimaryPart) or depot:IsA("BasePart") then
        ESPManager:AddESP(depot, self:GetDepotDisplayText(depot), getgenv().msdoors.espsettings.depotcolor or Color3.fromRGB(255, 165, 0), "depot")
    end
end

function DepotESPManager:UpdateDepotESP(depot)
    if not depot or not depot.Parent then return end
    local espData = ESPManager.Active[depot]
    if not espData or espData.Type ~= "depot" then return end
    ESPManager:UpdateESP(depot, self:GetDepotDisplayText(depot), nil)
end

function DepotESPManager:ScanForDepots()
    if not self.IsActive then return end
    for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
        local assets = room:FindFirstChild("Assets")
        if assets then
            for _, child in ipairs(assets:GetChildren()) do
                if IsDepotObject(child) then
                    self:AddDepotESP(child)
                end
            end
        end
    end
end

function DepotESPManager:Toggle(state)
    self.IsActive = state
    getgenv().msdoors.espsettings.depotesp = state

    if self.RefreshThread then
        task.cancel(self.RefreshThread)
        self.RefreshThread = nil
    end

    if state then
        self:ScanForDepots()
        self.RefreshThread = task.spawn(function()
            while self.IsActive do
                for obj, data in pairs(ESPManager.Active) do
                    if data.Type == "depot" then
                        if not obj.Parent or not self:IsRelevant(obj) then
                            ESPManager:RemoveESP(obj)
                        else
                            local newText = self:GetDepotDisplayText(obj)
                            if newText ~= data.Text then
                                ESPManager:UpdateESP(obj, newText, nil)
                            end
                        end
                    end
                end
                self:ScanForDepots()
                task.wait(0.25)
            end
        end)
    else
        ESPManager:ClearByType("depot")
    end
end


