GroupPlayer:AddToggle("Freecam", {
    Text = api:getTranslate("Freecam", "Câmera Livre"),
    Default = getgenv().msdoors.freecam.enabled,
    Callback = function(Value)
        getgenv().msdoors.freecam.enabled = Value

        if shared.connections.Freecam then
            for _, connection in pairs(shared.connections.Freecam) do
                if connection and typeof(connection) == "RBXScriptConnection" then 
                    pcall(function() connection:Disconnect() end) 
                end
            end
        end
        shared.connections.Freecam = {}

        RunService:UnbindFromRenderStep("Freecam")
        ContextActionService:UnbindAction("FreecamKeyboard")
        ContextActionService:UnbindAction("FreecamMousePan")
        ContextActionService:UnbindAction("FreecamMouseWheel")
        ContextActionService:UnbindAction("FreecamGamepadButton")
        ContextActionService:UnbindAction("FreecamGamepadTrigger")
        ContextActionService:UnbindAction("FreecamGamepadThumbstick")
        ContextActionService:UnbindAction("FreecamTouch")

        local existingGui = shared.player.PlayerGui:FindFirstChild("FreecamMobileGui")
        if existingGui then existingGui:Destroy() end

        local root = shared.player.Character and shared.player.Character:FindFirstChild("HumanoidRootPart")
        if root then root.Anchored = false end

        shared.player.CameraMinZoomDistance = shared.player:GetAttribute("fc_om") or 0.5
        shared.player.CameraMaxZoomDistance = shared.player:GetAttribute("fc_ox") or 128
        shared.camera.CameraType = shared.player:GetAttribute("fc_ct") or Enum.CameraType.Custom
        shared.camera.FieldOfView = shared.player:GetAttribute("fc_fov") or 70
        UserInputService.MouseIconEnabled = true
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default

        if not Value then return end

        local abs = math.abs
        local clamp = math.clamp
        local exp = math.exp
        local rad = math.rad
        local sign = math.sign
        local sqrt = math.sqrt
        local tan = math.tan

        local SpringClass = {}
        SpringClass.__index = SpringClass

        function SpringClass.new(freq, init)
            local self = setmetatable({}, SpringClass)
            self.f = freq
            self.p = init
            self.v = init * 0
            return self
        end

        function SpringClass:Update(dt, target)
            local w = self.f * 2 * math.pi
            local v = self.v
            local d = target - self.p
            local e = exp(-w * dt)
            local newP = target + (v * dt - d * (w * dt + 1)) * e
            self.p = newP
            self.v = (w * dt * (d * w - v) + v) * e
            return newP
        end

        function SpringClass:Reset(val)
            self.p = val
            self.v = val * 0
        end

        local fcPos = Vector3.new()
        local fcAngles = Vector2.new()
        local fcFov = 0
        local fcSpeed = 1

        local springVel = SpringClass.new(1.5, Vector3.new())
        local springPan = SpringClass.new(1, Vector2.new())
        local springFov = SpringClass.new(4, 0)

        local panScale = Vector2.new(0.75, 1) * 8
        local mouseSens = Vector2.new(1, 1) * 0.04908738521234052
        local padSens = Vector2.new(1, 1) * 0.39269908169872414

        local keys = {
            W=0, A=0, S=0, D=0, E=0, Q=0,
            U=0, H=0, J=0, K=0, I=0, Y=0,
            Up=0, Down=0, LeftShift=0, RightShift=0
        }

        local gamepad = {
            ButtonX=0, ButtonY=0, DPadDown=0, DPadUp=0,
            ButtonL2=0, ButtonR2=0,
            Thumbstick1=Vector2.new(), Thumbstick2=Vector2.new()
        }

        local mouse = {
            MouseWheel = 0,
            Delta = Vector2.new()
        }

        local function deadzone(p1)
            return sign(p1) * clamp((exp((abs(p1) - 0.15) / 0.85 * 2) - 1) / (math.exp(2) - 1), 0, 1)
        end

        local function getVelocity(dt)
            fcSpeed = clamp(fcSpeed + dt * (keys.Up - keys.Down) * 0.75, 0.01, 4)
            local pad = Vector3.new(deadzone(gamepad.Thumbstick1.X), deadzone(gamepad.ButtonR2) - deadzone(gamepad.ButtonL2), deadzone(-gamepad.Thumbstick1.Y))
            local kb = Vector3.new(keys.D - keys.A + keys.K - keys.H, keys.E - keys.Q + keys.I - keys.Y, keys.S - keys.W + keys.J - keys.U)
            local speed = getgenv().msdoors.freecam.speed or 64
            local shift = (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) and 0.25 or 1
            return (pad + kb) * (fcSpeed * shift) * (speed / 64)
        end

        local function getPan()
            local padPan = Vector2.new(deadzone(gamepad.Thumbstick2.Y), deadzone(-gamepad.Thumbstick2.X)) * padSens
            local mousePan = mouse.Delta * mouseSens
            mouse.Delta = Vector2.new()
            return padPan + mousePan
        end

        local function getFov()
            local scroll = mouse.MouseWheel
            mouse.MouseWheel = 0
            return (gamepad.ButtonX - gamepad.ButtonY) * 0.25 + scroll
        end

        local function onRenderStep(dt)
            if not getgenv().msdoors.freecam.enabled then return end
            local vel = springVel:Update(dt, getVelocity(dt))
            local pan = springPan:Update(dt, getPan(dt))
            local fovDelta = springFov:Update(dt, getFov(dt))
            local fovScale = sqrt(0.7002075382097097 / tan(rad(fcFov / 2)))
            fcFov = clamp(fcFov + fovDelta * 300 * (dt / fovScale), 1, 120)
            fcAngles = fcAngles + pan * panScale * (dt / fovScale)
            fcAngles = Vector2.new(
                clamp(fcAngles.X, -math.pi / 2, math.pi / 2),
                fcAngles.Y % (math.pi * 2)
            )
            
            local moveCFrame = CFrame.fromOrientation(fcAngles.X, fcAngles.Y, 0)
            local moveVec = vel * Vector3.new(64, 64, 64) * dt
            
            local horizontal = Vector3.new(moveVec.X, 0, moveVec.Z)
            local vertical = Vector3.new(0, moveVec.Y, 0)
            
            fcPos = fcPos + moveCFrame:VectorToWorldSpace(horizontal)
            fcPos = fcPos + vertical
            
            local cf = CFrame.new(fcPos) * moveCFrame
            shared.camera.CFrame = cf
            shared.camera.Focus = cf
            shared.camera.FieldOfView = fcFov
        end

        local High = Enum.ContextActionPriority.High.Value

        ContextActionService:BindActionAtPriority("FreecamKeyboard", function(_, state, input)
            keys[input.KeyCode.Name] = state == Enum.UserInputState.Begin and 1 or 0
            return Enum.ContextActionResult.Sink
        end, false, High,
            Enum.KeyCode.W, Enum.KeyCode.U, Enum.KeyCode.A, Enum.KeyCode.H,
            Enum.KeyCode.S, Enum.KeyCode.J, Enum.KeyCode.D, Enum.KeyCode.K,
            Enum.KeyCode.E, Enum.KeyCode.I, Enum.KeyCode.Q, Enum.KeyCode.Y,
            Enum.KeyCode.Up, Enum.KeyCode.Down
        )

        ContextActionService:BindActionAtPriority("FreecamMousePan", function(_, _, input)
            local d = input.Delta
            mouse.Delta = mouse.Delta + Vector2.new(-d.Y, -d.X)
            return Enum.ContextActionResult.Sink
        end, false, High, Enum.UserInputType.MouseMovement)

        ContextActionService:BindActionAtPriority("FreecamMouseWheel", function(_, _, input)
            mouse[input.UserInputType.Name] = mouse[input.UserInputType.Name] - input.Position.Z
            return Enum.ContextActionResult.Sink
        end, false, High, Enum.UserInputType.MouseWheel)

        ContextActionService:BindActionAtPriority("FreecamGamepadButton", function(_, state, input)
            gamepad[input.KeyCode.Name] = state == Enum.UserInputState.Begin and 1 or 0
            return Enum.ContextActionResult.Sink
        end, false, High, Enum.KeyCode.ButtonX, Enum.KeyCode.ButtonY)

        ContextActionService:BindActionAtPriority("FreecamGamepadTrigger", function(_, _, input)
            gamepad[input.KeyCode.Name] = input.Position.Z
            return Enum.ContextActionResult.Sink
        end, false, High, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonL2)

        ContextActionService:BindActionAtPriority("FreecamGamepadThumbstick", function(_, _, input)
            gamepad[input.KeyCode.Name] = input.Position
            return Enum.ContextActionResult.Sink
        end, false, High, Enum.KeyCode.Thumbstick1, Enum.KeyCode.Thumbstick2)

        local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

        if isMobile then
            local gui = Instance.new("ScreenGui")
            gui.Name = "FreecamMobileGui"
            gui.ResetOnSpawn = false
            gui.DisplayOrder = 10
            gui.IgnoreGuiInset = true
            gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            gui.Parent = shared.player.PlayerGui

            local function makeFrame(name, size, pos, color, alpha, parent)
                local f = Instance.new("Frame")
                f.Name = name
                f.Size = size
                f.Position = pos
                f.BackgroundColor3 = color
                f.BackgroundTransparency = alpha
                f.BorderSizePixel = 0
                f.Parent = parent or gui
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0.5, 0)
                corner.Parent = f
                return f
            end

            local function makeLabel(text, size, pos, parent)
