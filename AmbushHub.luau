--[[ ITEM ESP ]]--
function ItemESPManager:IsInBlacklist(name)
    for _, blacklistedName in ipairs(ITEMESPBLACKLIST) do
        if blacklistedName == name then return true end
    end
    return false
end

function ItemESPManager:GetItemName(item)
    local function searchForPickupProperties(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child.Name == "PickedUpEvent" then
                if child:GetAttribute("Pickup") and child:GetAttribute("CanStack") then
                    return child:GetAttribute("Pickup")
                end
            elseif child:IsA("Folder") or child:IsA("Model") then
                local result = searchForPickupProperties(child)
                if result then return result end
            end
        end
        return nil
    end
    local pickupName = searchForPickupProperties(item)
    if pickupName then return pickupName end
    if item:GetAttribute("Tool_Pickup") then
        return item:GetAttribute("Tool_Pickup")
    end
    for _, child in ipairs(item:GetDescendants()) do
        if child:GetAttribute("Tool_Pickup") then
            return child:GetAttribute("Tool_Pickup")
        end
    end
    
    return item.Name
end

function ItemESPManager:AddItemESP(item)
    if not item then return end
    
    local itemName = self:GetItemName(item)
    
    if itemName == "ArchivesStorageBox" then
        local toolBoxID = item:GetAttribute("Tool_BoxID")
        if not toolBoxID then return end
        
        if shared.globals.VALIDBOXS and table.find(shared.globals.VALIDBOXS, toolBoxID) then
            local displayText = itemName .. " [ID: " .. tostring(toolBoxID) .. "]"
            ESPManager:AddESP(item, displayText, getgenv().msdoors.espsettings.itemcolor, "item")
        end
        return
    end
    
    if self:IsInBlacklist(itemName) then return end
    ESPManager:AddESP(item, itemName, getgenv().msdoors.espsettings.itemcolor, "item")
end

function ItemESPManager:ScanForItems()
    if not self.IsEnabled then return end
    local currentRoomNumber = shared.player:GetAttribute("CurrentRoom")
    if not currentRoomNumber then return end
    local currentRoom = workspace.CurrentRooms:FindFirstChild(tostring(currentRoomNumber))
    if currentRoom then
        local assets = currentRoom:FindFirstChild("Assets")
        if assets then
            for _, descendant in ipairs(assets:GetDescendants()) do
                if descendant:FindFirstChild("PickedUpEvent") or descendant.Name == "ArchivesStorageBox" then
                    if descendant:IsA("Model") and descendant.PrimaryPart or descendant:IsA("Part") then
                        self:AddItemESP(descendant)
                    end
                end
            end
        end
    end
    local drops = workspace:FindFirstChild("Drops")
    if drops then
        for _, descendant in ipairs(drops:GetDescendants()) do
            if descendant:GetAttribute("Tool_Pickup") then
                if descendant:IsA("Model") and descendant.PrimaryPart or descendant:IsA("Part") then
                    self:AddItemESP(descendant)
                end
            end
        end
    end
end

function ItemESPManager:Toggle(state)
    self.IsEnabled = state
    getgenv().msdoors.espsettings.itemesp = state
    if state then
        if not shared.globals.VALIDBOXS then
            shared.globals.VALIDBOXS = {}
        end
        
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name == "ArchivesPackageDeposit" then
                local id = d:GetAttribute("BoxID")
                if id and not table.find(shared.globals.VALIDBOXS, id) then
                    table.insert(shared.globals.VALIDBOXS, id)
                end
            end
        end
        
        self:ScanForItems()
    else
        ESPManager:ClearByType("item")
    end
end

