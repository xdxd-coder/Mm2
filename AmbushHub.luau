                    if getgenv().msdoors.noclip then hrp.CanCollide = false end
                end))
            end

            if collisionPart then
                table.insert(shared.connections.noclip, collisionPart:GetPropertyChangedSignal("CanCollide"):Connect(function()
                    if getgenv().msdoors.noclip then collisionPart.CanCollide = false end
                end))
            end

            table.insert(shared.connections.noclip, game:GetService("RunService").Stepped:Connect(function()
                if not getgenv().msdoors.noclip or not shared.player.Character then return end
                for _, part in pairs(shared.player.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
