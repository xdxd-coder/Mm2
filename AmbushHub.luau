            local INTERVAL = 0.01

            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local RemotesFolder = ReplicatedStorage:WaitForChild("RemotesFolder", 10)
            if not RemotesFolder then return end
            local MinecartPos = RemotesFolder:WaitForChild("MinecartPos", 10)
            local UpdateMinecartNodes = RemotesFolder:WaitForChild("UpdateMinecartNodes", 10)
            if not MinecartPos or not UpdateMinecartNodes then return end

            local function cleanup()
                getgenv().msdoors.minecartteleport.hookActive = false
                getgenv().msdoors.minecartteleport.progressing = false
                getgenv().msdoors.minecartteleport.active = false
                getgenv().msdoors.minecartteleport.rigConnected = false
                getgenv().msdoors.minecartteleport.teleportDone = false
                getgenv().msdoors.minecartteleport.nodeArray = nil
                for _, conn in pairs(shared.connections.minecartteleport) do
                    if conn and conn.Connected then conn:Disconnect() end
                end
                shared.connections.minecartteleport = {}
            end

            local function getMinecartRig()
                return workspace.CurrentCamera and workspace.CurrentCamera:FindFirstChild("MinecartRig")
            end

            local function moveToNode(nodeObj)
                if not nodeObj or not nodeObj._part then return end
                local cf = nodeObj._part.CFrame
                local rig = getMinecartRig()
                if rig then rig:PivotTo(cf) end
                local char = shared.player.Character
                if char and char.PrimaryPart then char:PivotTo(cf) end
            end

            local function deleteFalsePaths(startNode, array)
                if not startNode or not array or #array == 0 then return end
                local realNodes = {}
                for _, nodeObj in ipairs(array) do
                    if nodeObj._part then realNodes[nodeObj._part] = true end
                end
                local part = startNode._part
                if not part then return end
                local folder = part.Parent
                if not folder then return end
                for _, child in ipairs(folder:GetChildren()) do
                    if not realNodes[child] and child:IsA("BasePart") then
                        pcall(function() child:Destroy() end)
                    end
                end
            end

            local function linearizeNodes(array)
                if not array or #array == 0 then return end
                for i = 1, #array - 1 do
                    local current = array[i]
                    local next = array[i + 1]
                    pcall(function()
                        current:_setRightNode(next)
                        current:_setStraightNode(next)
                        current:_setLeftNode(next)
                        current:_setToEndNode(next)
                    end)
                    pcall(function()
                        if current._part then
                            current._part:SetAttribute("MinecartNodeEvent", nil)
                        end
                    end)
                end
                local last = array[#array]
                pcall(function()
                    if last._part then
                        last._part:SetAttribute("MinecartNodeEvent", nil)
                    end
                end)
                print("[MinecartTeleport] Nodes linearized:", #array, "| false paths removed")
            end

            local function saveNodes(buffers, folder, startID)
                local ok, MinecartNodes = pcall(require, ReplicatedStorage.NodeObject.MinecartNodes)
                if not ok or not MinecartNodes then return nil end
                local startNode = MinecartNodes.Decode(buffers, folder, startID)
                if not startNode then return nil end
                local array = startNode:getArrayOfNodeObjectsToTheEnd()
                if not array or #array == 0 then return nil end
                deleteFalsePaths(startNode, array)
                linearizeNodes(array)
                getgenv().msdoors.minecartteleport.roomNodes[folder:GetFullName()] = array
                print("[MinecartTeleport] Room saved:", folder.Name, "|", #array, "nodes")
                return array
            end

            local function startProgression(array)
                if getgenv().msdoors.minecartteleport.progressing then
                    getgenv().msdoors.minecartteleport.progressing = false
                    task.wait(0.05)
                end
                if not array or #array == 0 then return end

                getgenv().msdoors.minecartteleport.nodeArray = array
                getgenv().msdoors.minecartteleport.currentIndex = 1
                getgenv().msdoors.minecartteleport.progressing = true
                getgenv().msdoors.minecartteleport.teleportDone = false

                Notify({
                    Title = api:getTranslate("Minecart Teleport", "Minecart Teleport"),
                    Description = api:getTranslate("The player entered the cart, initiating teleportation...", "The player entered the cart, initiating teleportation..."),
                    Reason = "",
                    Image = "rbxassetid://6023426923",
                    Color = Color3.fromRGB(255, 200, 0),
                    Style = "SYSTEM",
                    Duration = 5,
                    NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                })

                task.spawn(function()
                    while getgenv().msdoors.minecartteleport.progressing and getgenv().msdoors.minecartteleport.enabled and getgenv().msdoors.minecartteleport.currentIndex <= #getgenv().msdoors.minecartteleport.nodeArray do
                        local nodeObj = getgenv().msdoors.minecartteleport.nodeArray[getgenv().msdoors.minecartteleport.currentIndex]
                        if nodeObj and nodeObj._part then
                            moveToNode(nodeObj)
                            getgenv().msdoors.minecartteleport.firingOurs = true
                            pcall(function()
                                MinecartPos:FireServer(nodeObj._part.CFrame)
                            end)
                            getgenv().msdoors.minecartteleport.firingOurs = false
                        end
                        getgenv().msdoors.minecartteleport.currentIndex += 1
                        task.wait(INTERVAL)
                    end
                    getgenv().msdoors.minecartteleport.progressing = false
                    getgenv().msdoors.minecartteleport.teleportDone = true
                    print("[MinecartTeleport] Teleport complete.")
                end)
            end

            table.insert(shared.connections.minecartteleport, UpdateMinecartNodes.OnClientEvent:Connect(function(buffers, folder, startID, isNew)
                task.defer(function()
                    if not getgenv().msdoors.minecartteleport.enabled then return end
                    local array = saveNodes(buffers, folder, startID)
                    if not array then return end
                    if getgenv().msdoors.minecartteleport.active and not getgenv().msdoors.minecartteleport.teleportDone then
                        startProgression(array)
                    end
                end)
            end))

            if not getgenv().msdoors._minecartHooked then
                getgenv().msdoors._minecartHooked = true

                local OldNameCall
                OldNameCall = hookmetamethod(game, "__namecall", function(Self, ...)
                    local Args = {...}
                    local Method = getnamecallmethod()

                    if Method == "FireServer" and Self == MinecartPos and getgenv().msdoors.minecartteleport.hookActive and not getgenv().msdoors.minecartteleport.firingOurs then
                        if not getgenv().msdoors.minecartteleport.nodeArray or getgenv().msdoors.minecartteleport.teleportDone then
                            return OldNameCall(Self, unpack(Args))
                        end
                        if getgenv().msdoors.minecartteleport.progressing then
                            local nodeObj = getgenv().msdoors.minecartteleport.nodeArray[getgenv().msdoors.minecartteleport.currentIndex]
                            if nodeObj and nodeObj._part then
                                Args[1] = nodeObj._part.CFrame
                                moveToNode(nodeObj)
                            end
                        end
                        return OldNameCall(Self, unpack(Args))
                    end

                    return OldNameCall(Self, unpack(Args))
                end)
            end

            local function trySavedNodes()
                local roomNow = tostring(tonumber(tostring(shared.player:GetAttribute("CurrentRoom"))) or 0)
                for key, array in pairs(getgenv().msdoors.minecartteleport.roomNodes) do
                    if key:find(roomNow) then
                        print("[MinecartTeleport] Saved nodes found, starting!")
                        deleteFalsePaths(array[1], array)
                        linearizeNodes(array)
                        startProgression(array)
                        return true
                    end
                end
                return false
            end

            local function onRig(child)
                if child.Name ~= "MinecartRig" then return end
                if getgenv().msdoors.minecartteleport.active then return end

                getgenv().msdoors.minecartteleport.active = true
                getgenv().msdoors.minecartteleport.hookActive = true
                getgenv().msdoors.minecartteleport.rigConnected = true
                getgenv().msdoors.minecartteleport.teleportDone = false

                print("[MinecartTeleport] MinecartRig detected! Room", tonumber(tostring(shared.player:GetAttribute("CurrentRoom"))) or 0)

                if not trySavedNodes() then
                    print("[MinecartTeleport] Waiting for nodes...")
                end
            end

            local cam = workspace.CurrentCamera

            local function connectCam(c)
                if c:FindFirstChild("MinecartRig") then
                    onRig(c:FindFirstChild("MinecartRig"))
                end

                table.insert(shared.connections.minecartteleport, c.ChildAdded:Connect(function(child)
                    if not getgenv().msdoors.minecartteleport.enabled then return end
                    onRig(child)
                end))

                table.insert(shared.connections.minecartteleport, c.ChildRemoved:Connect(function(child)
                    if child.Name ~= "MinecartRig" then return end
                    if not getgenv().msdoors.minecartteleport.rigConnected then return end
                    if c:FindFirstChild("MinecartRig") then return end
                    getgenv().msdoors.minecartteleport.progressing = false
                    getgenv().msdoors.minecartteleport.active = false
                    getgenv().msdoors.minecartteleport.rigConnected = false
                    getgenv().msdoors.minecartteleport.teleportDone = false
                    print("[MinecartTeleport] MinecartRig removed. Reset.")
                end))
            end

            connectCam(cam)

            table.insert(shared.connections.minecartteleport, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
                cam = workspace.CurrentCamera
                if not cam then return end
                connectCam(cam)
            end))

            table.insert(shared.connections.minecartteleport, shared.player:GetAttributeChangedSignal("CurrentRoom"):Connect(function()
                if not getgenv().msdoors.minecartteleport.enabled then return end
                local roomNow = tonumber(tostring(shared.player:GetAttribute("CurrentRoom"))) or 0
                if roomNow >= 50 then
                    Notify({
                        Title = api:getTranslate("Minecart Teleport", "Minecart Teleport"),
                        Description = api:getTranslate("Success!", "Success!"),
                        Reason = "",
                        Image = "rbxassetid://6023426923",
                        Color = Color3.fromRGB(0, 255, 100),
                        Style = "SYSTEM",
                        Duration = 5,
                        NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                    })
                    cleanup()
                    getgenv().msdoors._minecartHooked = false
                    Toggles.MinecartTeleport:SetValue(false)
                end
            end))

        else
            for _, conn in pairs(shared.connections.minecartteleport) do
                if conn and conn.Connected then conn:Disconnect() end
            end
            shared.connections.minecartteleport = {}
            getgenv().msdoors._minecartHooked = false
        end
    end,
})
]]--

GroupAutomation:AddToggle("AutoMinecart", {
    Text = api:getTranslate("Auto Minecart", "Auto Minecart"),
    Default = getgenv().msdoors.autominecart.enabled,
    Callback = function(Value)
        getgenv().msdoors.autominecart.enabled = Value

        if not shared.globals.AutoMinecartData then
            shared.globals.AutoMinecartData = {
                TurnNodes = {},
                DuckBoards = {},
                DoorConnections = {},
                nearestTurnNode = nil,
                ducked = false,
                lastDuck = 0,
                controls = nil,
                originalGetMoveVector = nil
            }
        end

        if shared.connections.AutoMinecartConn then
            for _, c in pairs(shared.connections.AutoMinecartConn) do
                if c then pcall(function() c:Disconnect() end) end
            end
        end
        shared.connections.AutoMinecartConn = {}

        local data = shared.globals.AutoMinecartData

        if data.ducked then
            if shared.maingamerequired then pcall(function() shared.maingamerequired.crouch(false) end) end
            data.ducked = false
        end

        if not Value then
            if data.controls and data.originalGetMoveVector then
                data.controls.GetMoveVector = data.originalGetMoveVector
            end
            return
        end

        if not shared.maingamerequired then
            local ok, result = pcall(function()
                return require(shared.player.PlayerGui:WaitForChild("MainUI", 30).Initiator.Main_Game)
            end)
            if ok then
                shared.maingamerequired = result
            end
        end

        local player = shared.player
        local RunService = game:GetService("RunService")
        local Workspace = workspace

        table.clear(data.TurnNodes)
        table.clear(data.DuckBoards)
        data.DoorConnections = {}
        data.nearestTurnNode = nil
        data.ducked = false
        data.lastDuck = 0

        local function GetMinecart()
            local camera = Workspace.CurrentCamera
            return camera ~= nil and camera:FindFirstChild("MinecartRig") ~= nil
        end

        local function GetNearestTurnNode()
            local nearest, best = nil, math.huge
            for _, node in data.TurnNodes do
                local distance = player:DistanceFromCharacter(node.Position)
                if distance < getgenv().msdoors.autominecart.turndis and distance < best then
                    best = distance
                    nearest = node
                end
            end
            return nearest
        end

        local function GetNearestDuckBoard()
            local nearest, best = nil, math.huge
            for _, board in data.DuckBoards do
                if board.PrimaryPart then
                    local distance = player:DistanceFromCharacter(board.PrimaryPart.Position)
                    if distance < getgenv().msdoors.autominecart.duckdis and distance < best then
                        best = distance
                        nearest = board
                    end
                end
            end
            return nearest
        end

        local function ProcessNodes(nodes)
            local function IsBehind(part1, part2)
                local p1 = (part1.CFrame + part1.CFrame.LookVector).Position
                local p2 = (part1.CFrame + part1.CFrame.LookVector * -1).Position
                return (p1 - part2.Position).Magnitude > (p2 - part2.Position).Magnitude
            end

            local function GetDirection(part1, part2)
                local rightDist = part1.CFrame.RightVector:Dot(part1.Position - part2.Position)
                if rightDist > 0.5 then
                    return IsBehind(part1, part2) and "Right" or "Left"
                end
                if rightDist < -0.5 then
                    return IsBehind(part1, part2) and "Left" or "Right"
                end
                return "Straight"
            end

            local function GetClosestNode(node)
                local best, bestDist = nil, math.huge
                local nodeID = tonumber(node.Name:split("MinecartNode")[2])
                for _, other in nodes:GetChildren() do
                    local otherID = tonumber(other.Name:split("MinecartNode")[2])
                    if other ~= node and otherID and nodeID and otherID > nodeID then
                        local d = (node.Position - other.Position).Magnitude
                        if d < bestDist and other:GetAttribute("DistanceBlacklist") ~= true then
                            bestDist = d
                            best = other
                        end
                    end
                end
                return best
            end

            for _, node in nodes:GetChildren() do
                local nodeID = tonumber(node.Name:split("MinecartNode")[2])
                if node:GetAttribute("DeathType") then
                    node:SetAttribute("DistanceBlacklist", true)
                end
                for i = 1, 20 do
                    local nextNode = nodeID and nodes:FindFirstChild("MinecartNode" .. nodeID + i)
                    if nextNode and nextNode:GetAttribute("DeathType") ~= nil then
                        node:SetAttribute("DistanceBlacklist", true)
                    end
                end
                local prevNode = nodeID and nodes:FindFirstChild("MinecartNode" .. nodeID - 1)
                if prevNode and prevNode:GetAttribute("ForceConnect") then
                    node:SetAttribute("DistanceBlacklist", nil)
                end
                task.wait()
            end

            for _, node in nodes:GetChildren() do
                if node:GetAttribute("ForceConnect") then
                    local nextNode = GetClosestNode(node)
                    if nextNode then
                        node:SetAttribute("Turn", GetDirection(node, nextNode))
                        table.insert(data.TurnNodes, node)
                    end
                end
                task.wait()
            end
        end

        local function addDoor(door)
            if not tonumber(door.Parent.Name) or data.DoorConnections[door] then
                return
            end

            local lastFire = tick()
            local conn
            conn = RunService.Heartbeat:Connect(function()
                if door:FindFirstChild("Door") and door:FindFirstChild("ClientOpen") then
                    if getgenv().msdoors.autominecart.enabled and GetMinecart() then
                        if player:DistanceFromCharacter(door.Door.Position) < 75 and tick() - lastFire > 0.1 then
                            door.ClientOpen:FireServer()
                            lastFire = tick()
                        end
                    end
                end
            end)

            task.spawn(function()
                door:WaitForChild("Door"):WaitForChild("Open").Played:Once(function()
                    conn:Disconnect()
                    data.DoorConnections[door] = nil
                end)
            end)

            data.DoorConnections[door] = conn
        end

        local function HandleObject(object)
            local name = object.Name
            if name == "RunnerNodes" then
                task.spawn(ProcessNodes, object)
            elseif name == "DuckBoard" then
                table.insert(data.DuckBoards, object)
            elseif name == "Door" and object.Parent and tonumber(object.Parent.Name) then
                addDoor(object)
            end
        end

        for _, object in Workspace:GetDescendants() do
            HandleObject(object)
        end

        table.insert(shared.connections.AutoMinecartConn, Workspace.DescendantAdded:Connect(HandleObject))

        local LastClean = tick()
        table.insert(shared.connections.AutoMinecartConn, RunService.Heartbeat:Connect(function()
            if tick() - LastClean <= 0.5 then return end
            LastClean = tick()

            for i = #data.TurnNodes, 1, -1 do
                local node = data.TurnNodes[i]
                if node == nil or not node:IsDescendantOf(Workspace) then
                    table.remove(data.TurnNodes, i)
                end
            end

            for i = #data.DuckBoards, 1, -1 do
                local board = data.DuckBoards[i]
                if board == nil or not board:IsDescendantOf(Workspace) then
                    table.remove(data.DuckBoards, i)
                end
            end
        end))

        local ok, controls = pcall(function()
            return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
        end)
        
        if ok and controls then
            data.controls = controls
            if not data.originalGetMoveVector then
                data.originalGetMoveVector = controls.GetMoveVector
            end
            controls.GetMoveVector = function(...)
                if getgenv().msdoors.autominecart.enabled and shared.info.floor == "Mines" then
                    local node = data.nearestTurnNode
                    if node and GetMinecart() then
                        local turn = node:GetAttribute("Turn")
                        return turn == "Left" and Vector3.new(-1, 0, 0) or turn == "Right" and Vector3.new(1, 0, 0) or Vector3.zero
                    end
                end
                return data.originalGetMoveVector(...)
            end
        end

        table.insert(shared.connections.AutoMinecartConn, RunService.Heartbeat:Connect(function()
            if not getgenv().msdoors.autominecart.enabled or not GetMinecart() or tick() - data.lastDuck < 0.1 then return end
            data.nearestTurnNode = GetNearestTurnNode()

            if not data.ducked and GetNearestDuckBoard() then
                if shared.maingamerequired then shared.maingamerequired.crouch(true) end
                data.ducked = true
            elseif not GetNearestDuckBoard() and data.ducked then
                if shared.maingamerequired then shared.maingamerequired.crouch(false) end
                data.ducked = false
            end
            data.lastDuck = tick()
        end))
    end
})

