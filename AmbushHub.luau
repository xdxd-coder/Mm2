local GuessForgetMeNot = GroupAuto:AddToggle('GuessForgetMeNot', {
    Text = api:getTranslate("Guess ForgetMeNot", "Adivinhar Forget-Me-Not"),
    Default = getgenv().msdoors.guessforgetmenot,
    Callback = function(Value)
        getgenv().msdoors.guessforgetmenot = Value
        
        if shared.connections.guessRoomConn then
            shared.connections.guessRoomConn:Disconnect()
            shared.connections.guessRoomConn = nil
        end
        
        if shared.connections.guessChildConn then
            shared.connections.guessChildConn:Disconnect()
            shared.connections.guessChildConn = nil
        end
        
        if shared.globals.GuessHighlights then
            for _, h in pairs(shared.globals.GuessHighlights) do
                if h and h.Parent then h:Destroy() end
            end
        end
        shared.globals.GuessHighlights = {}
        
        if not Value then 
            if shared.globals.OriginalFmnRoom then
                shared.globals.OriginalFmnRoom:Destroy()
                shared.globals.OriginalFmnRoom = nil
            end
            return 
        end
        
        local guessFolder = workspace:FindFirstChild("GuessForgotMeNot")
        if not guessFolder then
            guessFolder = Instance.new("Folder")
            guessFolder.Name = "GuessForgotMeNot"
            guessFolder.Parent = workspace
        end
        
        local function addHighlight(instance)
            if not instance or not instance.Parent then return end
            if not shared.globals.GuessHighlights then shared.globals.GuessHighlights = {} end
            if instance:IsA("BasePart") then
                local h = Instance.new("Highlight")
                h.FillColor = Color3.fromRGB(255, 0, 0)
                h.OutlineColor = Color3.fromRGB(255, 255, 255)
                h.FillTransparency = 0.5
                h.OutlineTransparency = 0
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = instance
                table.insert(shared.globals.GuessHighlights, h)
            end
        end
        
        local function processPlayerRoom(livePlayerRoom)
            if not livePlayerRoom or not livePlayerRoom.Parent then return end
            if not shared.globals.OriginalFmnRoom then return end
            
            livePlayerRoom:SetAttribute("msdoors_guessing", true)
            
            Notify({
                Title = api:getTranslate("Guess Forget-Me-Not", "Adivinhar Forget-Me-Not"),
                Description = api:getTranslate("Guessing if the room is real or fake... Wait!", "Adivinhando se a sala é real ou falsa... Espere!"),
                Reason = "",
                Image = "rbxassetid://6023426923",
                Color = Color3.fromRGB(255, 200, 0),
                Style = "EVENT",
                Duration = 17,
                NotifyStyle = getgenv().msdoors.LibraryNotifyStyle 
            })
            
            task.wait(0.5)
            
            local playerRoomClone = livePlayerRoom:Clone()
            playerRoomClone:PivotTo(CFrame.new(100, 5000, 0))
            playerRoomClone.Parent = guessFolder
            
            local neg = 0
            local pos = 0
            
            local function compare(orig, clone, liveOrig, liveClone)
                if not orig or not clone then return end
                
                local name = orig.Name
                if name == "BeforeLights" or name == "ForgetMeNotVineDoors" then 
                    return 
                end
                
                if orig.ClassName ~= clone.ClassName then
                    neg = neg + 1
                    if liveClone then addHighlight(liveClone) end
                    return
                end
                
                local diffFound = false
                
                if orig:IsA("BasePart") then
                    if orig.Color ~= clone.Color then diffFound = true end
                    if orig.Material ~= clone.Material then diffFound = true end
                    if orig.Transparency ~= clone.Transparency then diffFound = true end
                    if orig.Size ~= clone.Size then diffFound = true end
                    if orig.Reflectance ~= clone.Reflectance then diffFound = true end
                    if orig.MaterialVariant ~= clone.MaterialVariant then diffFound = true end
                    if orig.CastShadow ~= clone.CastShadow then diffFound = true end
                    if orig.CanCollide ~= clone.CanCollide then diffFound = true end
                    if orig.CanQuery ~= clone.CanQuery then diffFound = true end
                    if orig.CanTouch ~= clone.CanTouch then diffFound = true end
                end
                
                if orig:IsA("MeshPart") then
                    if orig.MeshId ~= clone.MeshId then diffFound = true end
                    if orig.TextureID ~= clone.TextureID then diffFound = true end
                end
                
                if orig:IsA("Decal") or orig:IsA("Texture") then
                    if orig.Texture ~= clone.Texture then diffFound = true end
                    if orig.Color ~= clone.Color then diffFound = true end
                    if orig.Transparency ~= clone.Transparency then diffFound = true end
                    if orig.ZIndex ~= clone.ZIndex then diffFound = true end
                end
                
                if orig:IsA("SurfaceAppearance") then
                    if orig.ColorMap ~= clone.ColorMap then diffFound = true end
                    if orig.NormalMap ~= clone.NormalMap then diffFound = true end
                    if orig.RoughnessMap ~= clone.RoughnessMap then diffFound = true end
                    if orig.MetalnessMap ~= clone.MetalnessMap then diffFound = true end
                end
                
                if orig:IsA("Model") then
                    if orig.PrimaryPart and not clone.PrimaryPart then diffFound = true end
                    if not orig.PrimaryPart and clone.PrimaryPart then diffFound = true end
                end
                
                local origAttrs = orig:GetAttributes()
                local cloneAttrs = clone:GetAttributes()
                for k, v in pairs(origAttrs) do
                    if k ~= "msdoors_guessing" and k ~= "_LoadModuleRan" and k ~= "_ServerEnabled" and k ~= "Hold" then
                        if cloneAttrs[k] ~= v then diffFound = true end
                    end
                end
                for k, v in pairs(cloneAttrs) do
                    if k ~= "msdoors_guessing" and k ~= "_LoadModuleRan" and k ~= "_ServerEnabled" and k ~= "Hold" then
                        if origAttrs[k] == nil then diffFound = true end
                    end
                end
                
                if diffFound then
                    neg = neg + 1
                    if liveClone then addHighlight(liveClone) end
                else
                    if orig:IsA("BasePart") or orig:IsA("Decal") or orig:IsA("Texture") or orig:IsA("SurfaceAppearance") then
                        pos = pos + 1
                    end
                end
                
                local origChildren = orig:GetChildren()
                local cloneChildren = clone:GetChildren()
                
                if #origChildren ~= #cloneChildren then
                    neg = neg + 1
                end
                
                local origByName = {}
                for _, c in ipairs(origChildren) do
                    if c.Name ~= "BeforeLights" and c.Name ~= "ForgetMeNotVineDoors" then
                        origByName[c.Name] = origByName[c.Name] or {}
                        table.insert(origByName[c.Name], c)
                    end
                end
                
                local cloneByName = {}
                for _, c in ipairs(cloneChildren) do
                    if c.Name ~= "BeforeLights" and c.Name ~= "ForgetMeNotVineDoors" then
                        cloneByName[c.Name] = cloneByName[c.Name] or {}
                        table.insert(cloneByName[c.Name], c)
                    end
                end
                
                local liveCloneByName = {}
                if liveClone then
                    for _, c in ipairs(liveClone:GetChildren()) do
                        if c.Name ~= "BeforeLights" and c.Name ~= "ForgetMeNotVineDoors" then
                            liveCloneByName[c.Name] = liveCloneByName[c.Name] or {}
                            table.insert(liveCloneByName[c.Name], c)
                        end
                    end
                end
                
                for name, origList in pairs(origByName) do
                    local cloneList = cloneByName[name] or {}
                    local liveList = liveCloneByName[name] or {}
                    
                    if #origList ~= #cloneList then
                        neg = neg + 1
                    end
                    
                    for i = 1, math.min(#origList, #cloneList) do
                        compare(origList[i], cloneList[i], origList[i], liveList[i])
                    end
                end
            end
            
            compare(shared.globals.OriginalFmnRoom, playerRoomClone, shared.globals.LiveOriginalFmnRoom, livePlayerRoom)
            
            playerRoomClone:Destroy()
            
            local result = ""
            local resultColor = Color3.fromRGB(0, 255, 0)
            if neg > 0 then
                result = api:getTranslate("Go Back! (Fake)", "Volte! (Falsa)")
                resultColor = Color3.fromRGB(255, 0, 0)
            else
                result = api:getTranslate("Go forward! (Real)", "Vá em frente! (Real)")
            end
            
            Notify({
                Title = api:getTranslate("Guess Forget-Me-Not", "Adivinhar Forget-Me-Not"),
                Description = result,
                Reason = "",
                Image = "rbxassetid://6023426923",
                Color = resultColor,
                Style = "EVENT",
                Duration = 17,
                NotifyStyle = getgenv().msdoors.LibraryNotifyStyle 
            })
        end
        
        local function processRoom(room)
            if room:GetAttribute("RawName") == "Archives_ForgetMeNotRoom" then
                if not shared.globals.OriginalFmnRoom then
                    shared.globals.OriginalFmnRoom = room:Clone()
                    shared.globals.OriginalFmnRoom.Name = "OriginalClone"
                    shared.globals.OriginalFmnRoom:PivotTo(CFrame.new(0, 5000, 0))
                    shared.globals.OriginalFmnRoom.Parent = guessFolder
                    shared.globals.LiveOriginalFmnRoom = room
                end
                
                local function onPlayerRoomAdded(playerRoom)
                    if playerRoom.Name == shared.player.Name then
                        if shared.globals.GuessHighlights then
                            for _, h in pairs(shared.globals.GuessHighlights) do
                                if h and h.Parent then h:Destroy() end
                            end
                            shared.globals.GuessHighlights = {}
                        end
                        
                        if not playerRoom:GetAttribute("msdoors_guessing") then
                            task.spawn(processPlayerRoom, playerRoom)
                        end
                    end
                end
                
                local existingPlayerRoom = room:FindFirstChild(shared.player.Name)
                if existingPlayerRoom then
                    onPlayerRoomAdded(existingPlayerRoom)
                end
                
                if shared.connections.guessChildConn then
                    shared.connections.guessChildConn:Disconnect()
                end
                shared.connections.guessChildConn = room.ChildAdded:Connect(function(child)
                    onPlayerRoomAdded(child)
                end)
            end
        end
        
        for _, room in pairs(workspace.CurrentRooms:GetChildren()) do
            processRoom(room)
        end
        
        shared.connections.guessRoomConn = workspace.CurrentRooms.ChildAdded:Connect(processRoom)
    end
})

