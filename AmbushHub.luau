AutoBreakerToggle:OnChanged(function(Value)    
    getgenv().msdoors.autobreakerbox.enabled = Value
    local autoBreakerData = getgenv().msdoors.autobreakerbox
    
    local function cleanupConnections()
        if shared.connections.autoBreakerRoomAdded then
            shared.connections.autoBreakerRoomAdded:Disconnect()
            shared.connections.autoBreakerRoomAdded = nil
        end
        if shared.connections.autoBreakerRoomChanged then
            shared.connections.autoBreakerRoomChanged:Disconnect()
            shared.connections.autoBreakerRoomChanged = nil
        end
        if shared.connections.autoBreakerDescendantAdded then
            shared.connections.autoBreakerDescendantAdded:Disconnect()
            shared.connections.autoBreakerDescendantAdded = nil
        end
        if shared.connections.autoBreakerReset then
            shared.connections.autoBreakerReset:Disconnect()
            shared.connections.autoBreakerReset = nil
        end
        if shared.connections.autoBreakerCode then
            shared.connections.autoBreakerCode:Disconnect()
            shared.connections.autoBreakerCode = nil
        end
        if shared.connections.autoBreakerExploit then
            shared.connections.autoBreakerExploit:Disconnect()
            shared.connections.autoBreakerExploit = nil
        end
        autoBreakerData.isProcessing = false
    end
    
    local function enableBreaker(breaker, value)
        if not breaker or not autoBreakerData.enabled then return end
        
        breaker:SetAttribute("Enabled", value)
        local constraint = breaker:FindFirstChild("PrismaticConstraint", true)
        
        if constraint then
            if value then
                constraint.TargetPosition = -0.2
                breaker.Light.Material = Enum.Material.Neon
                breaker.Light.Attachment.Spark:Emit(1)
                breaker.Sound.Pitch = 1.3
            else
                constraint.TargetPosition = 0.2
                breaker.Light.Material = Enum.Material.Glass
                breaker.Sound.Pitch = 1.2
            end
            
            breaker.Sound:Play()
        end
    end
    
    local function processBreaker(code, breakers)
        if not autoBreakerData.enabled or autoBreakerData.method ~= "Legit" then return end
        
        local newCode = code.Text
        if not tonumber(newCode) and newCode ~= "??" then return end
        
        local isEnabled = code.Frame and code.Frame.BackgroundTransparency == 0
        local breaker = breakers[newCode]
        
        if newCode == "??" and #autoBreakerData.usedbreakers == 9 then
            for i = 1, 10 do
                local id = string.format("%02d", i)
                if not table.find(autoBreakerData.usedbreakers, id) and breakers[id] then
                    breaker = breakers[id]
                    break
                end
            end
        end
        
        if breaker then
            table.insert(autoBreakerData.usedbreakers, newCode)
            if breaker:GetAttribute("Enabled") ~= isEnabled then
                enableBreaker(breaker, isEnabled)
            end
        end
    end
    
    local function solveBreakerBox(breakerBox)
        if not autoBreakerData.enabled or not breakerBox or autoBreakerData.isProcessing then return end
        
        autoBreakerData.isProcessing = true
        autoBreakerData.currentBreaker = breakerBox
        
        local code = breakerBox:FindFirstChild("Code", true)
        local correct = breakerBox:FindFirstChild("Correct", true)
        
        if not code or not correct then
            autoBreakerData.isProcessing = false
            return
        end
        
        repeat 
            task.wait(0.05) 
        until code.Text ~= "..." or not breakerBox:IsDescendantOf(workspace) or not autoBreakerData.enabled
        
        if not breakerBox:IsDescendantOf(workspace) or not autoBreakerData.enabled then
            autoBreakerData.isProcessing = false
            return
        end
        
        if autoBreakerData.method == "Exploit" then
            if IsDoorsHardcore then
                pcall(function()
                        game:GetService("ReplicatedStorage").RemotesFolder.EBF:FireServer()
                end)
                pcall(function()
                    if shared.info and shared.info.floor == "Super Hard Mode" then
                        game:GetService("ReplicatedStorage").EntityInfo.EBF:FireServer()
                    end
                end)
                autoBreakerData.isProcessing = false
                Notify({
                    Title = api:getTranslate("notify_autobreakerbox", "Disjuntor Automático"),
                    Description = api:getTranslate("notify_autobreakerbox_complete", "Caixa de disjuntores resolvida com sucesso!"),
                    Reason = "",
                    Color = Color3.fromRGB(0, 255, 0),
                    Style = "SYSTEM",
                    Duration = 3,
                    NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                })
            else
                shared.connections.autoBreakerExploit = game:GetService("RunService").RenderStepped:Connect(function()
                    if not autoBreakerData.enabled or not autoBreakerData.isProcessing then
                        if shared.connections.autoBreakerExploit then
                            shared.connections.autoBreakerExploit:Disconnect()
                            shared.connections.autoBreakerExploit = nil
                        end
                        return
                    end
                    
                    pcall(function()
                        game:GetService("ReplicatedStorage").RemotesFolder.EBF:FireServer()
                    end)
                    
                    pcall(function()
                        if shared.info and shared.info.floor == "Super Hard Mode" then
                            game:GetService("ReplicatedStorage").EntityInfo.EBF:FireServer()
                        end
                    end)
                    
                    if not workspace.CurrentRooms:FindFirstChild("100") or not workspace.CurrentRooms["100"]:FindFirstChild("DoorToBreakDown") then
                        if shared.connections.autoBreakerExploit then
                            shared.connections.autoBreakerExploit:Disconnect()
                            shared.connections.autoBreakerExploit = nil
                        end
                        autoBreakerData.isProcessing = false
                        Notify({
                            Title = api:getTranslate("notify_autobreakerbox", "Disjuntor Automático"),
                            Description = api:getTranslate("notify_autobreakerbox_complete", "Caixa de disjuntores resolvida com sucesso!"),
                            Reason = "",
                            Color = Color3.fromRGB(0, 255, 0),
                            Style = "SYSTEM",
                            Duration = 3,
                            NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                        })
                    end
                end)
            end
        else
            Notify({
               Title = api:getTranslate("notify_autobreakerbox", "Disjuntor Automático"),
               Description = api:getTranslate("notify_autobreakerbox_solving", "Resolvendo o problema da caixa de disjuntores..."),
               Reason = "",
               Color = Color3.fromRGB(255, 0, 0),
               Style = "SYSTEM",
               Duration = 6,
               NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
            })
            
            autoBreakerData.usedbreakers = {}
            
            local breakers = {}
            for _, breaker in pairs(breakerBox:GetChildren()) do
                if breaker.Name == "BreakerSwitch" then
                    local id = string.format("%02d", breaker:GetAttribute("ID"))
                    breakers[id] = breaker
                end
            end
            
            if code:FindFirstChild("Frame") then
                processBreaker(code, breakers)
                
                shared.connections.autoBreakerReset = correct:GetPropertyChangedSignal("Playing"):Connect(function()
                    if correct.Playing then
                        table.clear(autoBreakerData.usedbreakers)
                    end
                end)
                
                shared.connections.autoBreakerCode = code:GetPropertyChangedSignal("Text"):Connect(function()
                    if autoBreakerData.enabled then
                        task.delay(0.1, processBreaker, code, breakers)
                    else
                        cleanupConnections()
                    end
                end)
            end
        end
        
        if autoBreakerData.method ~= "Exploit" then
            autoBreakerData.isProcessing = false
        end
    end
    
    if Value then
        cleanupConnections()
        
        local function checkExistingBreaker()
            local existingBreaker = workspace.CurrentRooms:FindFirstChild("ElevatorBreaker", true)
            if not existingBreaker and workspace.CurrentRooms:FindFirstChild("100") then
                existingBreaker = workspace.CurrentRooms["100"]:FindFirstChild("ElevatorBreaker", true)
            end
            
            if existingBreaker then
                task.spawn(function()
                    solveBreakerBox(existingBreaker)
                end)
            end
        end
        
        checkExistingBreaker()
        
        shared.connections.autoBreakerRoomAdded = workspace.CurrentRooms.ChildAdded:Connect(function(room)
            if not autoBreakerData.enabled then
                cleanupConnections()
                return
            end
            
            task.spawn(function()
                task.wait(0.1)
                
                local elevatorBreaker = room:FindFirstChild("ElevatorBreaker", true)
                if elevatorBreaker then
                    solveBreakerBox(elevatorBreaker)
                else
                    local connection
                    connection = room.DescendantAdded:Connect(function(child)
                        if child.Name == "ElevatorBreaker" and autoBreakerData.enabled and not autoBreakerData.isProcessing then
                            connection:Disconnect()
                            task.spawn(function()
                                solveBreakerBox(child)
                            end)
                        end
                    end)
                    
                    task.delay(30, function()
                        if connection and connection.Connected then
                            connection:Disconnect()
                        end
                    end)
                end
            end)
        end)
        
        shared.connections.autoBreakerRoomChanged = workspace.CurrentRooms.ChildRemoved:Connect(function()
            if shared.connections.autoBreakerReset then
                shared.connections.autoBreakerReset:Disconnect()
                shared.connections.autoBreakerReset = nil
            end
            if shared.connections.autoBreakerCode then
                shared.connections.autoBreakerCode:Disconnect()
                shared.connections.autoBreakerCode = nil
            end
            autoBreakerData.usedbreakers = {}
            autoBreakerData.isProcessing = false
        end)
        
        shared.connections.autoBreakerDescendantAdded = workspace.CurrentRooms.DescendantAdded:Connect(function(descendant)
            if descendant.Name == "ElevatorBreaker" and autoBreakerData.enabled and not autoBreakerData.isProcessing then
                task.spawn(function()
                    print(" AmbushHub is cooking breakers ")
                    solveBreakerBox(descendant)
                end)
            end
        end)
        
    else
        cleanupConnections()
    end
end)
	
else
print(" AUTO BREAKER BOX DISABLED. ")
end

