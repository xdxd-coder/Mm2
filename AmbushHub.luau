local Showeyestalkpath = GroupHotel:AddToggle("Showeyestalkpath", {
    Text = api:getTranslate("Show Eyestalk Path", "Show Eyestalk Path"),
    Default = getgenv().msdoors.showeyestalkpath.enabled,
})

Showeyestalkpath:OnChanged(function(state)
    getgenv().msdoors = getgenv().msdoors or {}
    getgenv().msdoors.showeyestalkpath = getgenv().msdoors.showeyestalkpath or {}
    getgenv().msdoors.showeyestalkpath.enabled = state
    getgenv().msdoors.showeyestalkpath.conncs = getgenv().msdoors.showeyestalkpath.conncs or {}
    getgenv().msdoors.showeyestalkpath.beams = getgenv().msdoors.showeyestalkpath.beams or {}
    getgenv().msdoors.showeyestalkpath.nodes = getgenv().msdoors.showeyestalkpath.nodes or {}

    local function cleanup()
        for _, conn in pairs(getgenv().msdoors.showeyestalkpath.conncs) do
            conn:Disconnect()
        end

        for _, beamData in pairs(getgenv().msdoors.showeyestalkpath.beams) do
            if beamData.beam then beamData.beam:Destroy() end
            if beamData.part0 then beamData.part0:Destroy() end
            if beamData.part1 then beamData.part1:Destroy() end
        end

        for _, node in pairs(getgenv().msdoors.showeyestalkpath.nodes) do
            if node.part then node.part:Destroy() end
        end

        getgenv().msdoors.showeyestalkpath.beams = {}
        getgenv().msdoors.showeyestalkpath.conncs = {}
        getgenv().msdoors.showeyestalkpath.nodes = {}
    end

    if state then
        local function createBeamBetweenPoints(startPos, endPos, color, toggleValue)
            local beam = Instance.new("Beam")
            local att0 = Instance.new("Attachment")
            local att1 = Instance.new("Attachment")
            
            local part0 = Instance.new("Part")
            part0.Anchored = true
            part0.CanCollide = false
            part0.Transparency = 1
            part0.Size = Vector3.new(0.1, 0.1, 0.1)
            part0.CFrame = CFrame.new(startPos)
            part0.Parent = workspace
            
            local part1 = Instance.new("Part")
            part1.Anchored = true
            part1.CanCollide = false
            part1.Transparency = 1
            part1.Size = Vector3.new(0.1, 0.1, 0.1)
            part1.CFrame = CFrame.new(endPos)
            part1.Parent = workspace
            
            att0.Parent = part0
            att1.Parent = part1
            
            beam.Attachment0 = att0
            beam.Attachment1 = att1
            beam.Color = ColorSequence.new(color)
            beam.Width0 = 0.8
            beam.Width1 = 0.8
            beam.FaceCamera = true
            beam.Transparency = NumberSequence.new(toggleValue and 0 or 1)
            beam.LightEmission = 0.5
            beam.LightInfluence = 0
            beam.Brightness = 10
            beam.CurveSize0 = 0
            beam.CurveSize1 = 0
            beam.Segments = 10
            beam.Parent = part0
            
            return {beam = beam, part0 = part0, part1 = part1, att0 = att0, att1 = att1}
        end
        
        local function processEyestalkRoom(room)
            if not getgenv().msdoors.showeyestalkpath.enabled then return end
            
            if room:GetAttribute("RawName") and string.find(room:GetAttribute("RawName"), "Eyestalk") then
                local previousNode = nil
                
                local function createEyestalkNode(waypointPos)
                    local elevatedPos = waypointPos + Vector3.new(0, 1.5, 0)
                    local nodeData = {
                        startPos = elevatedPos,
                        part = Instance.new("Part")
                    }
                    nodeData.part.Anchored = true
                    nodeData.part.CanCollide = false
                    nodeData.part.Transparency = 1
                    nodeData.part.Size = Vector3.new(0.1, 0.1, 0.1)
                    nodeData.part.CFrame = CFrame.new(elevatedPos)
                    nodeData.part.Parent = workspace
                    
                    table.insert(getgenv().msdoors.showeyestalkpath.nodes, nodeData)
                    
                    if previousNode then
                        local beamData = createBeamBetweenPoints(previousNode.startPos, elevatedPos, Color3.fromRGB(0, 255, 0), true)
                        table.insert(getgenv().msdoors.showeyestalkpath.beams, beamData)
                    end
                    previousNode = nodeData
                end
                
                room:WaitForChild("RoomEntrance", 9e9)
                room:WaitForChild("RoomExit", 9e9)
                
                while not room:GetAttribute("PathFound") do
                    if getgenv().msdoors.showeyestalkpath.enabled then
                        local eyePath = game:GetService("PathfindingService"):CreatePath({
                            AgentCanJump = false, AgentCanClimb = false, WaypointSpacing = 2, AgentRadius = 1, AgentHeight = 1
                        })
                        local rootPart = shared.player.Character and shared.player.Character:FindFirstChild("HumanoidRootPart")
                        if rootPart and room.RoomExit then
                            eyePath:ComputeAsync(rootPart.Position, room.RoomExit.Position)
                            if eyePath.Status == Enum.PathStatus.Success then
                                room:SetAttribute("PathFound", true)
                                for _, waypoint in eyePath:GetWaypoints() do
                                    createEyestalkNode(waypoint.Position)
                                    task.wait()
                                end
                                break
                            end
                        end
                    end
                    task.wait(0.25)
                end
            end
        end
        
        local function monitorRooms()
            for _, child in pairs(workspace.CurrentRooms:GetChildren()) do
                task.spawn(processEyestalkRoom, child)
            end
            
            table.insert(getgenv().msdoors.showeyestalkpath.conncs, workspace.CurrentRooms.ChildAdded:Connect(function(child)
                if getgenv().msdoors.showeyestalkpath.enabled then
                    task.spawn(processEyestalkRoom, child)
                end
            end))
        end
        
        if workspace:FindFirstChild("CurrentRooms") then
            monitorRooms()
        else
            table.insert(getgenv().msdoors.showeyestalkpath.conncs, workspace.ChildAdded:Connect(function(child)
                if child.Name == "CurrentRooms" and getgenv().msdoors.showeyestalkpath.enabled then
                    monitorRooms()
                end
            end))
        end
    else
        cleanup()
    end
end)

		
