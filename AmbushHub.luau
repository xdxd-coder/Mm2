local data = getgenv().msdoors.autorooms_data

AutoroomsToggle:OnChanged(function(value)
    data.enable = value

    if value then
        local pathService = game:GetService("PathfindingService")
        local currentRooms = workspace:WaitForChild("CurrentRooms")
        local latestRoom = game.ReplicatedStorage:WaitForChild("GameData"):WaitForChild("LatestRoom")
        local remotesFolder = game.ReplicatedStorage:WaitForChild("RemotesFolder")
        local camLock = remotesFolder:WaitForChild("CamLock")
        
        local RoomsEntityList = { "RushMoving", "AmbushMoving", "BackdoorRush", "A60", "A120", "CustomEntity", "GlitchRush", "GlitchAmbush" }
        
        local function notify(msg, t, dur)
            if data.debug and NotifyToggle.Value and shared.loaded then
                Notify({
                    Title = "Auto Rooms [DEBUG]",
                    Description = msg,
                    Reason = t or "",
                    Image = "rbxassetid://6023426923",
                    Color = Color3.fromRGB(0, 162, 255),
                    Style = "EVENT",
                    Duration = dur or 4,
                    NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                })
            end
        end

        if data.blockFolder then
            pcall(function() data.blockFolder:Destroy() end)
        end
        data.blockFolder = Instance.new("Folder", workspace)
        data.blockFolder.Name = "_internal_autorooms_block"

        local function clearNodes()
            if data.nodes then
                for _, node in pairs(data.nodes) do
                    if node and node.Parent then
                        pcall(function() node:Destroy() end)
                    end
                end
            end
            data.nodes = {}
        end

        local function addNode(pos)
            if not data.shownodes then return end
            local node = Instance.new("Part")
            node.Anchored = true
            node.CanCollide = false
            node.Transparency = 0.5
            node.Size = Vector3.new(0.5, 0.5, 0.5)
            node.Position = pos + Vector3.new(0, 1.5, 0)
            node.Color = Color3.fromRGB(0, 162, 255)
            node.Material = Enum.Material.Neon
            node.Parent = workspace
            table.insert(data.nodes, node)
        end

        local function createBlockedPoint(point)
            local block = Instance.new("Part", data.blockFolder)
            local pathMod = Instance.new("PathfindingModifier", block)
            pathMod.Label = "_autorooms_pathBlock"
            block.Name = "_autorooms_blocked_path"
            block.Shape = Enum.PartType.Block
            block.Size = Vector3.new(2, 15, 2)
            block.Color = Color3.fromRGB(255, 100, 0)
            block.Material = Enum.Material.Neon
            block.Position = point.Position + Vector3.new(0, 7.5, 0)
            block.Anchored = true
            block.CanCollide = false
            block.Transparency = data.shownodes and 0.9 or 1
        end

        local function getNearestLocker()
            local char = shared.player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return nil end
            local nearest = { Distance = math.huge, Object = nil }
            for _, room in ipairs(currentRooms:GetChildren()) do
                local roomNumber = tonumber(room.Name)
                if roomNumber and roomNumber >= (latestRoom.Value - 2) then
                    for _, locker in ipairs(room:GetDescendants()) do
                        if locker.Name == "Locker_Large" or locker.Name == "Rooms_Locker" or locker.Name == "Rooms_Locker_Fridge" then
                            local prompt = locker:FindFirstChild("HidePrompt")
                            local hiddenPlayer = locker:FindFirstChild("HiddenPlayer")
                            if prompt and hiddenPlayer and not hiddenPlayer.Value and locker.PrimaryPart then
                                local dist = (locker.PrimaryPart.Position - root.Position).Magnitude
                                if dist < nearest.Distance and locker.PrimaryPart.Position.Y > -10 then
                                    nearest.Distance = dist
                                    nearest.Object = locker
                                end
                            end
                        end
                    end
                end
            end
            return nearest.Object
        end

        local function getAction()
            for _, entityName in ipairs(RoomsEntityList) do
                local entity = workspace:FindFirstChild(entityName)
                if entity and entity.PrimaryPart and entity.PrimaryPart.Position.Y > -10 then
                    if entityName == "A60" and getgenv().msdoors.GodmodeEnable then
                        continue
                    end
                    return "locker"
                end
            end
            return "door"
        end

        local function getTarget()
            local char = shared.player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return nil end
            local room = currentRooms:FindFirstChild(tostring(latestRoom.Value))
            if not room then return nil end

            local action = getAction()

            if action == "locker" then
                local locker = getNearestLocker()
                if locker then
                    return locker
                end
            end

            if data.prioritizeRarities then
                for _, obj in ipairs(currentRooms:GetDescendants()) do
                    if obj.Name == "StardustPickup" or obj.Name == "Stardust Pile" or obj.Name == "GoldPile" then
                        local objPos = (obj:IsA("Model") and obj.PrimaryPart and obj.PrimaryPart.Position) or (obj:IsA("BasePart") and obj.Position)
                        if objPos and (root.Position - objPos).Magnitude < 200 then
                            return obj
                        end
                    end
                end
            end

            local door1 = room:FindFirstChild("Door")
            if door1 then
                local doorPart = door1:FindFirstChild("Door")
                if doorPart and doorPart:IsA("BasePart") then
                    doorPart.CanCollide = false
                end
                return door1
            end
            return nil
        end

        local function clearPath()
            data.currentWaypoints = {}
            data.waypointIndex = 1
            data.isCalculatingPath = false
            data.stuckCounter = 0
            data.lastWaypointDistance = 0
            data.waypointDistanceChecks = 0
            data.lastPosition = Vector3.new(0, 0, 0)
            data.lastStuckCheck = 0
            clearNodes()
        end

        local function doPathfinding()
            if data.isCalculatingPath then return end
            data.isCalculatingPath = true

            local targetObj = getTarget()
            if not targetObj then 
                data.isCalculatingPath = false 
                return 
            end

            local targetPart = targetObj:IsA("Model") and targetObj.PrimaryPart or targetObj
            if not targetPart then 
                data.isCalculatingPath = false 
                return 
            end

            local targetPos = targetPart.Position
            local isLocker = targetObj:FindFirstChild("HidePrompt") ~= nil

            if isLocker then
                targetPos = targetPos + (targetPart.CFrame.LookVector * 3)
            else
                targetPos = targetPos + (-targetPart.CFrame.LookVector * 2)
            end

            local path = pathService:CreatePath({
                AgentCanJump = false,
                AgentCanClimb = false,
                WaypointSpacing = 2,
                AgentRadius = 1.5,
                AgentHeight = 5,
                Costs = {_autorooms_pathBlock = 20}
            })

            local ok = pcall(function() path:ComputeAsync(shared.RootPart.Position - Vector3.new(0, 2.5, 0), targetPos) end)

            if ok and path.Status == Enum.PathStatus.Success then
                local wps = path:GetWaypoints()
                data.currentWaypoints = wps
                data.waypointIndex = 1
                data.stuckCounter = 0
                data.lastWaypointDistance = 0
                data.waypointDistanceChecks = 0
                data.lastPosition = shared.RootPart.Position
                data.lastStuckCheck = tick()
                clearNodes()
                for _, wp in ipairs(wps) do
                    addNode(wp.Position)
                end
                notify("Caminho calculado com " .. #wps .. " nodes.", "PathOK", 3)
            else
                notify("Falha ao calcular o caminho.", "PathError", 4)
            end

            data.isCalculatingPath = false
        end

        local function checkStuck(currentWaypoint)
            local currentTime = tick()
            local currentDistance = (shared.RootPart.Position - currentWaypoint.Position).Magnitude

            if data.lastStuckCheck == 0 then
                data.lastStuckCheck = currentTime
                data.lastPosition = shared.RootPart.Position
                data.lastWaypointDistance = currentDistance
                return false
            end

            if currentTime - data.lastStuckCheck > 0.8 then
                local positionDistance = (shared.RootPart.Position - data.lastPosition).Magnitude

                if positionDistance < 1.8 then
                    data.stuckCounter = data.stuckCounter + 1
                    if math.abs(currentDistance - data.lastWaypointDistance) < 0.8 then
                        data.waypointDistanceChecks = data.waypointDistanceChecks + 1
                    else
                        data.waypointDistanceChecks = 0
                    end
                    if data.stuckCounter >= 2 or data.waypointDistanceChecks >= 3 then
                        createBlockedPoint(currentWaypoint)
                        clearPath()
                        task.spawn(doPathfinding)
                        return true
                    end
                else
                    data.stuckCounter = math.max(0, data.stuckCounter - 1)
                    data.waypointDistanceChecks = 0
                end

                data.lastPosition = shared.RootPart.Position
                data.lastStuckCheck = currentTime
                data.lastWaypointDistance = currentDistance
            end

            return false
        end

        local function executeWaypointMovement()
            local waypoints = data.currentWaypoints
            local currentIndex = data.waypointIndex

            if #waypoints == 0 or currentIndex > #waypoints then return false end

            local currentWaypoint = waypoints[currentIndex]
            if not currentWaypoint then return false end

            local distance = (shared.RootPart.Position - currentWaypoint.Position).Magnitude
            shared.Humanoid:MoveTo(currentWaypoint.Position)

            if checkStuck(currentWaypoint) then return false end

            if distance < 4 then
                data.waypointIndex = currentIndex + 1
                if data.waypointIndex > #waypoints then
                    clearPath()
                    local finalTarget = getTarget()
                    if finalTarget and finalTarget:FindFirstChild("HidePrompt") then
                        fireproximityprompt(finalTarget.HidePrompt)
                    end
                    return false
                end
            end

            return true
        end

        local connRender = RunService.RenderStepped:Connect(function()
            if not data.enable then return end
            if not shared.Character or not shared.RootPart or not shared.Humanoid then return end

            if shared.Character:GetAttribute("Hiding") then
                if getAction() ~= "locker" then
                    camLock:FireServer()
                end
                return
            end

            if shared.RootPart.Anchored then return end

            if #data.currentWaypoints == 0 then
                if not data.isCalculatingPath then
                    task.spawn(doPathfinding)
                end
            else
                task.spawn(executeWaypointMovement)
            end
        end)
        table.insert(data.conncs, connRender)

        ShowPathNodesToggle:OnChanged(function(v)
            data.shownodes = v
            if not v then 
                clearNodes() 
            else
                for _, wp in ipairs(data.currentWaypoints) do
                    addNode(wp.Position)
                end
            end
            for _, block in ipairs(data.blockFolder:GetChildren()) do
                block.Transparency = v and 0.9 or 1
            end
        end)

        NotifyToggle:OnChanged(function(v)
            data.debug = v
        end)

        PrioritizeRaritiesToggle:OnChanged(function(v)
            data.prioritizeRarities = v
        end)

        notify("Auto Rooms ativado", "Init", 3)

    else
        if data.conncs then
            for _, c in ipairs(data.conncs) do
                pcall(function() c:Disconnect() end)
            end
        end
        data.conncs = {}

        local char = shared.player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and char.PrimaryPart then
            hum:MoveTo(char.PrimaryPart.Position)
            hum.WalkToPart = nil
        end

        if data.nodes then
            for _, node in pairs(data.nodes) do
                if node and node.Parent then
                    pcall(function() node:Destroy() end)
                end
            end
        end
        data.nodes = {}

        if data.blockFolder then
            pcall(function() data.blockFolder:Destroy() end)
            data.blockFolder = nil
        end

        data.currentWaypoints = {}
        data.waypointIndex = 1
        data.isCalculatingPath = false
    end
end)

