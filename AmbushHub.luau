    Active = {},
    Connections = {},
    ProcessedObjects = setmetatable({}, {__mode = "k"}),
    PendingRoomChange = false
}

function ESPManager:IsValidObject(obj)
    return obj and obj.Parent and (obj:IsA("Model") or obj:IsA("Part"))
end

function ESPManager:AddESP(obj, text, color, espType)
    if not self:IsValidObject(obj) or self.ProcessedObjects[obj] then return end
    self.ProcessedObjects[obj] = true
    local success = pcall(function()
        ESPLibrary:AddESP({ Object = obj, Text = text, Color = color })
        self.Active[obj] = { Type = espType, Text = text, Color = color }
    end)
    if not success then
        self.ProcessedObjects[obj] = nil
    end
end

function ESPManager:RemoveESP(obj)
    if self.Active[obj] then
        pcall(function() ESPLibrary:RemoveESP(obj) end)
        self.Active[obj] = nil
    end
    if self.Connections[obj] then
        for _, connection in pairs(self.Connections[obj]) do
            if typeof(connection) == "RBXScriptConnection" then
                connection:Disconnect()
            end
        end
        self.Connections[obj] = nil
    end
    self.ProcessedObjects[obj] = nil
end

function ESPManager:UpdateESP(obj, newText, newColor)
    if not self.Active[obj] then return end
    if newText then
        pcall(function()
            ESPLibrary:UpdateObjectText(obj, newText)
            self.Active[obj].Text = newText
        end)
    end
    if newColor then
        pcall(function()
            ESPLibrary:UpdateObjectColor(obj, newColor)
            self.Active[obj].Color = newColor
        end)
    end
end

function ESPManager:ClearByType(espType)
    local toRemove = {}
    for obj, data in pairs(self.Active) do
        if data.Type == espType then
            table.insert(toRemove, obj)
        end
    end
    for _, obj in pairs(toRemove) do
        self:RemoveESP(obj)
    end
end

function ESPManager:UpdateAllByType(espType)
    for obj, data in pairs(self.Active) do
        if data.Type == espType then
            self:UpdateESP(obj, data.Text, data.Color)
        end
    end
end

function ESPManager:ClearAll()
    for obj in pairs(self.Active) do
        self:RemoveESP(obj)
    end
end
--[[ CUBBY ESP ]]--
function shared.globals.CubbyESPManager:AddCubbyESP(cubby)
    if not self.ValidCubbies[cubby.Name] then return end
    if self.Tracked[cubby] then return end

    local color = getgenv().msdoors.espsettings.cubbycolor or Color3.fromRGB(255, 105, 180)
    ESPManager:AddESP(cubby, cubby.Name, color, "cubby")

    self.Tracked[cubby] = {
        connections = {
            cubby.DescendantAdded:Connect(function(obj)
                if obj.Name == "LootHolder" or obj.Name == "LootableCubby" then
                    task.defer(function() self:UpdateCubby(cubby) end)
                end
            end),
            cubby.DescendantRemoving:Connect(function(obj)
                if obj.Name == "LootHolder" or obj.Name == "LootableCubby" then
                    task.defer(function() self:UpdateCubby(cubby) end)
                end
            end)
        }
    }
    self:UpdateCubby(cubby)
end

function shared.globals.CubbyESPManager:UpdateCubby(cubby)
    local data = self.Tracked[cubby]
    if not data or not cubby.Parent then return end

    local lootables = {}
    for _, child in ipairs(cubby:GetChildren()) do
        if child.Name == "LootableCubby" then
            table.insert(lootables, child)
        end
    end

    if #lootables == 0 then return end

    local withLoot = 0
    for _, lootable in ipairs(lootables) do
        if lootable:FindFirstChild("LootHolder", true) then
            withLoot += 1
        end
    end

    if withLoot > 0 then
        self:RemoveCubbyESP(cubby)
    end
end

function shared.globals.CubbyESPManager:RemoveCubbyESP(cubby)
    local data = self.Tracked[cubby]
    if not data then return end

    for _, conn in ipairs(data.connections) do
        pcall(function() conn:Disconnect() end)
    end
    
    ESPManager:RemoveESP(cubby)
    self.Tracked[cubby] = nil
end

function shared.globals.CubbyESPManager:ScanExisting()
    if not self.IsActive then return end
    
    for cubby in pairs(self.Tracked) do
        self:RemoveCubbyESP(cubby)
    end
    
    for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
        local assets = room:FindFirstChild("Assets")
        if assets then
            for _, obj in ipairs(assets:GetChildren()) do
                self:AddCubbyESP(obj)
            end
        end
    end
end

function shared.globals.CubbyESPManager:Toggle(state)
    self.IsActive = state
    getgenv().msdoors.espsettings.cubbyesp = state
    if state then
        self:ScanExisting()
    else
        for cubby in pairs(self.Tracked) do
            self:RemoveCubbyESP(cubby)
        end
    end
end

