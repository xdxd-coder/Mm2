--[[ ANTILAG SILLY ]]--
local AntilagToggle = GroupAmbient:AddToggle("AntiLag", {
    Text = api:getTranslate("toggle_visual_antilag", "Anti-lag"),
    Default = getgenv().msdoors.antilag.Enabled,
    Callback = function(Value)
        getgenv().msdoors.antilag.Enabled = Value
    end
})

AntilagToggle:OnChanged(function(Value)
    getgenv().msdoors.antilag.Enabled = Value
    
    local function isInElevatorBreaker(obj)
        local current = obj
        while current do
            if current.Name == "ElevatorBreaker" then
                return true
            end
            current = current.Parent
        end
        return false
    end

    local function isInPaintings(obj)
        local current = obj
        while current do
            if current.Name == "Paintings" then
                return true
            end
            current = current.Parent
        end
        return false
    end

    local function applyGlowEffect(obj)
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.ForceField
            obj.BrickColor = BrickColor.new("Bright green")
            obj.Transparency = 0.3
            
            local pointLight = Instance.new("PointLight")
            pointLight.Brightness = 2
            pointLight.Color = Color3.fromRGB(0, 255, 0)
            pointLight.Range = 10
            pointLight.Parent = obj
        end
    end
    
    if Value then
        if not getgenv().msdoors.antilag.OriginalLighting then
            getgenv().msdoors.antilag.OriginalLighting = {
                Lighting.FogEnd,
                Lighting.FogStart,
                Lighting.Brightness,
                Lighting.GlobalShadows,
                Lighting.EnvironmentDiffuseScale,
                Lighting.EnvironmentSpecularScale
            }
        end

        local materialService = game:GetService("MaterialService")
        local backup = Instance.new("Folder")
        backup.Name = "MaterialServiceBackup"
        backup.Parent = game:GetService("ReplicatedStorage")

        for _, desc in ipairs(materialService:GetChildren()) do
            desc:Clone().Parent = backup
            desc:Destroy()
        end

        getgenv().msdoors.antilag.MaterialBackup = backup

        getgenv().msdoors.antilag.Connections.materialConn = materialService.DescendantAdded:Connect(function(desc)
            if getgenv().msdoors.antilag.Enabled then
                desc:Destroy()
            end
        end)
        
        Lighting.FogEnd = 1e10
        Lighting.FogStart = 1e10
        Lighting.Brightness = 2
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        
        local function processObject(obj)
            if isInElevatorBreaker(obj) then
                return
            end
            
            if obj.Parent and obj.Parent.Name == "Slots" then
                return
            end
            
            if LightNames[obj.Name] then
                return
            end
            
            if isInPaintings(obj) then
                if obj.Name == "Square" or obj.Name == "Oval" or obj.Name == "Wide" or obj.Name == "Tall" then
                    applyGlowEffect(obj)
                    return
                end
                return
            end
            
            if obj:IsA("BasePart") then
                getgenv().msdoors.antilag.StoredProperties[obj] = obj.Material
                obj.Material = Enum.Material.Plastic
            elseif obj:IsA("Decal") then
                getgenv().msdoors.antilag.StoredProperties[obj] = obj.Transparency
                obj.Transparency = 1
            end
        end
        
        local function processRoom(roomNum)
            local room = Workspace.CurrentRooms:FindFirstChild(tostring(roomNum))
            
            if not room then
                local childAddedConnection
                childAddedConnection = Workspace.CurrentRooms.ChildAdded:Connect(function(newRoom)
                    if newRoom.Name == tostring(roomNum) then
                        childAddedConnection:Disconnect()
                        processRoom(roomNum)
                    end
                end)
                return
            end
            
            if getgenv().msdoors.antilag.ProcessedRooms[roomNum] then 
                return 
            end
            
            getgenv().msdoors.antilag.ProcessedRooms[roomNum] = true
            
            local slotsFolder = room:FindFirstChild("Assets") and room.Assets:FindFirstChild("Paintings") and room.Assets.Paintings:FindFirstChild("Slots")
            if slotsFolder then
                for _, slot in pairs(slotsFolder:GetChildren()) do
                    for _, paintingName in ipairs({"Wide", "Square", "Oval", "Tall"}) do
                        local painting = slot:FindFirstChild(paintingName)
                        if painting and painting:IsA("BasePart") then
                            applyGlowEffect(painting)
                        end
                    end
                end
            end
            
            for _, obj in pairs(room:GetDescendants()) do
                processObject(obj)
            end
            
            getgenv().msdoors.antilag.Connections[roomNum] = room.DescendantAdded:Connect(function(obj)
                if getgenv().msdoors.antilag.Enabled then
                    processObject(obj)
                end
            end)
        end
        
        for _, room in pairs(Workspace.CurrentRooms:GetChildren()) do
            if room:IsA("Model") and tonumber(room.Name) then
                processRoom(tonumber(room.Name))
            end
        end
        
        getgenv().msdoors.antilag.Connections.newRooms = Workspace.CurrentRooms.ChildAdded:Connect(function(room)
            if room:IsA("Model") and tonumber(room.Name) then
                processRoom(tonumber(room.Name))
            end
        end)
        
        getgenv().msdoors.antilag.Connections.roomUpdate = player:GetAttributeChangedSignal("CurrentRoom"):Connect(function()
            for _, room in pairs(Workspace.CurrentRooms:GetChildren()) do
                if room:IsA("Model") and tonumber(room.Name) then
                    processRoom(tonumber(room.Name))
                end
            end
        end)
        
        task.spawn(function()
            local allDescendants = Workspace.CurrentRooms:GetDescendants()
            local batchSize = 20
            for i = 1, #allDescendants, batchSize do
                for j = i, math.min(i + batchSize - 1, #allDescendants) do
                    local obj = allDescendants[j]
                    if LightNames[obj.Name] and obj:IsA("BasePart") and not isInElevatorBreaker(obj) then
                        obj:Destroy()
                    end
                end
                task.wait()
            end
        end)
        
        getgenv().msdoors.antilag.Connections.destroyConn = Workspace.CurrentRooms.DescendantAdded:Connect(function(obj)
            if LightNames[obj.Name] and not isInElevatorBreaker(obj) then
                obj:Destroy()
            end
        end)
        
    else
        if getgenv().msdoors.antilag.Connections.destroyConn then
            getgenv().msdoors.antilag.Connections.destroyConn:Disconnect()
            getgenv().msdoors.antilag.Connections.destroyConn = nil
        end

        if getgenv().msdoors.antilag.Connections.materialConn then
            getgenv().msdoors.antilag.Connections.materialConn:Disconnect()
            getgenv().msdoors.antilag.Connections.materialConn = nil
        end

        if getgenv().msdoors.antilag.MaterialBackup then
            local materialService = game:GetService("MaterialService")
            for _, child in ipairs(getgenv().msdoors.antilag.MaterialBackup:GetChildren()) do
                child.Parent = materialService
            end
            getgenv().msdoors.antilag.MaterialBackup:Destroy()
            getgenv().msdoors.antilag.MaterialBackup = nil
        end
        
        if getgenv().msdoors.antilag.OriginalLighting then
            Lighting.FogEnd = getgenv().msdoors.antilag.OriginalLighting[1]
            Lighting.FogStart = getgenv().msdoors.antilag.OriginalLighting[2]
            Lighting.Brightness = getgenv().msdoors.antilag.OriginalLighting[3]
            Lighting.GlobalShadows = getgenv().msdoors.antilag.OriginalLighting[4]
