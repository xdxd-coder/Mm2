                    if getgenv().msdoors.noclip then collision.CanCollide = false end
                end))
                local collisionCrouch = collision:FindFirstChild("CollisionCrouch")
                if collisionCrouch then
                    table.insert(shared.connections.noclip, collisionCrouch:GetPropertyChangedSignal("CanCollide"):Connect(function()
                        if getgenv().msdoors.noclip then collisionCrouch.CanCollide = false end
                    end))
                end
            end

