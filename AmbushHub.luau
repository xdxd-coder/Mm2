GroupAntiEntity:AddToggle("AutoConsequences", {
    Text = api:getTranslate("Auto Consequences", "Auto-Consequences"),
    Default = getgenv().msdoors.autoconsequences,
    Visible = IsDoorsHardcore,
    Callback = function(value)
        getgenv().msdoors.autoconsequences = value

        if not value then
            if shared.connections.autoConsequencesHint then
                shared.connections.autoConsequencesHint:Disconnect()
                shared.connections.autoConsequencesHint = nil
            end
            if shared.connections.autoConsequencesRule then
                shared.connections.autoConsequencesRule:Disconnect()
                shared.connections.autoConsequencesRule = nil
            end
            getgenv().msdoors.activeConsequenceRule = nil
            local Character = shared.player.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
            if Humanoid then Humanoid.WalkSpeed = 16 end
            return
        end

        local RF = ReplicatedStorage:FindFirstChild("RemotesFolder")
        if not RF then return end

        local UnforseenHint = RF:FindFirstChild("UnforseenHint")
        if not UnforseenHint then return end

        local function stopRuleConnection()
            if shared.connections.autoConsequencesRule then
                shared.connections.autoConsequencesRule:Disconnect()
                shared.connections.autoConsequencesRule = nil
            end
            getgenv().msdoors.activeConsequenceRule = nil
            local Character = shared.player.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
            if Humanoid then Humanoid.WalkSpeed = 16 end
        end

        local function startRuleConnection(rule)
            if shared.connections.autoConsequencesRule then
                shared.connections.autoConsequencesRule:Disconnect()
                shared.connections.autoConsequencesRule = nil
            end

            shared.connections.autoConsequencesRule = RunService.Heartbeat:Connect(function()
                if not getgenv().msdoors.autoconsequences then return end

                local Character = shared.player.Character
                if not Character then return end
                local Humanoid = Character:FindFirstChildOfClass("Humanoid")
                local HRP = Character:FindFirstChild("HumanoidRootPart")
                if not Humanoid or not HRP then return end

                if rule == "NoSprint" then
                    local vel = HRP.AssemblyLinearVelocity
                    if math.sqrt(vel.X * vel.X + vel.Z * vel.Z) > 22 then
                        Humanoid.WalkSpeed = 12
                        task.delay(0.2, function()
                            if getgenv().msdoors.activeConsequenceRule == "NoSprint" then
                                Humanoid.WalkSpeed = 16
                            end
                        end)
                    end
                elseif rule == "NoHide" then
                    if Character:GetAttribute("Hiding") == true then
                        Character:SetAttribute("Hiding", false)
                    end
                elseif rule == "NoItems" then
                    for _, child in ipairs(Character:GetChildren()) do
                        if child:IsA("Tool") then
                            child.Parent = shared.player.Backpack
                        end
                    end
                elseif rule == "Hurry" then
                    if Humanoid.WalkSpeed < 22 then
                        Humanoid.WalkSpeed = 24
                    end
                end
            end)
        end

        local function advanceRooms()
            local LocalPlayer = shared.player
            local currentRoom = LocalPlayer:GetAttribute("CurrentRoom") or 0

            for i = 0, 4 do
                local roomNum = currentRoom + i
                local roomFolder = workspace.CurrentRooms:FindFirstChild(tostring(roomNum))
                if not roomFolder then continue end

                local doorModel = roomFolder:FindFirstChild("Door")
                local doorPart = doorModel and doorModel:FindFirstChild("Door")
                if not doorPart then continue end

                if doorPart:GetAttribute("Opened") == false then
                    local keyObtain = roomFolder:FindFirstChild("KeyObtain", true)
                    if keyObtain then
                        while getgenv().msdoors.autoconsequences and getgenv().msdoors.activeConsequenceRule == "Hurry" do
                            local Character = LocalPlayer.Character
                            local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
                            if not HRP then break end
                            if Character:FindFirstChild("Key") then break end
                            HRP.CFrame = CFrame.new(keyObtain.Position + Vector3.new(0, 3, 0))
                            task.wait(0.1)
                        end
                    end

                    while getgenv().msdoors.autoconsequences and getgenv().msdoors.activeConsequenceRule == "Hurry" do
                        local Character = LocalPlayer.Character
                        local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
                        if not HRP then break end
                        if doorPart:GetAttribute("Opened") == true then break end
                        HRP.CFrame = CFrame.new(doorPart.Position + Vector3.new(0, 3, 0))
                        local prompt = doorPart:FindFirstChildWhichIsA("ProximityPrompt", true)
                            or doorModel:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then
                            fireproximityprompt(prompt)
                        end
                        task.wait(0.1)
                    end
                else
                    local Character = LocalPlayer.Character
                    local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
                    if HRP then
                        HRP.CFrame = CFrame.new(doorPart.Position + Vector3.new(0, 3, 0))
                    end
                    task.wait(0.3)
                end
            end
        end

        shared.connections.autoConsequencesHint = UnforseenHint.OnClientEvent:Connect(function(message)
            if not getgenv().msdoors.autoconsequences then return end

            local msg = tostring(message):lower()

            if msg:find("hide") then
                getgenv().msdoors.activeConsequenceRule = "NoHide"
                startRuleConnection("NoHide")
            elseif msg:find("sprint") then
                getgenv().msdoors.activeConsequenceRule = "NoSprint"
                startRuleConnection("NoSprint")
            elseif msg:find("items") then
                getgenv().msdoors.activeConsequenceRule = "NoItems"
                local Character = shared.player.Character
                if Character then
                    for _, child in ipairs(Character:GetChildren()) do
                        if child:IsA("Tool") then
                            child.Parent = shared.player.Backpack
                        end
                    end
                end
                startRuleConnection("NoItems")
            elseif msg:find("hurry") then
                getgenv().msdoors.activeConsequenceRule = "Hurry"
                local Character = shared.player.Character
                local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
                if Humanoid then Humanoid.WalkSpeed = 24 end
                startRuleConnection("Hurry")
                task.spawn(advanceRooms)
            elseif msg:find("no%-longer") or msg:find("no.longer") then
                stopRuleConnection()
            end
        end)
    end
})

