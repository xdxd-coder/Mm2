local function GetSeekPathfindingGoal()
    local currentRoom = shared.player:GetAttribute("CurrentRoom") or 1
    local nextRoomModel = workspace.CurrentRooms:FindFirstChild(tostring(currentRoom + 1))
    if nextRoomModel then
        local exit = nextRoomModel:FindFirstChild("RoomExit")
        if exit then return exit end
        local door = nextRoomModel:FindFirstChild("Door")
        if door then
            local inner = door:FindFirstChild("Door")
            if inner then return inner end
            return door
        end
    end
    local curRoomModel = workspace.CurrentRooms:FindFirstChild(tostring(currentRoom))
    if curRoomModel then
        local exit = curRoomModel:FindFirstChild("RoomExit")
        if exit then return exit end
        local door = curRoomModel:FindFirstChild("Door")
        if door then
            local inner = door:FindFirstChild("Door")
            if inner then return inner end
            return door
        end
    end
    return nil
end

local function clearBeams()
    if getgenv().msdoors._seek_beams then
        for _, b in pairs(getgenv().msdoors._seek_beams) do
            pcall(function()
                if b.beam then b.beam:Destroy() end
                if b.p0 then b.p0:Destroy() end
                if b.p1 then b.p1:Destroy() end
            end)
        end
    end
    getgenv().msdoors._seek_beams = {}
end

local function addBeam(posA, posB)
    if not ShowSeekNodesToggle.Value then return end
    local p0 = Instance.new("Part")
    p0.Anchored = true; p0.CanCollide = false; p0.Transparency = 1
    p0.Size = Vector3.new(0.1, 0.1, 0.1)
    p0.Position = posA + Vector3.new(0, 1.5, 0)
    p0.Parent = workspace
    local p1 = Instance.new("Part")
    p1.Anchored = true; p1.CanCollide = false; p1.Transparency = 1
    p1.Size = Vector3.new(0.1, 0.1, 0.1)
    p1.Position = posB + Vector3.new(0, 1.5, 0)
    p1.Parent = workspace
    local att0 = Instance.new("Attachment", p0)
    local att1 = Instance.new("Attachment", p1)
    local beam = Instance.new("Beam")
    beam.Attachment0 = att0; beam.Attachment1 = att1
    beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 0))
    beam.Width0 = 1.2; beam.Width1 = 1.2; beam.FaceCamera = true
    beam.Transparency = NumberSequence.new(0)
    beam.LightEmission = 0.8; beam.Brightness = 15
    beam.Parent = p0
    table.insert(getgenv().msdoors._seek_beams, {beam = beam, p0 = p0, p1 = p1})
end

local function rebuildBeams()
    clearBeams()
    local wps = getgenv().msdoors.seekhelper_data.currentWaypoints
    for i = 1, #wps - 1 do
        addBeam(wps[i].Position, wps[i+1].Position)
    end
end

local function cleanupNodes()
    clearBeams()
    if getgenv().msdoors._internal_seek_block then
        getgenv().msdoors._internal_seek_block:ClearAllChildren()
    end
    local d = getgenv().msdoors.seekhelper_data
    d.currentWaypoints = {}
    d.currentWaypointIndex = 1
    d.isCalculatingPath = false
    d.stuckCounter = 0
    d.lastWaypointDistance = 0
    d.waypointDistanceChecks = 0
    d.lastPosition = Vector3.new(0, 0, 0)
    d.lastStuckCheck = 0
    d.pathCreated = false
    d.totalWaypoints = 0
    d.currentGoal = nil
    d.lastPathRequestTime = 0
end

local function moveToCleanup()
    if shared.Humanoid then
        shared.Humanoid:MoveTo(shared.RootPart.Position)
        shared.Humanoid.WalkToPart = nil
        shared.Humanoid.WalkToPoint = shared.RootPart.Position
    end
    cleanupNodes()
end

local function createBlockedPoint(point)
    local block = Instance.new("Part", getgenv().msdoors._internal_seek_block)
    local pathMod = Instance.new("PathfindingModifier", block)
    pathMod.Label = "_seek_pathBlock"
    block.Name = "_seekhelper_blocked_path"
    block.Shape = Enum.PartType.Block
    block.Size = Vector3.new(2, 15, 2)
    block.Color = Color3.fromRGB(255, 100, 0)
    block.Material = Enum.Material.Neon
    block.Position = point.Position + Vector3.new(0, 7.5, 0)
    block.Anchored = true; block.CanCollide = false
    block.Transparency = ShowSeekNodesToggle.Value and 0.9 or 1
end

local function computeSeekPath(startPos, endPos)
    for attempt = 1, 5 do
        local path = PathfindingService:CreatePath({
            AgentCanJump = false, AgentCanClimb = false,
            WaypointSpacing = 2, AgentRadius = 1, AgentHeight = 5,
            Costs = {_seek_pathBlock = 20}
        })
        local ok = pcall(function() path:ComputeAsync(startPos, endPos) end)
        if ok and path.Status == Enum.PathStatus.Success then
            local wps = path:GetWaypoints()
            if wps and #wps > 0 then return wps end
        end
        task.wait(0.2)
    end
    return nil
end

local function doSeekPathfinding()
    local d = getgenv().msdoors.seekhelper_data
    if d.isCalculatingPath or not d.isActive then return false end
    d.isCalculatingPath = true

    local goal = GetSeekPathfindingGoal()
    if not goal then d.isCalculatingPath = false; return false end

    local wps = computeSeekPath(shared.RootPart.Position - Vector3.new(0, 2.5, 0), goal.Position)
    if wps and #wps > 0 then
        d.currentWaypoints = wps
        d.totalWaypoints = #wps
        d.pathCreated = true
        d.currentWaypointIndex = 1
        d.stuckCounter = 0
        d.lastWaypointDistance = 0
        d.waypointDistanceChecks = 0
        d.lastPosition = shared.RootPart.Position
        d.lastStuckCheck = tick()
        rebuildBeams()
        d.isCalculatingPath = false
        return true
    end

    d.isCalculatingPath = false
    task.spawn(function()
        task.wait(0.2)
        if d.isActive and #d.currentWaypoints == 0 then
            doSeekPathfinding()
        end
    end)
    return false
end

local function extendPathToNextRoom()
    local d = getgenv().msdoors.seekhelper_data
    if not d.isActive then return false end

    local goal = GetSeekPathfindingGoal()
    if not goal then return false end

    local lastWp = d.currentWaypoints[#d.currentWaypoints]
    if not lastWp then return doSeekPathfinding() end

    local lastWpPos = lastWp.Position
    local wps = computeSeekPath(lastWpPos, goal.Position)
    if wps and d.isActive and #d.currentWaypoints > 0 then
        local prevCount = #d.currentWaypoints
        for i = 2, #wps do
            table.insert(d.currentWaypoints, wps[i])
        end
        d.totalWaypoints = #d.currentWaypoints
        for i = prevCount, #d.currentWaypoints - 1 do
            local a = d.currentWaypoints[i]
            local b = d.currentWaypoints[i + 1]
            if a and b then
                addBeam(a.Position, b.Position)
            end
        end
        return true
    end

    return false
end

local function checkStuck(currentWaypoint)
    local d = getgenv().msdoors.seekhelper_data
    local currentTime = tick()
    local currentDistance = (shared.RootPart.Position - currentWaypoint.Position).Magnitude

    if d.lastStuckCheck == 0 then
        d.lastStuckCheck = currentTime
        d.lastPosition = shared.RootPart.Position
        d.lastWaypointDistance = currentDistance
        return false
    end

    if currentTime - d.lastStuckCheck > 0.8 then
        local positionDistance = (shared.RootPart.Position - d.lastPosition).Magnitude

        if currentDistance > 8 and d.waypointDistanceChecks > 2 then
            d.currentWaypoints = {}; d.currentWaypointIndex = 1
            d.stuckCounter = 0; d.waypointDistanceChecks = 0; d.pathCreated = false
            clearBeams(); d.totalWaypoints = 0
            task.spawn(doSeekPathfinding)
            return true
        end

        if positionDistance < 1.8 then
            d.stuckCounter = d.stuckCounter + 1
            if math.abs(currentDistance - d.lastWaypointDistance) < 0.8 then
                d.waypointDistanceChecks = d.waypointDistanceChecks + 1
            else
                d.waypointDistanceChecks = 0
            end
            if d.stuckCounter >= 2 or d.waypointDistanceChecks >= 3 then
                createBlockedPoint(currentWaypoint)
                d.currentWaypoints = {}; d.currentWaypointIndex = 1
                d.stuckCounter = 0; d.waypointDistanceChecks = 0; d.pathCreated = false
                clearBeams(); d.totalWaypoints = 0
                task.spawn(doSeekPathfinding)
                return true
            end
        else
            d.stuckCounter = math.max(0, d.stuckCounter - 1)
            d.waypointDistanceChecks = 0
        end

        d.lastPosition = shared.RootPart.Position
        d.lastStuckCheck = currentTime
        d.lastWaypointDistance = currentDistance
    end

    return false
end

local function executeWaypointMovement()
    local d = getgenv().msdoors.seekhelper_data
    local waypoints = d.currentWaypoints
    local currentIndex = d.currentWaypointIndex

    if #waypoints == 0 or currentIndex > #waypoints then return false end

    local currentWaypoint = waypoints[currentIndex]
    if not currentWaypoint then return false end

    local distance = (shared.RootPart.Position - currentWaypoint.Position).Magnitude
    shared.Humanoid:MoveTo(currentWaypoint.Position)

    if checkStuck(currentWaypoint) then return false end

    if distance < 4 then
        d.currentWaypointIndex = currentIndex + 1
        if d.currentWaypointIndex > #waypoints then
            d.currentWaypoints = {}; d.currentWaypointIndex = 1
            d.pathCreated = false; d.totalWaypoints = 0
            return false
        end
    end

    return true
end

local function handleObstruction(descendant, roomNumber)
    if descendant.Name == "LiveObstructionNew" or descendant.Name == "LiveObstructionNewIntro" then
        spawn(function()
            local collision = descendant:WaitForChild("Collision", 5)
            if collision then collision.CanCollide = false end
        end)
    end
end

local function scanRoomForObstructions(room)
    local roomNumber = tonumber(room.Name)
    if not roomNumber then return end
    for _, descendant in pairs(room:GetDescendants()) do
        handleObstruction(descendant, roomNumber)
    end
    room.DescendantAdded:Connect(function(descendant)
        handleObstruction(descendant, roomNumber)
    end)
end

local function processNewRoom(room)
    local roomNumber = tonumber(room.Name)
    if not roomNumber then return end
    if getgenv().msdoors.seekhelper_data.processedRooms[roomNumber] then return end
    getgenv().msdoors.seekhelper_data.processedRooms[roomNumber] = true

    local rawName = room:GetAttribute("RawName")

    if rawName == "Hotel_SeekChaseFinal" then
        getgenv().msdoors.seekhelper_data.seekEndRoom = roomNumber
        local nextRoomNum = roomNumber + 1
        getgenv().msdoors.seekhelper_data.seekFinalRoom = nextRoomNum
    end

    if getgenv().msdoors.seekhelper_data.isActive or (rawName and string.find(rawName, "Seek")) then
        setRoomQueryable(room, false)
    end

    scanRoomForObstructions(room)

    if getgenv().msdoors.seekhelper_data.isActive and roomNumber > getgenv().msdoors.seekhelper_data.seekStartRoom then
        task.spawn(function()
            task.wait(0.1)
            if getgenv().msdoors.seekhelper_data.isActive then
                extendPathToNextRoom()
            end
        end)
    end
end

SeekHelperToggle:OnChanged(function(value)
    InitializeSeekHelperData()
    getgenv().msdoors.seekhelper = value

    if value then
        shared.player.CharacterAdded:Connect(function()
            shared.Character = shared.player.Character
            shared.RootPart = shared.Character:WaitForChild("HumanoidRootPart")
            shared.Humanoid = shared.Character:WaitForChild("Humanoid")
        end)

        if shared.Character then
            shared.RootPart = shared.Character:FindFirstChild("HumanoidRootPart")
            shared.Humanoid = shared.Character:FindFirstChild("Humanoid")
        end

        getgenv().msdoors._seek_beams = {}

        getgenv().msdoors._internal_seek_block = Instance.new("Folder", workspace)
        getgenv().msdoors._internal_seek_block.Name = "_internal_seekhelper_pathfinding_block"

        local d = getgenv().msdoors.seekhelper_data
        d.currentWaypoints = {}; d.currentWaypointIndex = 1
        d.isCalculatingPath = false; d.isActive = false
        d.lastRoomValue = 0; d.pathCreated = false
        d.totalWaypoints = 0; d.seekStartRoom = 0
        d.seekEndRoom = 0; d.seekFinalRoom = 0
        d.processedRooms = {}

        for _, room in pairs(workspace.CurrentRooms:GetChildren()) do
            if room:IsA("Model") and tonumber(room.Name) then
                scanRoomForObstructions(room)
                processNewRoom(room)
            end
        end

        getgenv().msdoors.seekRoomAddedConnection = workspace.CurrentRooms.ChildAdded:Connect(function(newRoom)
            if newRoom:IsA("Model") and tonumber(newRoom.Name) then
                processNewRoom(newRoom)
            end
        end)

        local GC = getconnections or get_signal_cons
        if GC then
            for i,v in pairs(GC(shared.player.Idled)) do
                if v["Disable"] then v["Disable"](v) elseif v["Disconnect"] then v["Disconnect"](v) end
            end
        end

        getgenv().msdoors.seekRenderConnection = RunService.RenderStepped:Connect(function()
            if not getgenv().msdoors.seekhelper then return end
            if not shared.Character or not shared.RootPart or not shared.Humanoid then return end

            local d = getgenv().msdoors.seekhelper_data
            local currentRoom = shared.player:GetAttribute("CurrentRoom") or 1
            local room = workspace.CurrentRooms:FindFirstChild(tostring(currentRoom))

            if currentRoom ~= d.lastRoomValue then
                d.lastRoomValue = currentRoom
                if getgenv().msdoors._internal_seek_block then
                    getgenv().msdoors._internal_seek_block:ClearAllChildren()
                end
                if room and d.isActive then
                    setRoomQueryable(room, false)
                    scanRoomForObstructions(room)
                end
            end

            if room and room:GetAttribute("RawName") == "Hotel_SeekIntro" and not d.isActive then
                if workspace:FindFirstChild("SeekMovingNewClone") then
                    d.isActive = true
                    d.seekStartRoom = currentRoom
                    d.seekEndRoom = 0
                    d.seekFinalRoom = 0
                    d.processedRooms = {}
                    cleanupNodes()

                    for _, seekRoom in pairs(workspace.CurrentRooms:GetChildren()) do
                        if seekRoom:IsA("Model") and tonumber(seekRoom.Name) then
                            local seekRoomNumber = tonumber(seekRoom.Name)
                            if seekRoomNumber >= currentRoom then
                                setRoomQueryable(seekRoom, false)
                            end
                            if seekRoom:GetAttribute("RawName") == "Hotel_SeekChaseFinal" then
                                d.seekEndRoom = seekRoomNumber
                                d.seekFinalRoom = seekRoomNumber + 1
                            end
                        end
                    end

                    Notify({
                        Title = "Seek Helper",
                        Description = "Iniciando Seek Helper...",
                        Image = "rbxassetid://6023426923",
                        Color = Color3.fromRGB(255, 100, 0),
                        Style = "EVENT",
                        Duration = 3,
                        NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                    })

                    task.spawn(doSeekPathfinding)
                end
            end

            if d.isActive then
                local finalRoom = d.seekFinalRoom
                if finalRoom > 0 and currentRoom >= finalRoom then
                    d.isActive = false
                    d.seekStartRoom = 0
                    d.seekEndRoom = 0
                    d.seekFinalRoom = 0
                    Notify({
                        Title = "Seek Helper",
                        Description = "Seek completado!",
                        Image = "rbxassetid://6023426923",
                        Color = Color3.fromRGB(0, 255, 0),
                        Style = "EVENT",
                        Duration = 4,
                        NotifyStyle = getgenv().msdoors.LibraryNotifyStyle
                    })
                    moveToCleanup()
                    return
                end

                if #d.currentWaypoints == 0 then
                    task.spawn(doSeekPathfinding)
                else
                    task.spawn(executeWaypointMovement)
                end
            end
        end)

    else
        if getgenv().msdoors.seekRenderConnection then getgenv().msdoors.seekRenderConnection:Disconnect() end
        if getgenv().msdoors.seekRoomAddedConnection then getgenv().msdoors.seekRoomAddedConnection:Disconnect() end

        clearBeams()
        if getgenv().msdoors._internal_seek_block then
            getgenv().msdoors._internal_seek_block:Destroy()
            getgenv().msdoors._internal_seek_block = nil
        end

        moveToCleanup()
        getgenv().msdoors.seekhelper_data.isActive = false
    end
end)
		
