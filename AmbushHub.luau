            shared.connections.BringDrawersRender:Disconnect()
            shared.connections.BringDrawersRender = nil
        end
        if shared.connections.BringDrawersHeartbeat then
            shared.connections.BringDrawersHeartbeat:Disconnect()
            shared.connections.BringDrawersHeartbeat = nil
        end

        if type(shared.globals.ActiveDrawers) ~= "table" then
            shared.globals.ActiveDrawers = {}
        end

        if value then
            if gethiddenproperty and sethiddenproperty then
                settings().Physics.AllowSleep = false
                shared.player.ReplicationFocus = workspace

                shared.connections.BringDrawersHeartbeat = RunService.Heartbeat:Connect(function()
                    pcall(function()
                        sethiddenproperty(shared.player, "MaximumSimulationRadius", math.huge)
                        sethiddenproperty(shared.player, "SimulationRadius", math.huge)
                    end)
                end)
            end

            shared.connections.BringDrawersRender = RunService.RenderStepped:Connect(function()
                local char = shared.player.Character
                if not char then return end

                local currentRoomNum = shared.player:GetAttribute("CurrentRoom")

                for i = #shared.globals.ActiveDrawers, 1, -1 do
                    local data = shared.globals.ActiveDrawers[i]
                    local drawer = data.Object
                    local main = data.Main
                    local constraint = data.Constraint

                    if not drawer or not drawer.Parent or not main or not main.Parent then
                        if constraint and constraint.Parent then
                            constraint.Enabled = true
                        end
                        table.remove(shared.globals.ActiveDrawers, i)
                    else
                        local owner = true
                        if isnetworkowner then
                            owner = isnetworkowner(main)
                        end

                        local key = drawer:FindFirstChild("KeyObtain")

                        local canBring = true
                        if key then
                            local drawerRoom = drawer.Parent
                            while drawerRoom and drawerRoom.Parent ~= workspace.CurrentRooms do
                                drawerRoom = drawerRoom.Parent
                            end
                            local drawerRoomNum = nil
                            if drawerRoom then
                                drawerRoomNum = tonumber(drawerRoom.Name)
                            end
                            if drawerRoomNum == nil or currentRoomNum == nil or drawerRoomNum ~= currentRoomNum then
                                canBring = false
                            end
                        end

                        if owner and not main.Anchored and canBring then
                            constraint.Enabled = false
                            local pivot = char:GetPivot()
                            main.CFrame = pivot * CFrame.Angles(0, math.rad(180), 0) + pivot.LookVector * 3
                            main.AssemblyLinearVelocity = Vector3.zero
                            main.AssemblyAngularVelocity = Vector3.zero

                            if key and key:FindFirstChild("ModulePrompt", true) then
                                pcall(fireproximityprompt, key:FindFirstChild("ModulePrompt", true))
                            end

                            local stardust = drawer:FindFirstChild("Stardust", true)
                            if stardust and stardust:FindFirstChild("ModulePrompt", true) then
                                pcall(fireproximityprompt, stardust:FindFirstChild("ModulePrompt", true))
                            end

                            local actEvent = drawer:FindFirstChild("ActivateEventPrompt", true)
                            if actEvent then
                                pcall(fireproximityprompt, actEvent)
                            end
                        else
                            constraint.Enabled = true
                        end
                    end
                end
            end)

            for _, obj in ipairs(workspace.CurrentRooms:GetDescendants()) do
                if obj.Name == "DrawerContainer" then
                    local main = obj:FindFirstChild("Main")
                    local constraint = obj:FindFirstChild("Constraint")
                    if main and constraint then
                        table.insert(shared.globals.ActiveDrawers, {Object = obj, Main = main, Constraint = constraint})
                    end
                end
            end
        else
            for _, data in ipairs(shared.globals.ActiveDrawers) do
                if data.Constraint and data.Constraint.Parent then
                    data.Constraint.Enabled = true
                end
            end
            table.clear(shared.globals.ActiveDrawers)
        end
    end
})
