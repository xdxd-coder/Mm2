GodmodeToggle:OnChanged(function(enabled)
    getgenv().msdoors.GodmodeEnable = enabled   
	shared.oldgodmode = enabled
    getgenv().msdoors.GodmodeConnections = {}
    if enabled then
        local char = player.Character or player.CharacterAdded:Wait()

        local function onCharacterAdded(newChar)
            char = newChar
            getgenv().msdoors.Collision = nil
            getgenv().msdoors.CollisionPart = nil
            getgenv().msdoors.CollisionClone = nil
            char:WaitForChild("HumanoidRootPart", 3)
            getgenv().msdoors.Collision = char:FindFirstChild("Collision")
            getgenv().msdoors.CollisionPart = char:FindFirstChild("CollisionPart")
            getgenv().msdoors.CollisionClone = char:FindFirstChild("CollisionClone")
        end

        getgenv().msdoors.GodmodeConnections.CharacterAdded = player.CharacterAdded:Connect(onCharacterAdded)
        if char then onCharacterAdded(char) end

        getgenv().msdoors.Collision = char:FindFirstChild("Collision")
        getgenv().msdoors.CollisionPart = char:FindFirstChild("CollisionPart")
        getgenv().msdoors.CollisionClone = char:FindFirstChild("CollisionClone")
        
        if not ((getgenv().msdoors.Collision and getgenv().msdoors.Collision:IsA("BasePart")) or (getgenv().msdoors.CollisionPart and getgenv().msdoors.CollisionPart:IsA("BasePart"))) then
            return
        end

        if not getgenv().msdoors.OriginalCollisionPos[char] then
            getgenv().msdoors.OriginalCollisionPos[char] = {}
        end
        
        if getgenv().msdoors.Collision and getgenv().msdoors.Collision:IsA("BasePart") then
            if not getgenv().msdoors.OriginalCollisionPos[char].Collision then
                getgenv().msdoors.OriginalCollisionPos[char].Collision = getgenv().msdoors.Collision.Position
            end
            getgenv().msdoors.Collision.Position = getgenv().msdoors.Collision.Position - Vector3.new(0, getgenv().msdoors.GodmodeOffset, 0)
        end
        
        if getgenv().msdoors.CollisionPart and getgenv().msdoors.CollisionPart:IsA("BasePart") then
            if not getgenv().msdoors.OriginalCollisionPos[char].CollisionPart then
                getgenv().msdoors.OriginalCollisionPos[char].CollisionPart = getgenv().msdoors.CollisionPart.Position
            end
            getgenv().msdoors.CollisionPart.Position = getgenv().msdoors.CollisionPart.Position - Vector3.new(0, getgenv().msdoors.GodmodeOffset, 0)
        end
        
        if getgenv().msdoors.CollisionClone and getgenv().msdoors.CollisionClone:IsA("BasePart") then
            if not getgenv().msdoors.OriginalCollisionPos[char].CollisionClone then
                getgenv().msdoors.OriginalCollisionPos[char].CollisionClone = getgenv().msdoors.CollisionClone.Position
            end
            getgenv().msdoors.CollisionClone.Position = getgenv().msdoors.CollisionClone.Position - Vector3.new(0, getgenv().msdoors.GodmodeOffset, 0)
        end
        
        local humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart and humanoidRootPart:IsA("BasePart") then
            humanoidRootPart.CanCollide = true
        end
        
        getgenv().msdoors.InGodmode = true
        
        if not AntiFigureHearingToggle then
            AntiFigureHearingToggle:SetValue(true)
        end
                
    else
        local char = shared.Character
        if not char then return end
        
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid and getgenv().msdoors.OriginalCollisionPos[char] and getgenv().msdoors.OriginalCollisionPos[char].HipHeight then
            humanoid.HipHeight = getgenv().msdoors.OriginalCollisionPos[char].HipHeight
